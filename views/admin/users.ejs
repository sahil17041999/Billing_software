<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Staff &amp; Role Privilege Management - Grocery Billing ERP</title>
  <meta name="description" content="Manage staff accounts, roles, and granular module privileges for your billing software">
  <link rel="shortcut icon" type="image/png" href="/assets/images/logos/favicon.png" />
  <link rel="stylesheet" href="/assets/css/icons/tabler-icons/tabler-icons.css" />
  <link rel="stylesheet" href="/assets/css/admin-theme.css" />
  <style>
    /* Tab Switcher */
    .view-tabs-nav {
      display: flex;
      gap: 12px;
      margin-bottom: 24px;
      border-bottom: 1px solid var(--border-color);
      padding-bottom: 12px;
    }
    .view-tab-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 10px 18px;
      font-size: 14px;
      font-weight: 600;
      color: var(--text-muted);
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-md);
      cursor: pointer;
      transition: all 0.2s ease;
    }
    .view-tab-btn:hover {
      color: var(--text-main);
      border-color: var(--primary-light);
    }
    .view-tab-btn.active {
      color: #fff;
      background: var(--primary);
      border-color: var(--primary);
      box-shadow: 0 4px 12px rgba(79, 70, 229, 0.35);
    }

    /* Role Cards Grid */
    .roles-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
      gap: 20px;
      margin-top: 16px;
    }
    .role-card {
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-lg);
      padding: 22px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition: all 0.25s ease;
      box-shadow: var(--shadow-sm);
    }
    .role-card:hover {
      transform: translateY(-3px);
      box-shadow: var(--shadow-md);
      border-color: rgba(99, 102, 241, 0.4);
    }
    .role-card-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      margin-bottom: 14px;
    }
    .role-icon-box {
      width: 44px;
      height: 44px;
      border-radius: var(--radius-md);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 22px;
    }
    .role-icon-box.admin { background: rgba(99, 102, 241, 0.15); color: #6366f1; }
    .role-icon-box.manager { background: rgba(6, 182, 212, 0.15); color: #06b6d4; }
    .role-icon-box.cashier { background: rgba(16, 185, 129, 0.15); color: #10b981; }
    .role-icon-box.accountant { background: rgba(245, 158, 11, 0.15); color: #f59e0b; }
    .role-icon-box.warehouse { background: rgba(139, 92, 246, 0.15); color: #8b5cf6; }
    .role-icon-box.custom { background: rgba(236, 72, 153, 0.15); color: #ec4899; }

    .role-card-title {
      font-size: 17px;
      font-weight: 700;
      color: var(--text-main);
      margin-bottom: 4px;
      text-transform: capitalize;
    }
    .role-card-desc {
      font-size: 12.5px;
      color: var(--text-muted);
      line-height: 1.45;
      min-height: 38px;
    }
    .role-card-stats {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 12px 0;
      border-top: 1px solid var(--border-color);
      border-bottom: 1px solid var(--border-color);
      margin: 16px 0;
      font-size: 13px;
    }
    .role-card-actions {
      display: flex;
      gap: 10px;
    }

    /* Permissions Modal Matrix */
    .perm-modules-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 16px;
      max-height: 60vh;
      overflow-y: auto;
      padding: 6px;
    }
    .perm-module-card {
      background: var(--bg-card-hover, rgba(15, 23, 42, 0.03));
      border: 1px solid var(--border-color);
      border-radius: var(--radius-md);
      padding: 16px;
    }
    .perm-module-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-bottom: 10px;
      margin-bottom: 12px;
      border-bottom: 1px solid var(--border-color);
    }
    .perm-module-title {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 14px;
      font-weight: 700;
      color: var(--text-main);
    }
    .perm-item-row {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      padding: 8px 0;
      border-bottom: 1px dashed rgba(255, 255, 255, 0.06);
    }
    .perm-item-row:last-child {
      border-bottom: none;
    }
    .perm-item-checkbox {
      margin-top: 3px;
      width: 16px;
      height: 16px;
      cursor: pointer;
      accent-color: var(--primary);
    }
    .perm-item-text {
      flex: 1;
      cursor: pointer;
    }
    .perm-item-name {
      font-size: 13px;
      font-weight: 600;
      color: var(--text-main);
      display: block;
    }
    .perm-item-desc {
      font-size: 11.5px;
      color: var(--text-muted);
      display: block;
      margin-top: 1px;
    }

    /* Preset Buttons Bar */
    .preset-bar {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 8px;
      margin-bottom: 16px;
      padding: 12px;
      background: var(--bg-card-hover, rgba(15, 23, 42, 0.05));
      border: 1px solid var(--border-color);
      border-radius: var(--radius-md);
    }
    .preset-btn {
      padding: 5px 10px;
      font-size: 12px;
      font-weight: 600;
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      color: var(--text-main);
      border-radius: var(--radius-sm);
      cursor: pointer;
      transition: all 0.2s;
    }
    .preset-btn:hover {
      background: var(--primary);
      color: #fff;
      border-color: var(--primary);
    }
  </style>
</head>
<body>
  <div class="admin-layout">
    <%- include('../partials/sidebar.ejs', { currentPage: 'users' }) %>

    <div class="page-wrapper">
      <div class="body-wrapper">
        <%- include('../partials/header.ejs') %>

        <main class="page-content">
          <!-- Page Header -->
          <div class="page-title-box">
            <div class="page-title-left">
              <h1 class="page-main-heading">
                <i class="ti ti-users-group" style="color: var(--primary);"></i> Staff &amp; Role Privilege Management
              </h1>
              <p class="page-subheading">Manage team members, roles (Admin · Manager · Cashier), and configure granular module permissions</p>
            </div>
            <div class="page-title-actions">
              <button type="button" class="btn-modern btn-secondary-modern" onclick="openCreateRoleModal()">
                <i class="ti ti-shield-plus"></i> + Add Custom Role
              </button>
              <button type="button" class="btn-modern btn-primary-modern" id="addUserBtn" onclick="openCreateModal()">
                <i class="ti ti-user-plus"></i> Add New User
              </button>
            </div>
          </div>

          <!-- Alert Banner -->
          <div id="pageAlert" class="alert-banner" style="display:none;"></div>

          <!-- View Tabs Switcher -->
          <div class="view-tabs-nav">
            <button type="button" class="view-tab-btn active" id="tabBtnUsers" onclick="switchTab('users')">
              <i class="ti ti-users"></i> Staff Users (<span id="tabUsersCount"><%= users.length %></span>)
            </button>
            <button type="button" class="view-tab-btn" id="tabBtnRoles" onclick="switchTab('roles')">
              <i class="ti ti-shield-lock"></i> Role Privileges &amp; Permissions (<%= roles.length %>)
            </button>
          </div>

          <!-- ====================================================
               VIEW TAB 1: USERS LIST
               ==================================================== -->
          <div id="viewUsersTab">
            <!-- Stats Row -->
            <div class="users-stats-grid">
              <div class="stat-card-mini">
                <div class="stat-icon-circle blue"><i class="ti ti-users"></i></div>
                <div>
                  <div class="stat-num" id="statTotal"><%= users.length %></div>
                  <div class="stat-lbl">Total Users</div>
                </div>
              </div>
              <div class="stat-card-mini">
                <div class="stat-icon-circle green"><i class="ti ti-user-check"></i></div>
                <div>
                  <div class="stat-num" id="statActive"><%= users.filter(u => u.is_active).length %></div>
                  <div class="stat-lbl">Active</div>
                </div>
              </div>
              <div class="stat-card-mini">
                <div class="stat-icon-circle amber"><i class="ti ti-shield"></i></div>
                <div>
                  <div class="stat-num" id="statAdmins"><%= users.filter(u => u.role && u.role.name === 'admin').length %></div>
                  <div class="stat-lbl">Admins</div>
                </div>
              </div>
              <div class="stat-card-mini">
                <div class="stat-icon-circle red"><i class="ti ti-user-off"></i></div>
                <div>
                  <div class="stat-num" id="statInactive"><%= users.filter(u => !u.is_active).length %></div>
                  <div class="stat-lbl">Inactive</div>
                </div>
              </div>
            </div>

            <!-- Main Table Card -->
            <div class="card-modern">
              <div class="card-body-modern">

                <!-- Table Toolbar -->
                <div class="table-toolbar">
                  <div class="toolbar-search">
                    <i class="ti ti-search"></i>
                    <input type="text" id="userSearch" placeholder="Search by name, username or email...">
                  </div>
                  <select class="filter-select" id="roleFilter">
                    <option value="">All Roles</option>
                    <% roles.forEach(r => { %>
                      <option value="<%= r.name %>"><%= r.name.charAt(0).toUpperCase() + r.name.slice(1) %></option>
                    <% }) %>
                  </select>
                  <select class="filter-select" id="statusFilter">
                    <option value="">All Status</option>
                    <option value="1">Active</option>
                    <option value="0">Inactive</option>
                  </select>
                </div>

                <!-- Table -->
                <div class="table-responsive-wrapper">
                  <table class="table-modern" id="usersTable">
                    <thead>
                      <tr>
                        <th style="width:60px">ID</th>
                        <th>User Profile</th>
                        <th>Contact</th>
                        <th style="text-align:center">Role</th>
                        <th style="text-align:center">Status</th>
                        <th style="text-align:center">Last Login</th>
                        <th style="text-align:center;width:140px">Actions</th>
                      </tr>
                    </thead>
                    <tbody id="usersTableBody">
                      <% if (users.length === 0) { %>
                      <tr>
                        <td colspan="7" class="table-empty-state">
                          <i class="ti ti-users-off icon"></i>
                          <p>No user accounts found. Create the first user to get started.</p>
                        </td>
                      </tr>
                      <% } %>
                      <% users.forEach(function(u) { %>
                      <tr data-id="<%= u.id %>"
                          data-username="<%= (u.username||'').toLowerCase() %>"
                          data-name="<%= ((u.first_name||'') + ' ' + (u.last_name||'')).toLowerCase().trim() %>"
                          data-email="<%= (u.email||'').toLowerCase() %>"
                          data-role="<%= u.role ? u.role.name : '' %>"
                          data-active="<%= u.is_active ? '1' : '0' %>">
                        <td><span style="font-family:var(--font-mono);color:var(--text-light);font-weight:600;">#<%= u.id %></span></td>
                        <td>
                          <div style="display:flex;align-items:center;gap:12px;">
                            <div class="user-avatar">
                              <%= (u.first_name || u.username || 'U').charAt(0).toUpperCase() %>
                            </div>
                            <div>
                              <strong style="display:block;color:var(--text-main);font-size:14px;">
                                <%= u.first_name ? (u.first_name + ' ' + (u.last_name || '')) : u.username %>
                              </strong>
                              <span style="font-size:12px;color:var(--text-muted);">@<%= u.username %></span>
                            </div>
                          </div>
                        </td>
                        <td>
                          <div style="font-size:13px;color:var(--text-main);"><%= u.email || '—' %></div>
                          <div style="font-size:12px;color:var(--text-muted);"><%= u.phone || '' %></div>
                        </td>
                        <td style="text-align:center;">
                          <% const roleName = u.role ? u.role.name : 'staff'; %>
                          <span class="role-badge role-<%= roleName %>">
                            <i class="ti <%= roleName === 'admin' ? 'ti-shield-check' : roleName === 'manager' ? 'ti-chart-tree-map' : roleName === 'cashier' ? 'ti-device-laptop' : 'ti-user' %>"></i>
                            <%= roleName %>
                          </span>
                        </td>
                        <td style="text-align:center;">
                          <button type="button"
                            class="badge-modern <%= u.is_active ? 'success' : 'danger' %>"
                            style="border:none;cursor:pointer;transition:opacity 0.2s;"
                            onclick="toggleStatus(<%= u.id %>, this)"
                            title="<%= u.is_active ? 'Click to deactivate' : 'Click to activate' %>"
                            <% if (u.id === user.id) { %>disabled title="Cannot change own status"<% } %>>
                            <i class="ti <%= u.is_active ? 'ti-check' : 'ti-x' %>"></i>
                            <%= u.is_active ? 'Active' : 'Inactive' %>
                          </button>
                        </td>
                        <td style="text-align:center;font-size:12px;color:var(--text-muted);">
                          <% if (u.last_login) { %>
                            <%= new Date(u.last_login).toLocaleDateString('en-IN', { day:'2-digit', month:'short', year:'numeric' }) %>
                          <% } else { %>
                            <span style="color:var(--text-muted);">Never</span>
                          <% } %>
                        </td>
                        <td style="text-align:center;">
                          <div style="display:flex;justify-content:center;gap:6px;">
                            <button type="button" class="btn-modern btn-secondary-modern btn-icon-only"
                              title="Edit user" onclick="openEditModal(<%= u.id %>)">
                              <i class="ti ti-edit"></i>
                            </button>
                            <% if (u.id !== user.id) { %>
                            <button type="button" class="btn-modern btn-danger-modern btn-icon-only"
                              title="Delete user" onclick="deleteUser(<%= u.id %>, '<%= u.username %>')">
                              <i class="ti ti-trash"></i>
                            </button>
                            <% } %>
                          </div>
                        </td>
                      </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>

              </div>
            </div>
          </div>

          <!-- ====================================================
               VIEW TAB 2: ROLES & PRIVILEGES GRID
               ==================================================== -->
          <div id="viewRolesTab" style="display:none;">
            <div style="margin-bottom: 16px; display: flex; justify-content: space-between; align-items: center;">
              <div>
                <h2 style="font-size: 16px; font-weight: 700; color: var(--text-main); margin-bottom: 2px;">
                  <i class="ti ti-shield-check" style="color: var(--primary);"></i> Defined System Roles &amp; Access Privileges
                </h2>
                <p style="font-size: 13px; color: var(--text-muted);">Click on any role to configure which sections, features, and actions staff in that role can perform</p>
              </div>
              <button type="button" class="btn-modern btn-primary-modern" onclick="openCreateRoleModal()">
                <i class="ti ti-plus"></i> Create New Role
              </button>
            </div>

            <div class="roles-grid" id="rolesGridContainer">
              <% roles.forEach(function(r) { 
                const rName = r.name.toLowerCase();
                const uCount = (typeof roleCounts !== 'undefined' && roleCounts[rName]) ? roleCounts[rName] : 0;
                const perms = Array.isArray(r.permissions) ? r.permissions : (r.permissions ? [r.permissions] : []);
                const isAll = perms.includes('*') || perms.includes('all');
                const permCountText = isAll ? 'Full Access (All Privileges)' : `${perms.length} Privileges Granted`;
                const isSystemRole = ['admin', 'manager', 'cashier', 'accountant', 'warehouse'].includes(rName);
              %>
              <div class="role-card" id="roleCard_<%= r.id %>">
                <div>
                  <div class="role-card-header">
                    <div class="role-icon-box <%= rName %>">
                      <i class="ti <%= rName === 'admin' ? 'ti-shield-check' : rName === 'manager' ? 'ti-chart-tree-map' : rName === 'cashier' ? 'ti-device-laptop' : rName === 'accountant' ? 'ti-wallet' : rName === 'warehouse' ? 'ti-boxes' : 'ti-user-check' %>"></i>
                    </div>
                    <% if (isSystemRole) { %>
                      <span class="badge-modern info" style="font-size: 11px;">Built-in Role</span>
                    <% } else { %>
                      <span class="badge-modern success" style="font-size: 11px;">Custom Role</span>
                    <% } %>
                  </div>

                  <h3 class="role-card-title"><%= r.name %></h3>
                  <p class="role-card-desc"><%= r.description || (rName === 'admin' ? 'Full unrestricted access to all software modules and configuration.' : rName === 'cashier' ? 'Access to POS billing checkout, invoicing, and day-end closing.' : rName === 'manager' ? 'Store operations, purchases, inventory, master records, and reports.' : 'Staff role with configured module privileges.') %></p>
                </div>

                <div>
                  <div class="role-card-stats">
                    <span><i class="ti ti-users" style="color: var(--text-muted);"></i> <strong><%= uCount %></strong> Users</span>
                    <span><i class="ti ti-key" style="color: var(--primary);"></i> <strong><%= permCountText %></strong></span>
                  </div>

                  <div class="role-card-actions">
                    <button type="button" class="btn-modern btn-primary-modern" style="flex: 1;" onclick="openRolePermissionsModal(<%= r.id %>, '<%= r.name %>')">
                      <i class="ti ti-lock-cog"></i> Configure Privileges
                    </button>
                    <% if (!isSystemRole) { %>
                    <button type="button" class="btn-modern btn-danger-modern btn-icon-only" title="Delete custom role" onclick="deleteRole(<%= r.id %>, '<%= r.name %>')">
                      <i class="ti ti-trash"></i>
                    </button>
                    <% } %>
                  </div>
                </div>
              </div>
              <% }) %>
            </div>
          </div>

        </main>

        <%- include('../partials/footer.ejs') %>
      </div>
    </div>
  </div>

  <!-- ══════════════════════════════════════════════════════
       MODAL 1: CONFIGURE ROLE PRIVILEGES (PERMISSION MATRIX)
  ══════════════════════════════════════════════════════ -->
  <div class="modal-overlay" id="rolePermissionsModal">
    <div class="modal-box" style="max-width: 860px; width: 95%;">
      <button class="modal-close-btn" onclick="closeModal('rolePermissionsModal')"><i class="ti ti-x"></i></button>
      
      <div class="modal-title">
        <i class="ti ti-shield-lock" style="color:var(--primary)"></i> 
        Configure Role Privileges: <span id="modalRoleNameHeading" style="text-transform: capitalize; color: var(--primary);"></span>
      </div>
      <div class="modal-subtitle" id="modalRoleSubtitle">Select which features, buttons, and sections this role is allowed to access</div>
      <input type="hidden" id="perm_role_id">

      <!-- Quick Preset & Selection Bar -->
      <div class="preset-bar">
        <span style="font-size: 12px; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Quick Presets:</span>
        <button type="button" class="preset-btn" onclick="applyPreset('admin')"><i class="ti ti-shield-check"></i> Admin (All)</button>
        <button type="button" class="preset-btn" onclick="applyPreset('manager')"><i class="ti ti-chart-tree-map"></i> Store Manager</button>
        <button type="button" class="preset-btn" onclick="applyPreset('cashier')"><i class="ti ti-device-laptop"></i> POS Cashier</button>
        <button type="button" class="preset-btn" onclick="applyPreset('accountant')"><i class="ti ti-wallet"></i> Accountant</button>
        <button type="button" class="preset-btn" onclick="applyPreset('warehouse')"><i class="ti ti-boxes"></i> Warehouse</button>
        <span style="margin: 0 4px; color: var(--border-color);">|</span>
        <button type="button" class="preset-btn" onclick="toggleAllPerms(true)"><i class="ti ti-check"></i> Select All</button>
        <button type="button" class="preset-btn" onclick="toggleAllPerms(false)"><i class="ti ti-x"></i> Clear All</button>
      </div>

      <!-- Permission Modules Matrix -->
      <form id="rolePermsForm" onsubmit="submitRolePermissions(event)">
        <div class="perm-modules-grid" id="permModulesContainer">
          <% if (typeof permissionModules !== 'undefined' && permissionModules.length > 0) { %>
            <% permissionModules.forEach(function(mod) { %>
              <div class="perm-module-card">
                <div class="perm-module-header">
                  <div class="perm-module-title">
                    <i class="ti <%= mod.icon %>" style="color: var(--primary);"></i> <%= mod.name %>
                  </div>
                  <button type="button" class="btn-modern btn-secondary-modern" style="padding: 2px 8px; font-size: 11px;" onclick="toggleModulePerms('<%= mod.module %>')">
                    Toggle
                  </button>
                </div>
                <div>
                  <% mod.permissions.forEach(function(p) { %>
                    <div class="perm-item-row">
                      <input type="checkbox" class="perm-item-checkbox perm-mod-<%= mod.module %>" id="chk_<%= p.key.replace('.', '_') %>" value="<%= p.key %>">
                      <label class="perm-item-text" for="chk_<%= p.key.replace('.', '_') %>">
                        <span class="perm-item-name"><%= p.name %></span>
                        <span class="perm-item-desc"><%= p.description %></span>
                      </label>
                    </div>
                  <% }) %>
                </div>
              </div>
            <% }) %>
          <% } %>
        </div>

        <div style="display:flex; justify-content:space-between; align-items:center; margin-top:16px; padding-top:14px; border-top: 1px solid var(--border-color);">
          <div id="selectedPermCount" style="font-size: 13px; color: var(--text-muted); font-weight: 600;">
            0 privileges selected
          </div>
          <div style="display:flex; gap:10px;">
            <button type="button" class="btn-modern btn-secondary-modern" onclick="closeModal('rolePermissionsModal')">Cancel</button>
            <button type="submit" class="btn-modern btn-primary-modern" id="saveRolePermsBtn">
              <i class="ti ti-device-floppy"></i> Save Privileges
            </button>
          </div>
        </div>
      </form>
    </div>
  </div>

  <!-- ══════════════════════════════════════════════════════
       MODAL 2: CREATE CUSTOM ROLE
  ══════════════════════════════════════════════════════ -->
  <div class="modal-overlay" id="createRoleModal">
    <div class="modal-box" style="max-width: 480px;">
      <button class="modal-close-btn" onclick="closeModal('createRoleModal')"><i class="ti ti-x"></i></button>
      <div class="modal-title"><i class="ti ti-shield-plus" style="color:var(--primary)"></i> Create New Role</div>
      <div class="modal-subtitle">Add a custom role with tailored module privileges</div>

      <form id="createRoleForm" onsubmit="submitCreateRole(event)">
        <div class="form-group-m">
          <label class="form-label-m">Role Name <span class="req">*</span></label>
          <input class="form-input-m" type="text" id="crole_name" placeholder="e.g. Supervisor, Billing Clerk" required>
        </div>

        <div class="form-group-m">
          <label class="form-label-m">Description</label>
          <textarea class="form-input-m" id="crole_desc" rows="2" placeholder="Brief description of role responsibilities..."></textarea>
        </div>

        <div class="form-group-m">
          <label class="form-label-m">Initial Privilege Template</label>
          <select class="form-input-m" id="crole_template">
            <option value="cashier">POS Cashier (Billing &amp; Invoicing)</option>
