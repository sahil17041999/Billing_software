<script>
// ══════════════════════════════════════════════════════════════
// TAB SWITCHING (Users vs Roles)
// ══════════════════════════════════════════════════════════════
function switchTab(tabName) {
  const usersTab = document.getElementById('viewUsersTab');
  const rolesTab = document.getElementById('viewRolesTab');
  const btnUsers = document.getElementById('tabBtnUsers');
  const btnRoles = document.getElementById('tabBtnRoles');

  if (tabName === 'roles') {
    usersTab.style.display = 'none';
    rolesTab.style.display = 'block';
    btnUsers.classList.remove('active');
    btnRoles.classList.add('active');
  } else {
    usersTab.style.display = 'block';
    rolesTab.style.display = 'none';
    btnUsers.classList.add('active');
    btnRoles.classList.remove('active');
  }
}

// ══════════════════════════════════════════════════════════════
// UTILITIES & MODAL HANDLING
// ══════════════════════════════════════════════════════════════
function openModal(id) {
  document.getElementById(id).classList.add('show');
  document.body.style.overflow = 'hidden';
}
function closeModal(id) {
  document.getElementById(id).classList.remove('show');
  document.body.style.overflow = '';
}
function showAlert(msg, type = 'success') {
  const el = document.getElementById('pageAlert');
  el.className = 'alert-banner alert-' + type;
  el.innerHTML = `<i class="ti ti-${type === 'success' ? 'circle-check' : 'alert-circle'}"></i> ${msg}`;
  el.style.display = 'flex';
  setTimeout(() => { el.style.display = 'none'; }, 5000);
}
function setFieldError(id, msg) {
  const el = document.getElementById(id);
  if (!el) return;
  el.textContent = msg;
  if (msg) el.classList.add('show'); else el.classList.remove('show');
}
function clearErrors(ids) {
  ids.forEach(id => setFieldError(id, ''));
}

// ══════════════════════════════════════════════════════════════
// ROLE PRIVILEGES CONFIGURATION
// ══════════════════════════════════════════════════════════════
let currentRolePresets = {};

async function openRolePermissionsModal(roleId, roleName) {
  showPageLoader('Loading role privileges...');
  try {
    const res = await fetch(`/admin/users/roles/${roleId}/permissions`, {
      headers: { 'Accept': 'application/json' }
    });
    const data = await res.json();
    if (!res.ok) {
      showAlert(data.error || 'Failed to load permissions', 'error');
      return;
    }

    currentRolePresets = data.defaultPresets || {};
    document.getElementById('perm_role_id').value = roleId;
    document.getElementById('modalRoleNameHeading').textContent = data.role.name;
    document.getElementById('modalRoleSubtitle').textContent = `Configure module access and action permissions for "${data.role.name}"`;

    const userPerms = data.role.permissions || [];
    const isAll = userPerms.includes('*') || userPerms.includes('all');

    // Uncheck all first
    document.querySelectorAll('.perm-item-checkbox').forEach(chk => {
      chk.checked = false;
    });

    // Check relevant boxes
    document.querySelectorAll('.perm-item-checkbox').forEach(chk => {
      if (isAll || userPerms.includes(chk.value)) {
        chk.checked = true;
      }
    });

    updateSelectedPermCount();
    openModal('rolePermissionsModal');
  } catch (err) {
    showAlert('Network error while loading permissions', 'error');
  } finally {
    hidePageLoader();
  }
}

function updateSelectedPermCount() {
  const total = document.querySelectorAll('.perm-item-checkbox').length;
  const checked = document.querySelectorAll('.perm-item-checkbox:checked').length;
  const label = document.getElementById('selectedPermCount');
  if (label) {
    if (checked === total) {
      label.innerHTML = `<span style="color: var(--success);"><i class="ti ti-check"></i> All ${total} Privileges Granted</span>`;
    } else {
      label.textContent = `${checked} of ${total} privileges selected`;
    }
  }
}

document.addEventListener('change', function(e) {
  if (e.target && e.target.classList.contains('perm-item-checkbox')) {
    updateSelectedPermCount();
  }
});

function toggleAllPerms(select) {
  document.querySelectorAll('.perm-item-checkbox').forEach(chk => {
    chk.checked = select;
  });
  updateSelectedPermCount();
}

function toggleModulePerms(mod) {
  const checkboxes = document.querySelectorAll(`.perm-mod-${mod}`);
  const allChecked = Array.from(checkboxes).every(c => c.checked);
  checkboxes.forEach(c => c.checked = !allChecked);
  updateSelectedPermCount();
}

function applyPreset(presetKey) {
  const perms = currentRolePresets[presetKey] || [];
  if (perms.includes('*')) {
    toggleAllPerms(true);
    return;
  }
  document.querySelectorAll('.perm-item-checkbox').forEach(chk => {
    chk.checked = perms.includes(chk.value);
  });
  updateSelectedPermCount();
}

async function submitRolePermissions(e) {
  e.preventDefault();
  const roleId = document.getElementById('perm_role_id').value;
  const checkedBoxes = document.querySelectorAll('.perm-item-checkbox:checked');
  const allBoxes = document.querySelectorAll('.perm-item-checkbox');

  let permissions = [];
  if (checkedBoxes.length === allBoxes.length && allBoxes.length > 0) {
    permissions = ['*'];
  } else {
    checkedBoxes.forEach(chk => permissions.push(chk.value));
  }

  const btn = document.getElementById('saveRolePermsBtn');
  btn.disabled = true;
  btn.innerHTML = '<i class="ti ti-loader-2" style="animation:loaderSpin 0.75s linear infinite"></i> Saving...';

  try {
    showPageLoader('Saving role privileges...');
    const res = await fetch(`/admin/users/roles/${roleId}/permissions`, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({ permissions })
    });
    const data = await res.json();

    if (!res.ok) {
      showAlert(data.error || 'Failed to save privileges', 'error');
      return;
    }

    closeModal('rolePermissionsModal');
    showAlert(data.message || 'Privileges updated successfully!', 'success');
    setTimeout(() => location.reload(), 1000);
  } catch (err) {
    showAlert('Network error while saving permissions', 'error');
  } finally {
    hidePageLoader();
    btn.disabled = false;
    btn.innerHTML = '<i class="ti ti-device-floppy"></i> Save Privileges';
  }
}

// ══════════════════════════════════════════════════════════════
// CREATE ROLE
// ══════════════════════════════════════════════════════════════
function openCreateRoleModal() {
  document.getElementById('createRoleForm').reset();
  openModal('createRoleModal');
}

async function submitCreateRole(e) {
  e.preventDefault();
  const name = document.getElementById('crole_name').value.trim();
  const description = document.getElementById('crole_desc').value.trim();
  const template = document.getElementById('crole_template').value;

  if (!name) {
    showAlert('Role name is required', 'error');
    return;
  }

  const btn = document.getElementById('createRoleSubmitBtn');
  btn.disabled = true;
  btn.innerHTML = '<i class="ti ti-loader-2" style="animation:loaderSpin 0.75s linear infinite"></i> Creating...';

  try {
    const defaultPerms = currentRolePresets[template] || ['dashboard.view'];
    const res = await fetch('/admin/users/roles', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({ name, description, permissions: defaultPerms })
    });
    const data = await res.json();

    if (!res.ok) {
      showAlert(data.error || 'Failed to create role', 'error');
      return;
    }

    closeModal('createRoleModal');
    showAlert(data.message, 'success');
    setTimeout(() => location.reload(), 1200);
  } catch (err) {
    showAlert('Network error', 'error');
  } finally {
    btn.disabled = false;
    btn.innerHTML = '<i class="ti ti-check"></i> Create Role';
  }
}

async function deleteRole(roleId, roleName) {
  const confirm = await showConfirm(
    'Delete Role?',
    `Are you sure you want to delete role "${roleName}"?`,
    'Yes, Delete'
  );
  if (!confirm.isConfirmed) return;

  try {
    showPageLoader('Deleting role...');
    const res = await fetch(`/admin/users/roles/${roleId}`, {
      method: 'DELETE',
      headers: { 'Accept': 'application/json' }
    });
    const data = await res.json();

    if (!res.ok) {
      showAlert(data.error || 'Failed to delete role', 'error');
      return;
    }

    showAlert(data.message, 'success');
    setTimeout(() => location.reload(), 1000);
  } catch (err) {
    showAlert('Network error', 'error');
  } finally {
    hidePageLoader();
  }
}

// ══════════════════════════════════════════════════════════════
// CREATE USER
// ══════════════════════════════════════════════════════════════
function openCreateModal() {
  document.getElementById('createUserForm').reset();
  clearErrors(['cu_username_err','cu_email_err','cu_phone_err','cu_role_err']);
  openModal('createUserModal');
}

// ══════════════════════════════════════════════════════════════
// EDIT USER
// ══════════════════════════════════════════════════════════════
async function openEditModal(userId) {
  showPageLoader('Loading user details...');
  try {
    const res = await fetch(`/admin/users/${userId}`, { headers: { 'Accept': 'application/json' } });
    const u = await res.json();
    if (!res.ok) { showAlert(u.error || 'Failed to load user', 'error'); return; }

    document.getElementById('eu_id').value         = u.id;
    document.getElementById('eu_first_name').value = u.first_name || '';
    document.getElementById('eu_last_name').value  = u.last_name  || '';
    document.getElementById('eu_email').value      = u.email      || '';
    document.getElementById('eu_phone').value      = u.phone      || '';
    document.getElementById('eu_role_id').value    = u.role_id    || '';
    document.getElementById('eu_is_active').value  = u.is_active  ? '1' : '0';
    document.getElementById('editModalSubtitle').textContent = `Editing @${u.username}`;

    clearErrors(['eu_email_err','eu_phone_err','eu_role_err']);
    openModal('editUserModal');
  } catch (err) {
    showAlert('Network error', 'error');
  } finally {
    hidePageLoader();
  }
}

// ══════════════════════════════════════════════════════════════
// TOGGLE STATUS
// ══════════════════════════════════════════════════════════════
async function toggleStatus(userId, btn) {
  const isActive = btn.classList.contains('success');
  const action = isActive ? 'Deactivate' : 'Activate';

  const confirm = await showConfirm(`${action} User?`,
    isActive ? 'This user will no longer be able to log in.' : 'This user will be able to log in again.',
    `Yes, ${action}`);
  if (!confirm.isConfirmed) return;

  try {
    showPageLoader('Updating account status...');
    const res = await fetch(`/admin/users/${userId}/toggle-status`, {
      method: 'PATCH',
      headers: { 'Accept': 'application/json' }
    });
    const data = await res.json();

    if (!res.ok) { showAlert(data.error || 'Failed to update status', 'error'); return; }

    if (data.is_active) {
      btn.className = 'badge-modern success';
      btn.innerHTML = '<i class="ti ti-check"></i> Active';
      btn.title = 'Click to deactivate';
      btn.closest('tr').setAttribute('data-active', '1');
    } else {
      btn.className = 'badge-modern danger';
      btn.innerHTML = '<i class="ti ti-x"></i> Inactive';
      btn.title = 'Click to activate';
      btn.closest('tr').setAttribute('data-active', '0');
    }
    showAlert(data.message, 'success');
  } catch(err) {
    showAlert('Network error', 'error');
  } finally {
    hidePageLoader();
  }
}

// ══════════════════════════════════════════════════════════════
// JQUERY VALIDATIONS INITIALIZATION
// ══════════════════════════════════════════════════════════════
$(document).ready(function() {
  // Auto-sanitize phone inputs
  $('#cu_phone, #eu_phone').on('input', function() {
    let val = $(this).val().replace(/[^0-9]/g, '');
    if (val.length > 10) val = val.slice(0, 10);
    $(this).val(val);
  });

  // 1. Create User Form Validation
  initFormValidation('#createUserForm', {
    rules: {
      phone: {
        required: true,
        phoneIN: true,
        remote: {
          url: '/admin/users/check-duplicate',
          type: 'GET',
          data: { field: 'phone' }
        }
      },
      email: {
        email: true,
        remote: {
          url: '/admin/users/check-duplicate',
          type: 'GET',
          data: { field: 'email' }
        }
      },
      username: {
        remote: {
          url: '/admin/users/check-duplicate',
          type: 'GET',
          data: { field: 'username' }
        }
      },
      role_id: { required: true }
    },
    messages: {
      phone: {
        required: 'Please enter a 10-digit mobile number',
        phoneIN: 'Please enter a valid 10-digit Indian mobile number (starts with 6, 7, 8, or 9)',
        remote: 'This mobile number is already registered in the database'
      },
      email: {
        email: 'Please enter a valid email address',
        remote: 'This email address is already in use'
      },
      username: {
        remote: 'This username is already taken'
      },
      role_id: { required: 'Please assign a role' }
    },
    onSubmit: async function(form, $form) {
      clearErrors(['cu_phone_err','cu_username_err','cu_email_err','cu_role_err']);
      const body = {
        first_name:  $('#cu_first_name').val().trim(),
        last_name:   $('#cu_last_name').val().trim(),
        phone:       $('#cu_phone').val().trim(),
        username:    $('#cu_username').val().trim(),
        email:       $('#cu_email').val().trim(),
        role_id:     $('#cu_role_id').val()
      };

      try {
        showPageLoader('Registering user account...');
        const res = await fetch('/admin/users', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify(body)
        });
        const data = await res.json();

        if (!res.ok) {
          if (data.errors) {
            data.errors.forEach(msg => {
              if (msg.includes('phone') || msg.includes('mobile') || msg.includes('Mobile')) setFieldError('cu_phone_err', msg);
              else if (msg.includes('username')) setFieldError('cu_username_err', msg);
              else if (msg.includes('email') || msg.includes('Email')) setFieldError('cu_email_err', msg);
              else if (msg.includes('role') || msg.includes('Role')) setFieldError('cu_role_err', msg);
            });
          } else {
            const err = data.error || 'Failed to create user';
            if (err.includes('mobile') || err.includes('phone') || err.includes('Mobile')) {
              setFieldError('cu_phone_err', err);
              $('#cu_phone').addClass('is-invalid');
            } else if (err.includes('email') || err.includes('Email')) {
              setFieldError('cu_email_err', err);
              $('#cu_email').addClass('is-invalid');
            } else if (err.includes('username')) {
              setFieldError('cu_username_err', err);
              $('#cu_username').addClass('is-invalid');
            }
            showAlert(err, 'error');
          }
          return;
        }

        closeModal('createUserModal');
        showAlert(data.message, 'success');
        setTimeout(() => location.reload(), 1100);
      } catch(err) {
        showAlert('Network error. Please try again.', 'error');
      } finally {
        hidePageLoader();
      }
    }
  });

  // 2. Edit User Form Validation
  initFormValidation('#editUserForm', {
    rules: {
      phone: {
        required: true,
        phoneIN: true,
        remote: {
          url: '/admin/users/check-duplicate',
          type: 'GET',
          data: {
            field: 'phone',
            id: function() { return $('#eu_id').val(); }
          }
        }
      },
      email: {
        email: true,
        remote: {
          url: '/admin/users/check-duplicate',
          type: 'GET',
          data: {
            field: 'email',
            id: function() { return $('#eu_id').val(); }
          }
        }
      },
      role_id: { required: true }
    },
    messages: {
      phone: {
        required: 'Please enter a 10-digit mobile number',
        phoneIN: 'Please enter a valid 10-digit Indian mobile number (starts with 6, 7, 8, or 9)',
        remote: 'This mobile number is already in use by another user'
      },
      email: {
        email: 'Please enter a valid email address',
        remote: 'This email address is already in use by another user'
      },
      role_id: { required: 'Please select a role' }
    },
    onSubmit: async function(form, $form) {
      const userId = $('#eu_id').val();
      clearErrors(['eu_phone_err','eu_email_err','eu_role_err']);

      const body = {
        first_name: $('#eu_first_name').val().trim(),
        last_name:  $('#eu_last_name').val().trim(),
        phone:      $('#eu_phone').val().trim(),
        email:      $('#eu_email').val().trim(),
        role_id:    $('#eu_role_id').val(),
        is_active:  $('#eu_is_active').val()
      };

      try {
        showPageLoader('Updating user details...');
        const res = await fetch(`/admin/users/${userId}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify(body)
        });
        const data = await res.json();

        if (!res.ok) {
          if (data.errors) {
            data.errors.forEach(msg => {
              if (msg.includes('phone') || msg.includes('mobile') || msg.includes('Mobile')) setFieldError('eu_phone_err', msg);
              else if (msg.includes('email') || msg.includes('Email')) setFieldError('eu_email_err', msg);
              else if (msg.includes('role') || msg.includes('Role')) setFieldError('eu_role_err', msg);
            });
          } else {
            const err = data.error || 'Failed to update user';
            if (err.includes('mobile') || err.includes('phone') || err.includes('Mobile')) {
              setFieldError('eu_phone_err', err);
            }
            showAlert(err, 'error');
          }
          return;
        }

        closeModal('editUserModal');
        showAlert(data.message, 'success');
        setTimeout(() => location.reload(), 1100);
      } catch(err) {
        showAlert('Network error', 'error');
      } finally {
        hidePageLoader();
      }
    }
  });

  // 4. Create Role Form Validation
  initFormValidation('#createRoleForm', {
    rules: {
      crole_name: { required: true, minlength: 2 }
    },
    messages: {
      crole_name: { required: 'Please enter role name', minlength: 'Role name must be at least 2 characters' }
    },
    onSubmit: async function(form, $form) {
      const body = {
        name: $('#crole_name').val().trim(),
        description: $('#crole_desc').val().trim(),
        template: $('#crole_template').val()
      };

      try {
        showPageLoader('Creating new role...');
        const res = await fetch('/admin/users/roles', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify(body)
        });
        const data = await res.json();
        if (!res.ok) { showAlert(data.error || 'Failed to create role', 'error'); return; }

        closeModal('createRoleModal');
        showAlert(data.message, 'success');
        setTimeout(() => location.reload(), 1100);
      } catch(err) {
        showAlert('Network error. Please try again.', 'error');
      } finally {
        hidePageLoader();
      }
    }
  });
});

// ══════════════════════════════════════════════════════════════
// DELETE USER
// ══════════════════════════════════════════════════════════════
async function deleteUser(userId, username) {
  const confirm = await showConfirm(
    'Delete User?',
    `This will permanently delete "@${username}". This cannot be undone.`,
    'Yes, Delete'
  );
  if (!confirm.isConfirmed) return;

  try {
    showPageLoader('Deleting...');
    const res = await fetch(`/admin/users/${userId}`, {
      method: 'DELETE',
      headers: { 'Accept': 'application/json' }
    });
    const data = await res.json();
    if (!res.ok) { showAlert(data.error || 'Failed to delete', 'error'); return; }

    const row = document.querySelector(`tr[data-id="${userId}"]`);
    if (row) { row.style.opacity = '0'; setTimeout(() => { row.remove(); }, 300); }
    showAlert(data.message, 'success');
  } catch(err) {
    showAlert('Network error', 'error');
  } finally {
    hidePageLoader();
  }
}

// ══════════════════════════════════════════════════════════════
// SEARCH & FILTER
// ══════════════════════════════════════════════════════════════
function filterTable() {
  const search     = document.getElementById('userSearch').value.toLowerCase();
  const roleFilter = document.getElementById('roleFilter').value;
  const statusFilter = document.getElementById('statusFilter').value;
  const rows       = document.querySelectorAll('#usersTableBody tr[data-id]');

  rows.forEach(row => {
    const name     = row.getAttribute('data-name') || '';
    const username = row.getAttribute('data-username') || '';
    const email    = row.getAttribute('data-email') || '';
    const role     = row.getAttribute('data-role') || '';
    const active   = row.getAttribute('data-active') || '';

    const matchSearch = !search || name.includes(search) || username.includes(search) || email.includes(search);
    const matchRole   = !roleFilter || role === roleFilter;
    const matchStatus = !statusFilter || active === statusFilter;

    row.style.display = (matchSearch && matchRole && matchStatus) ? '' : 'none';
  });
}

document.getElementById('userSearch').addEventListener('input', filterTable);
document.getElementById('roleFilter').addEventListener('change', filterTable);
document.getElementById('statusFilter').addEventListener('change', filterTable);

// Close modal on overlay click
document.querySelectorAll('.modal-overlay').forEach(overlay => {
  overlay.addEventListener('click', function(e) {
    if (e.target === this) {
      this.classList.remove('show');
      document.body.style.overflow = '';
    }
  });
});
</script>
</body>
