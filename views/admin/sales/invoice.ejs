            <% if (company) { %>
              <%= company.address || 'Main Market Road' %><% if (company.city) { %>, <%= company.city %><% } %><% if (company.state) { %>, <%= company.state %><% } %><% if (company.postal_code) { %> - <%= company.postal_code %><% } %><br>
              <% if (company.phone) { %><strong>Phone:</strong> <%= company.phone %> &nbsp;|&nbsp; <% } %>
              <% if (company.email) { %><strong>Email:</strong> <%= company.email %><% } %>
            <% } else { %>
              Commercial Hub, Market Street<br>
