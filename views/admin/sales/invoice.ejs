            <% if (sale.customer) { %>
              <% if (customerAddress) { %><%= customerAddress %><br><% } %>
              <% if (sale.customer.city || sale.customer.state) { %>
                <%= [sale.customer.city, sale.customer.state, sale.customer.postal_code].filter(Boolean).join(', ') %><br>
              <% } %>
              <% if (customerPhone) { %><strong>Mobile:</strong> <%= customerPhone %> &nbsp;<% } %>
              <% if (sale.customer.email) { %><strong>Email:</strong> <%= sale.customer.email %><br><% } %>
              <% if (customerGstin) { %><strong>GSTIN/UIN:</strong> <%= customerGstin %><% } %>
            <% } else { %>
              Walk-in Retail Customer<br>
              Counter Sale / Cash Transaction
            <% } %>
          </div>
        </div>

        <div class="party-box">
          <div class="box-header">&#128230; Dispatch & Supply Details:</div>
          <div class="party-info">
            <strong>Place of Supply:</strong> <%= (sale.customer && sale.customer.state) ? sale.customer.state : ((company && company.state) ? company.state : 'State Supply') %><br>
            <strong>Reverse Charge:</strong> No<br>
            <strong>Transportation Mode:</strong> Over the counter / Hand delivery<br>
            <strong>Sale Type:</strong> <%= (sale.customer && sale.customer.customer_type === 'wholesale') ? 'B2B Wholesale' : 'B2C Retail' %>
          </div>
        </div>
      </div>

      <!-- Item Details Table -->
      <div class="mobile-scroll-hint">
        <i class="ti ti-arrows-left-right"></i> Scroll sideways to view full invoice table
      </div>
      <div class="table-responsive-touch">
        <table class="inv-table">
        <thead>
          <tr>
            <th style="width: 30px;" class="text-center">#</th>
            <th class="text-left">Description of Goods</th>
            <th style="width: 70px;" class="text-center">HSN/SAC</th>
            <th style="width: 50px;" class="text-center">Qty</th>
            <th style="width: 45px;" class="text-center">Unit</th>
            <th style="width: 75px;" class="text-right">Rate (&#8377;)</th>
            <th style="width: 65px;" class="text-right">Disc (&#8377;)</th>
            <th style="width: 80px;" class="text-right">Taxable (&#8377;)</th>
            <th style="width: 55px;" class="text-right">GST %</th>
            <th style="width: 70px;" class="text-right">Tax (&#8377;)</th>
            <th style="width: 85px;" class="text-right">Amount (&#8377;)</th>
          </tr>
        </thead>
        <tbody>
          <% if (items.length > 0) { %>
            <% items.forEach(function(item, idx) { 
                const pName = item.product ? item.product.name : ('Product #' + item.product_id);
                const pSku = item.product ? item.product.sku : '';
                const pUnit = (item.product && (item.product.unit || item.product.Unit)) ? (item.product.unit || item.product.Unit).name : 'Pcs';
                const taxObj = item.product && (item.product.tax || item.product.Tax);
                const tRate = taxObj ? Number(taxObj.rate || 0) : 0;
                const uPrice = Number(item.unit_price || 0);
                const q = Number(item.quantity || 0);
                const dAmt = Number(item.discount_amount || 0);
                const taxable = (uPrice * q) - dAmt;
                const tAmt = Number(item.tax_amount || 0);
                const lTotal = Number(item.line_total || (taxable + tAmt));
                const hsn = (item.product && item.product.barcode) ? item.product.barcode.substring(0,6) : '0000';
            %>
            <tr>
              <td class="text-center" style="color: #64748b;"><%= idx + 1 %></td>
              <td>
                <div class="item-desc-name"><%= pName %></div>
                <div class="item-desc-sub">
                  <% if (pSku) { %><span>SKU: <%= pSku %></span><% } %>
                  <% if (item.batch_number) { %> &bull; <span>Batch: <%= item.batch_number %></span><% } %>
                </div>
              </td>
              <td class="text-center" style="color: #475569; font-family: monospace;"><%= hsn %></td>
              <td class="text-center pos-bold"><%= q %></td>
              <td class="text-center" style="color: #475569;"><%= pUnit %></td>
              <td class="text-right">&#8377;<%= uPrice.toFixed(2) %></td>
              <td class="text-right" style="color: <%= dAmt > 0 ? '#dc2626' : '#94a3b8' %>;">
                <%= dAmt > 0 ? ('&#8377;' + dAmt.toFixed(2)) : '0.00' %>
              </td>
              <td class="text-right">&#8377;<%= taxable.toFixed(2) %></td>
              <td class="text-right" style="color: #475569;"><%= tRate %>%</td>
              <td class="text-right">&#8377;<%= tAmt.toFixed(2) %></td>
              <td class="text-right pos-bold">&#8377;<%= lTotal.toFixed(2) %></td>
            </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="11" class="text-center" style="padding: 20px; color: #94a3b8;">No invoice items found</td>
            </tr>
          <% } %>
        </tbody>
        <tfoot>
          <tr>
            <td colspan="3" class="text-left">TOTAL (<%= items.length %> Items)</td>
            <td class="text-center"><%= totalQty %></td>
            <td></td>
            <td></td>
            <td class="text-right">&#8377;<%= totalLineDiscount.toFixed(2) %></td>
            <td class="text-right">&#8377;<%= totalTaxableVal.toFixed(2) %></td>
            <td></td>
            <td class="text-right">&#8377;<%= taxAmount.toFixed(2) %></td>
            <td class="text-right" style="color: #1e3a8a;">&#8377;<%= grandTotal.toFixed(2) %></td>
          </tr>
        </tfoot>
      </table>
      </div>

      <!-- GST Tax Breakup Summary Matrix -->
      <div class="tax-breakup-section">
        <div class="tax-breakup-header">GST Tax Breakup Matrix (Statutory)</div>
        <div class="table-responsive-touch">
        <table class="tax-table">
          <thead>
            <tr>
              <th>GST Tax Bracket</th>
              <th>Taxable Value (&#8377;)</th>
              <th>CGST Rate</th>
              <th>CGST Amount (&#8377;)</th>
              <th>SGST Rate</th>
              <th>SGST Amount (&#8377;)</th>
              <th>Total Tax (&#8377;)</th>
            </tr>
          </thead>
          <tbody>
            <% 
              let sumTaxable = 0;
              let sumCgst = 0;
              let sumSgst = 0;
              let sumTotalTax = 0;
              const taxKeys = Object.keys(taxMap);
              if (taxKeys.length > 0) {
                taxKeys.forEach(function(k) {
                  const entry = taxMap[k];
                  const halfRate = (entry.rate / 2).toFixed(1);
                  const halfTax = entry.taxAmt / 2;
                  sumTaxable += entry.taxable;
                  sumCgst += halfTax;
                  sumSgst += halfTax;
                  sumTotalTax += entry.taxAmt;
            %>
            <tr>
              <td>GST @ <%= entry.rate %>%</td>
              <td>&#8377;<%= entry.taxable.toFixed(2) %></td>
              <td><%= halfRate %>%</td>
              <td>&#8377;<%= halfTax.toFixed(2) %></td>
              <td><%= halfRate %>%</td>
              <td>&#8377;<%= halfTax.toFixed(2) %></td>
              <td><strong>&#8377;<%= entry.taxAmt.toFixed(2) %></strong></td>
            </tr>
            <% 
                });
              } else {
            %>
            <tr>
              <td>GST Exempt / Nil Rated</td>
              <td>&#8377;<%= totalTaxableVal.toFixed(2) %></td>
              <td>0%</td>
              <td>&#8377;0.00</td>
              <td>0%</td>
              <td>&#8377;0.00</td>
              <td>&#8377;0.00</td>
            </tr>
            <% } %>
          </tbody>
          <tfoot>
            <tr>
              <td>Total</td>
              <td>&#8377;<%= sumTaxable.toFixed(2) %></td>
              <td>-</td>
              <td>&#8377;<%= sumCgst.toFixed(2) %></td>
              <td>-</td>
              <td>&#8377;<%= sumSgst.toFixed(2) %></td>
              <td>&#8377;<%= sumTotalTax.toFixed(2) %></td>
            </tr>
          </tfoot>
        </table>
        </div>
      </div>

      <!-- Bottom Financial Summary & Settlement -->
      <div class="inv-bottom-grid">
