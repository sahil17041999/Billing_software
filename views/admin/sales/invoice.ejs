        </div>

        <div class="inv-meta-block">
          <div class="meta-row">
            <span class="meta-lbl">Invoice No:</span>
            <span class="meta-val" style="font-family: monospace; font-size: 13px; color: #1e3a8a;"><%= sale.invoice_number %></span>
          </div>
          <div class="meta-row">
            <span class="meta-lbl">Invoice Date:</span>
            <span class="meta-val"><%= new Date(sale.invoice_date).toLocaleDateString('en-IN', { day:'2-digit', month:'short', year:'numeric' }) %></span>
          </div>
          <div class="meta-row">
            <span class="meta-lbl">Invoice Time:</span>
            <span class="meta-val"><%= new Date(sale.invoice_date).toLocaleTimeString('en-IN', { hour:'2-digit', minute:'2-digit', hour12: true }) %></span>
          </div>
          <div class="meta-row">
            <span class="meta-lbl">Payment Mode:</span>
            <span class="meta-val"><%= paymentName %></span>
          </div>
          <div class="meta-row">
            <span class="meta-lbl">Payment Status:</span>
            <span class="meta-val" style="color:<%= isPaid ? '#059669' : '#dc2626' %>;">
              <%= (sale.payment_status || 'PAID').toUpperCase() %>
            </span>
          </div>
          <div class="meta-row">
            <span class="meta-lbl">Billed By (Cashier):</span>
            <span class="meta-val"><%= cashierName %></span>
          </div>
        </div>
      </div>

      <!-- Buyer (Bill To) & Consignee (Ship To) Grid -->
      <div class="inv-parties-grid">
        <div class="party-box">
          <div class="box-header">&#128100; Details of Receiver / Billed To:</div>
