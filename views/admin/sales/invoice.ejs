        <span><strong><%= paymentName %></strong></span>
      </div>
      <div class="pos-flex">
        <span>Payment Status:</span>
        <span><strong><%= isPaid ? 'PAID' : 'PENDING' %></strong></span>
      </div>

      <% if (discountAmount > 0 || totalLineDiscount > 0) { %>
      <div class="pos-savings">
        *** YOU SAVED &#8377;<%= (discountAmount + totalLineDiscount).toFixed(2) %> ON THIS BILL ***
      </div>
      <% } %>

      <div class="pos-qr-box" id="thermalQrContainer">
        <!-- Thermal QR rendered via JS -->
      </div>

      <div class="pos-center" style="font-size: 10px; margin-top: 4px;">
        Thank You! Visit Again!<br>
        Goods once sold cannot be returned without bill.<br>
        *** <%= company ? company.name : 'Billing ERP' %> ***
      </div>
    </div>

  </div>

  <script>
    // Indian Number to Words Converter
    function numberToWordsINR(num) {
      if (num === null || num === undefined || isNaN(num)) return 'Zero Rupees Only';
      
      const a = ['', 'One ', 'Two ', 'Three ', 'Four ', 'Five ', 'Six ', 'Seven ', 'Eight ', 'Nine ', 'Ten ', 'Eleven ', 'Twelve ', 'Thirteen ', 'Fourteen ', 'Fifteen ', 'Sixteen ', 'Seventeen ', 'Eighteen ', 'Nineteen '];
      const b = ['', '', 'Twenty', 'Thirty', 'Forty', 'Fifty', 'Sixty', 'Seventy', 'Eighty', 'Ninety'];

      function inWords(n) {
        if ((n = n.toString()).length > 9) return 'Overflow';
        const nArr = ('000000000' + n).substr(-9).match(/^(\d{2})(\d{2})(\d{2})(\d{1})(\d{2})$/);
        if (!nArr) return '';
        let str = '';
        str += (Number(nArr[1]) !== 0) ? (a[Number(nArr[1])] || b[nArr[1][0]] + ' ' + a[nArr[1][1]]) + 'Crore ' : '';
        str += (Number(nArr[2]) !== 0) ? (a[Number(nArr[2])] || b[nArr[2][0]] + ' ' + a[nArr[2][1]]) + 'Lakh ' : '';
        str += (Number(nArr[3]) !== 0) ? (a[Number(nArr[3])] || b[nArr[3][0]] + ' ' + a[nArr[3][1]]) + 'Thousand ' : '';
        str += (Number(nArr[4]) !== 0) ? (a[Number(nArr[4])] || b[nArr[4][0]] + ' ' + a[nArr[4][1]]) + 'Hundred ' : '';
        str += (Number(nArr[5]) !== 0) ? ((str !== '') ? 'and ' : '') + (a[Number(nArr[5])] || b[nArr[5][0]] + ' ' + a[nArr[5][1]]) : '';
        return str.trim();
      }

      const totalVal = Math.abs(Number(num));
      const whole = Math.floor(totalVal);
      const fraction = Math.round((totalVal - whole) * 100);

      let words = 'Indian Rupees ' + inWords(whole);
      if (fraction > 0) {
        words += ' and ' + inWords(fraction) + ' Paise';
      }
      words += ' Only';
      return words;
    }

    // Initialize Amount in Words
    const totalAmountValue = <%= grandTotal %>;
    document.getElementById('amountWordsDisplay').innerText = numberToWordsINR(totalAmountValue);

    // Switch View Mode (Standard A4 vs Thermal 80mm)
    function switchViewMode(mode) {
      const a4Doc = document.getElementById('standardA4Doc');
      const thermalDoc = document.getElementById('thermalPosDoc');
      const btnA4 = document.getElementById('btnModeA4');
      const btnThermal = document.getElementById('btnModeThermal');

      if (mode === 'thermal') {
        document.body.classList.remove('mode-a4');
        document.body.classList.add('mode-thermal');
        a4Doc.style.display = 'none';
        thermalDoc.style.display = 'block';
        btnA4.classList.remove('active');
        btnThermal.classList.add('active');
      } else {
        document.body.classList.remove('mode-thermal');
        document.body.classList.add('mode-a4');
        a4Doc.style.display = 'block';
        thermalDoc.style.display = 'none';
        btnThermal.classList.remove('active');
        btnA4.classList.add('active');
      }
    }

    // Switch Copy Tag
    function updateCopyTag(val) {
      document.getElementById('displayCopyTag').innerText = val;
    }

    // Render Dynamic UPI QR Code
    function generateInvoiceQRs() {
      const upiString = "upi://pay?pa=<%= (company && company.email) ? company.email : 'billing@upi' %>&pn=<%= encodeURIComponent(company ? company.name : 'Grocery Store') %>&am=<%= grandTotal %>&cu=INR&tn=Invoice-<%= sale.invoice_number %>";
      
      const standardContainer = document.getElementById('standardQrContainer');
      const thermalContainer = document.getElementById('thermalQrContainer');

      if (typeof QRCode !== 'undefined') {
        // Standard A4 QR
        const a4Canvas = document.createElement('canvas');
        QRCode.toCanvas(a4Canvas, upiString, { width: 70, margin: 1, color: { dark: '#0f172a', light: '#ffffff' } }, function (err) {
          if (!err) {
            standardContainer.innerHTML = '';
            standardContainer.appendChild(a4Canvas);
          }
        });

        // Thermal QR
        const thermalCanvas = document.createElement('canvas');
        QRCode.toCanvas(thermalCanvas, upiString, { width: 85, margin: 1, color: { dark: '#000000', light: '#ffffff' } }, function (err) {
          if (!err) {
            thermalContainer.innerHTML = '';
            thermalContainer.appendChild(thermalCanvas);
          }
        });
      }
    }

    // Prompt Email Invoice with SweetAlert2
    function promptEmailInvoice() {
      const defaultEmail = '<%= (sale.customer && sale.customer.email) ? sale.customer.email : "" %>';
      
      Swal.fire({
        title: 'Email Tax Invoice',
        html: `
          <div style="text-align: left; margin-top: 10px;">
            <label style="font-size: 13px; font-weight: 600; color: #475569; display: block; margin-bottom: 6px;">Customer Email Address</label>
            <input type="email" id="swalEmailInput" class="swal2-input" placeholder="e.g. customer@example.com" value="${defaultEmail}" style="width: 100%; margin: 0; box-sizing: border-box; font-size: 14px;">
          </div>
        `,
        showCancelButton: true,
        confirmButtonText: 'Send Email',
        confirmButtonColor: '#2563eb',
        cancelButtonText: 'Cancel',
        showLoaderOnConfirm: true,
        preConfirm: () => {
          const email = document.getElementById('swalEmailInput').value.trim();
          if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
            Swal.showValidationMessage('Please enter a valid email address');
            return false;
          }
          return fetch('/admin/sales/invoice/<%= sale.id %>/email', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({ email: email })
          })
          .then(res => res.json().then(data => ({ ok: res.ok, data })))
          .then(({ ok, data }) => {
            if (!ok || !data.success) {
              throw new Error(data.error || 'Failed to send invoice email');
            }
            return data;
          })
          .catch(err => {
            Swal.showValidationMessage(`Error: ${err.message}`);
          });
        },
        allowOutsideClick: () => !Swal.isLoading()
      }).then((result) => {
        if (result.isConfirmed) {
          Swal.fire({
            icon: 'success',
            title: 'Invoice Sent!',
            text: result.value?.message || 'Tax invoice has been successfully dispatched to customer.',
            confirmButtonColor: '#2563eb'
          });
        }
      });
    }

    // Auto-generate QR codes on load
    window.addEventListener('DOMContentLoaded', generateInvoiceQRs);
  </script>
</body>
</html>
