              <img src="<%= company.logo_path %>" alt="<%= company.name %>" style="max-height: 52px; max-width: 160px; object-fit: contain; border-radius: 4px;">
            <% } else { %>
              <div style="width: 44px; height: 44px; border-radius: 8px; background: #0f172a; color: #ffffff; display: inline-flex; align-items: center; justify-content: center; font-size: 20px; font-weight: 900;">
                <%= company && company.name ? company.name.charAt(0).toUpperCase() : 'P' %>
