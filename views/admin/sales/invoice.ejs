              <div><strong>Bank & Branch:</strong> State Bank of India, Main Branch</div>
              <div><strong>Scan & Pay:</strong> Instant UPI Verification</div>
            </div>
          </div>

        </div>

        <div class="inv-bottom-right">
          <div class="summary-row">
            <span style="color: #64748b;">Sub Total (Gross):</span>
            <span style="font-weight: 700;">&#8377;<%= subtotal.toFixed(2) %></span>
          </div>
          <% if (discountAmount > 0) { %>
          <div class="summary-row discount">
            <span>Special / Bill Discount:</span>
            <span style="font-weight: 700;">- &#8377;<%= discountAmount.toFixed(2) %></span>
          </div>
          <% } %>
          <div class="summary-row">
            <span style="color: #64748b;">Taxable Value:</span>
            <span style="font-weight: 700;">&#8377;<%= totalTaxableVal.toFixed(2) %></span>
          </div>
          <div class="summary-row">
            <span style="color: #64748b;">Total GST Tax:</span>
            <span style="font-weight: 700;">+ &#8377;<%= taxAmount.toFixed(2) %></span>
          </div>
          <div class="summary-row grand">
            <span>NET AMOUNT PAYABLE</span>
            <span class="val">&#8377;<%= grandTotal.toFixed(2) %></span>
          </div>
        </div>
      </div>

      <!-- Legal Terms & Authorized Signatory Block -->
      <div class="inv-legal-grid">
        <div class="terms-box">
          <div class="terms-title">Terms & Conditions:</div>
          <ol class="terms-list">
            <li>Goods once sold will not be taken back or exchanged without original cash memo/bill.</li>
            <li>Exchange applicable within 7 days from date of purchase in undamaged condition.</li>
            <li>Subject to local municipal and state jurisdiction.</li>
          </ol>
          <div class="declaration-text">
            "Certified that the particulars given above are true and correct and the amount indicated represents the price actually charged."
          </div>
        </div>

        <div class="sign-box">
          <div class="sign-company">For <%= company ? company.name : 'Grocery Store' %></div>
          <div class="sign-space"></div>
          <div class="sign-label">Authorized Signatory</div>
        </div>
      </div>

      <!-- Document Footer -->
      <div class="inv-doc-footer">
        <span>Generated: <%= new Date().toLocaleString('en-IN') %></span>
        <span>E. & O.E. &bull; Computer Generated Tax Invoice</span>
        <span>Powered by Billing ERP</span>
      </div>

    </div>


    <!-- ============================================================ -->
    <!-- VIEW 2: THERMAL POS 80MM RECEIPT -->
    <!-- ============================================================ -->
    <div class="thermal-receipt-view" id="thermalPosDoc">
      <div class="pos-center">
        <% if (company && company.logo_path) { %>
          <div style="margin-bottom: 8px;">
            <img src="<%= company.logo_path %>" alt="Logo" style="max-height: 40px; max-width: 140px; object-fit: contain; filter: grayscale(100%);">
          </div>
        <% } %>
        <div class="pos-title"><%= company ? company.name : 'GROCERY STORE' %></div>
