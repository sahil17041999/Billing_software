        <span>Discount:</span>
        <span>-&#8377;<%= discountAmount.toFixed(2) %></span>
      </div>
      <% } %>
      <div class="pos-flex">
        <span>Tax (GST):</span>
        <span>+&#8377;<%= taxAmount.toFixed(2) %></span>
      </div>

