  </style>
</head>
<body class="mode-a4">

  <%
    // Compute calculation variables
    const subtotal = Number(sale.total_amount || 0);
    const taxAmount = Number(sale.tax_amount || 0);
    const discountAmount = Number(sale.discount_amount || 0);
    const grandTotal = Number(sale.grand_total || 0);
    const items = sale.salesDetails || [];

    let totalQty = 0;
    let totalTaxableVal = 0;
    let totalLineDiscount = 0;
    const taxMap = {};

    items.forEach(function(item) {
      const q = Number(item.quantity || 0);
      totalQty += q;
      const unitPrice = Number(item.unit_price || 0);
      const disc = Number(item.discount_amount || 0);
      totalLineDiscount += disc;

      const taxObj = item.product && (item.product.tax || item.product.Tax);
      const taxRate = taxObj ? Number(taxObj.rate || 0) : 0;
      const taxAmt = Number(item.tax_amount || 0);
      const lineTot = Number(item.line_total || (unitPrice * q - disc + taxAmt));
      const taxable = (unitPrice * q) - disc;
      totalTaxableVal += taxable;

      const key = taxRate.toFixed(2);
      if (!taxMap[key]) {
        taxMap[key] = { rate: taxRate, taxable: 0, taxAmt: 0 };
      }
      taxMap[key].taxable += taxable;
      taxMap[key].taxAmt += taxAmt;
    });

    const isPaid = (sale.payment_status === 'paid');
    const paymentName = (payment && payment.paymentMode) ? payment.paymentMode.name : 'Cash / POS';
    const customerName = sale.customer ? sale.customer.name : 'Walk-in / Cash Customer';
    const customerPhone = sale.customer ? (sale.customer.phone || '') : '';
    const customerAddress = sale.customer ? (sale.customer.address || '') : '';
    const customerGstin = sale.customer ? (sale.customer.gstin || '') : '';
    
    // Safely resolve cashier display name
    let cashierName = 'Cashier';
    if (sale.cashier) {
      const parts = [sale.cashier.first_name, sale.cashier.last_name].filter(Boolean);
      cashierName = parts.length > 0 ? parts.join(' ') : (sale.cashier.username || 'Cashier');
    } else if (typeof user !== 'undefined' && user) {
      const parts = [user.first_name, user.last_name].filter(Boolean);
      cashierName = parts.length > 0 ? parts.join(' ') : (user.username || user.name || 'Cashier');
    }
  %>

  <!-- Screen Action Toolbar -->
  <div class="print-toolbar" id="printToolbar">
    <div class="toolbar-left">
      <a href="/admin/sales/" class="btn-back">&#8592; Back to Sales</a>
      <span class="toolbar-badge">
        <i class="ti ti-receipt"></i> #<%= sale.invoice_number %>
      </span>
      <span style="color: #94a3b8; font-size: 12px;">
        <%= new Date(sale.invoice_date).toLocaleDateString('en-IN', { day:'2-digit', month:'short', year:'numeric' }) %>
      </span>
    </div>

    <div class="toolbar-right">
      <!-- Layout Mode Selector -->
      <div class="view-toggle-group">
        <button type="button" class="toggle-btn active" id="btnModeA4" onclick="switchViewMode('a4')">
          <i class="ti ti-file-text"></i> Standard A4
        </button>
        <button type="button" class="toggle-btn" id="btnModeThermal" onclick="switchViewMode('thermal')">
          <i class="ti ti-printer"></i> 80mm POS Slip
        </button>
      </div>

      <!-- Copy Indicator Selector -->
      <select class="copy-select" id="copySelector" onchange="updateCopyTag(this.value)">
        <option value="ORIGINAL FOR RECIPIENT">Original (Buyer)</option>
        <option value="DUPLICATE FOR TRANSPORTER">Duplicate (Transporter)</option>
        <option value="TRIPLICATE FOR SUPPLIER">Triplicate (Supplier)</option>
        <option value="OFFICE COPY">Office Copy</option>
      </select>

      <!-- Email Invoice Button -->
      <button type="button" class="btn-email" onclick="promptEmailInvoice()">
        <i class="ti ti-mail"></i> Email
      </button>

      <!-- Print / PDF Button -->
      <button type="button" class="btn-print" onclick="window.print()">
        <i class="ti ti-printer"></i> Print Invoice
      </button>
    </div>
  </div>

  <div class="invoice-wrapper">

    <!-- ============================================================ -->
    <!-- VIEW 1: STANDARD A4 TAX INVOICE -->
    <!-- ============================================================ -->
    <div class="standard-a4-view" id="standardA4Doc">
      
      <!-- Top Title Header -->
      <div class="inv-top-bar">
        <div class="inv-title-main">TAX INVOICE</div>
        <div class="inv-copy-badge" id="displayCopyTag">ORIGINAL FOR RECIPIENT</div>
      </div>

      <!-- Seller Info & Invoice Metadata Grid -->
