        <% if (company && company.gstin) { %><div class="pos-sub">GSTIN: <%= company.gstin %></div><% } %>
        <div class="pos-divider"></div>
        <div class="pos-bold" style="font-size: 13px;">TAX INVOICE / CASH MEMO</div>
      </div>

      <div class="pos-divider"></div>

      <div class="pos-flex">
        <span>Bill No: <strong><%= sale.invoice_number %></strong></span>
