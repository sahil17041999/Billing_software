  // ==========================================================
  // OPTIONAL COUPON / PROMO CODE ENGINE
  // ==========================================================
  function applyPromoPreset(code) {
    const input = document.getElementById('promoCodeInput');
    if (input) input.value = code;
    applyPromoCode();
  }

  function applyPromoCode() {
    const input = document.getElementById('promoCodeInput');
    const code = input ? input.value.trim().toUpperCase() : '';
    const badge = document.getElementById('promoSuccessBadge');
    const currentCart = getCart();

    if (!code) {
      showToast('warning', 'Please enter a coupon code');
      return;
    }

    if (currentCart.length === 0) {
      PosAudio.error();
      showWarning('Empty Cart', 'Please add products to cart before applying coupon code.');
      return;
    }

    let subtotal = currentCart.reduce((sum, item) => sum + (item.quantity * item.unit_price), 0);
    let discount = 0;
    let desc = '';

    // Standard Preset Coupons & Dynamic Matcher
    switch (code) {
      case 'SAVE10':
      case 'DISCOUNT10':
        discount = (subtotal * 10) / 100;
        desc = '10% Discount Applied';
        break;
      case 'SUPER20':
      case 'SAVE20':
        discount = (subtotal * 20) / 100;
        desc = '20% Super Discount Applied';
        break;
      case 'FLAT50':
        discount = Math.min(subtotal, 50);
        desc = '₹50 Flat Off Applied';
        break;
      case 'FESTIVE100':
      case 'WELCOME100':
        discount = Math.min(subtotal, 100);
        desc = '₹100 Festive Off Applied';
        break;
      case 'FLAT200':
        discount = Math.min(subtotal, 200);
        desc = '₹200 Flat Off Applied';
        break;
      default:
        // Match patterns like SAVE15 or FLAT75
        const pctMatch = code.match(/^(?:SAVE|OFF|DISC)(\d{1,2})$/);
        const flatMatch = code.match(/^(?:FLAT|CASH)(\d{2,4})$/);
        if (pctMatch) {
          const pct = parseInt(pctMatch[1]);
          discount = (subtotal * pct) / 100;
          desc = `${pct}% Off Applied`;
        } else if (flatMatch) {
          const flat = parseInt(flatMatch[1]);
          discount = Math.min(subtotal, flat);
          desc = `₹${flat} Flat Off Applied`;
        } else {
          PosAudio.error();
          showToast('error', `Invalid coupon code "${code}". Try SAVE10, FLAT50, SUPER20 or FESTIVE100.`);
          return;
        }
    }

    const tab = getActiveTab();
    tab.promoCode = code;
    tab.promoDiscount = discount;

    PosAudio.beep();
    if (badge) {
      badge.style.display = 'flex';
      badge.innerHTML = `<span><i class="ti ti-circle-check"></i> ${desc} (-₹${discount.toFixed(2)})</span> <a href="javascript:void(0)" onclick="removePromoCode()" style="color:#ef4444; margin-left:auto; font-weight:800;" title="Remove Coupon">&times; Remove</a>`;
    }

    calculateTotals();
    showToast('success', `🎉 Coupon "${code}" Applied: ${desc}!`);
  }

  function removePromoCode() {
    const tab = getActiveTab();
    tab.promoCode = '';
    tab.promoDiscount = 0;
