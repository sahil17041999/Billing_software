    function openEmailInvoiceModal() {
      const email = document.getElementById('customerEmailInput').value;
      document.getElementById('emailModalRecipient').value = email || 'customer@example.com';
      openModal('emailInvoiceModal');
    }

    async function sendInvoiceEmail() {
      const email = document.getElementById('emailModalRecipient').value;
      if (!email) {
        Swal.fire({ icon: 'warning', title: 'Email Required', text: 'Please enter a recipient email address.' });
        return;
      }

      Swal.fire({
        title: 'Sending Invoice Email...',
        allowOutsideClick: false,
        didOpen: () => Swal.showLoading()
      });

      // Simulate sending email
      await new Promise(r => setTimeout(r, 600));

      closeModal('emailInvoiceModal');
      document.getElementById('emailedDateInput').value = new Date().toLocaleDateString('en-US');

      Swal.fire({
        icon: 'success',
        title: 'Invoice Emailed!',
        text: `The tax invoice has been emailed successfully to ${email}.`,
        confirmButtonColor: '#1366d9'
      });
    }

    // ----------------------------------------------------
    // SAVE & CLOSE SALE - WITH THOROUGH VALIDATIONS & PROPER STATUS
    // ----------------------------------------------------
    async function saveAndCloseSale() {
      // 0. Requirement: Without customer added, cannot create invoice
      if (!activeCustomer) {
        requireActiveCustomer('generate bill');
        return;
      }

      // 1. Requirement: Without product, cannot generate bill
      if (!lineItems || lineItems.length === 0) {
        $('#fastBarcodeInput').addClass('is-invalid');
        Swal.fire({
          icon: 'warning',
          title: 'Cart is Empty',
          text: 'Please add at least one product before generating the bill.',
          confirmButtonColor: '#2563eb',
          confirmButtonText: '<i class="ti ti-package"></i> Browse Products (F4)'
        }).then(() => {
          openProductCatalogModal();
        });
        return;
      } else {
        $('#fastBarcodeInput').removeClass('is-invalid');
      }

      // 2. Validate Item Quantities and Prices
      for (let i = 0; i < lineItems.length; i++) {
        const item = lineItems[i];
        if (!item.qty || isNaN(item.qty) || item.qty <= 0) {
          Swal.fire({
            icon: 'error',
            title: 'Invalid Item Quantity',
            text: `Item "${item.name || ('Item ' + (i + 1))}" has an invalid quantity (${item.qty}). Must be at least 1.`,
            confirmButtonColor: '#ef4444'
          });
          return;
        }
        if (isNaN(item.price) || item.price < 0) {
          Swal.fire({
            icon: 'error',
            title: 'Invalid Item Price',
            text: `Item "${item.name || ('Item ' + (i + 1))}" has an invalid price (₹${item.price}). Cannot be negative.`,
            confirmButtonColor: '#ef4444'
          });
          return;
        }
      }

      // 3. Validate Discount & Tax Rates
      const discInput = document.getElementById('discountRateInput');
      const discRate = parseFloat(discInput ? discInput.value : 0);
      if (isNaN(discRate) || discRate < 0 || discRate > 100) {
        $(discInput).addClass('is-invalid');
        Swal.fire({
          icon: 'error',
          title: 'Invalid Discount Rate',
          text: 'Discount rate must be a valid number between 0% and 100%.',
          confirmButtonColor: '#ef4444'
        });
        if (discInput) discInput.focus();
        return;
      } else if (discInput) {
        $(discInput).removeClass('is-invalid');
      }

      const taxInput = document.getElementById('taxRateInput');
      const taxRate = parseFloat(taxInput ? taxInput.value : 0);
      if (isNaN(taxRate) || taxRate < 0 || taxRate > 100) {
        $(taxInput).addClass('is-invalid');
        Swal.fire({
          icon: 'error',
          title: 'Invalid Tax Rate',
          text: 'GST Tax rate must be a valid number between 0% and 100%.',
          confirmButtonColor: '#ef4444'
        });
        if (taxInput) taxInput.focus();
        return;
      } else if (taxInput) {
        $(taxInput).removeClass('is-invalid');
      }

      // 4. Validate Customer Email if filled
      const emailInput = document.getElementById('customerEmailInput');
      if (emailInput && emailInput.value.trim()) {
        const emailVal = emailInput.value.trim();
        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!emailRegex.test(emailVal)) {
          $(emailInput).addClass('is-invalid');
          Swal.fire({
            icon: 'error',
            title: 'Invalid Customer Email',
            text: 'Please enter a valid email address (e.g. name@example.com) or leave it blank.',
            confirmButtonColor: '#ef4444'
          });
          emailInput.focus();
          return;
        } else {
          $(emailInput).removeClass('is-invalid');
        }
      }

      const invoiceNumber = document.getElementById('invoiceNumberInput').value;
      const subtotal = parseFloat(document.getElementById('subTotalDisplay').value.replace(/[^0-9.]/g, '')) || 0;
      const discountAmount = (subtotal * discRate) / 100;
      const paymentsInput = document.getElementById('paymentsInput');
      const payments = parseFloat(paymentsInput ? paymentsInput.value : 0) || 0;
      const custId = activeCustomer ? activeCustomer.id : null;
      const grandTotalStr = document.getElementById('invoiceTotalDisplay').value.replace(/[^0-9.]/g, '');
      const grandTotalNum = parseFloat(grandTotalStr) || 0;

      // 5. Validate Cash Tender
      if (activePaymentMode === 'CASH') {
        if (isNaN(payments) || payments < 0) {
          $(paymentsInput).addClass('is-invalid');
          Swal.fire({
            icon: 'error',
            title: 'Invalid Cash Amount',
            text: 'Please enter a valid received cash amount (cannot be negative).',
            confirmButtonColor: '#ef4444'
          });
          if (paymentsInput) paymentsInput.focus();
          return;
        } else if (paymentsInput) {
          $(paymentsInput).removeClass('is-invalid');
        }
      }

      // 6. DISPLAY CONFIRMATION DIALOG BEFORE GENERATING BILL
      const totalUnits = lineItems.reduce((acc, it) => acc + Number(it.qty || 1), 0);
      const customerName = activeCustomer ? activeCustomer.name : (document.getElementById('soldToName').value || 'Walk-in Customer');
      const changeAmt = activePaymentMode === 'CASH' && payments > grandTotalNum ? (payments - grandTotalNum) : 0;
      const dueAmt = activePaymentMode === 'CASH' && payments < grandTotalNum ? (grandTotalNum - payments) : (activePaymentMode === 'CREDIT' ? grandTotalNum : 0);

      const confirmResult = await Swal.fire({
        title: 'Confirm Bill Generation',
        html: `
          <div style="text-align: left; background: #f8fafc; border: 1.5px solid #cbd5e1; border-radius: 12px; padding: 16px 18px; margin-top: 10px; font-size: 13.5px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; border-bottom: 1px solid #e2e8f0; padding-bottom: 6px;">
              <span style="color: #64748b; font-weight: 600;">Customer:</span>
              <strong style="color: #0f172a; font-size: 14px;">${escapeHtml(customerName)}</strong>
            </div>
            <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
              <span style="color: #64748b; font-weight: 600;">Total Items:</span>
              <strong>${lineItems.length} lines (${totalUnits} pcs)</strong>
            </div>
            <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
              <span style="color: #64748b; font-weight: 600;">Payment Mode:</span>
              <span class="badge-modern primary" style="font-size: 11px; font-weight: 800; text-transform: uppercase;">${activePaymentMode || 'CASH'}</span>
            </div>
            ${activePaymentMode === 'CASH' ? `
            <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
              <span style="color: #64748b; font-weight: 600;">Cash Received:</span>
              <strong style="color: #0f172a; font-family: monospace;">₹${payments.toFixed(2)}</strong>
            </div>
            ${changeAmt > 0 ? `
            <div style="display: flex; justify-content: space-between; margin-bottom: 8px; background: #ecfdf5; padding: 6px 10px; border-radius: 6px; border: 1px solid #a7f3d0;">
              <span style="color: #065f46; font-weight: 700;">Change to Return:</span>
              <strong style="color: #059669; font-size: 15px; font-family: monospace;">₹${changeAmt.toFixed(2)}</strong>
            </div>` : ''}
            ${dueAmt > 0 ? `
            <div style="display: flex; justify-content: space-between; margin-bottom: 8px; background: #fffbeb; padding: 6px 10px; border-radius: 6px; border: 1px solid #fde68a;">
              <span style="color: #b45309; font-weight: 700;">Due Balance:</span>
              <strong style="color: #b45309; font-size: 15px; font-family: monospace;">₹${dueAmt.toFixed(2)}</strong>
            </div>` : ''}
            ` : ''}
            <div style="display: flex; justify-content: space-between; align-items: center; border-top: 2px dashed #cbd5e1; padding-top: 10px; margin-top: 10px;">
              <span style="font-weight: 800; font-size: 15px; color: #0f172a;">TOTAL PAYABLE:</span>
              <strong style="color: #10b981; font-weight: 900; font-size: 24px; font-family: monospace;">₹${grandTotalNum.toFixed(2)}</strong>
            </div>
          </div>
          <div style="margin-top: 12px; font-size: 13px; color: #64748b; text-align: center;">
            Click <strong>"Yes, Generate Bill"</strong> to record transaction &amp; print bill.
          </div>
        `,
        icon: 'question',
        showCancelButton: true,
        confirmButtonText: '<i class="ti ti-check"></i> Yes, Generate Bill',
        cancelButtonText: '<i class="ti ti-x"></i> Cancel / Review',
        confirmButtonColor: '#10b981',
        cancelButtonColor: '#64748b',
        focusConfirm: true,
        reverseButtons: true
      });

      if (!confirmResult.isConfirmed) {
        showToast('Bill generation cancelled', 'info');
        return;
      }

      // Sync Payment Mode dropdown
      const pmSelect = document.getElementById('payment_mode_id');
      const paymentModeId = pmSelect && pmSelect.value ? pmSelect.value : null;

      const payload = {
        customer_id: custId,
        payment_mode_id: paymentModeId ? Number(paymentModeId) : null,
        discount_amount: discountAmount,
        notes: document.getElementById('invoiceCommentsInput').value || null,
        items: lineItems.map(item => ({
          product_id: item.id || null,
          name: item.name,
          quantity: item.qty,
          unit_price: item.price,
          tax_rate: item.taxRate || 10,
          discount_amount: 0,
          discount_percent: 0
        }))
      };

      // 7. Show Sleek Loading Message While Creating Invoice
      Swal.fire({
        title: 'Creating Tax Invoice...',
        html: `
          <div style="padding: 10px 0; text-align: center;">
            <div style="font-size: 14px; font-weight: 600; color: #1e293b; margin-bottom: 4px;">Recording sale and syncing stock ledger...</div>
            <div style="font-size: 12px; color: #64748b;">Please wait while the invoice is finalized.</div>
          </div>
        `,
        allowOutsideClick: false,
        allowEscapeKey: false,
        didOpen: () => {
          Swal.showLoading();
        }
      });

      try {
        const response = await fetch('/admin/sales', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify(payload)
        });

        const result = await response.json();
        if (!response.ok || !result.success) {
          throw new Error(result.error || 'Failed to record invoice on server.');
        }

        const generatedInvoiceNum = result.invoice_number || invoiceNumber;
        const finalGrandTotal = result.grand_total ? `₹${Number(result.grand_total).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}` : `₹${grandTotalNum.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
        const totalQty = lineItems.reduce((acc, it) => acc + Number(it.qty || 1), 0);
        const changeAmt = activePaymentMode === 'CASH' && payments > grandTotalNum ? (payments - grandTotalNum) : 0;
        const customerName = activeCustomer ? activeCustomer.name : 'Walk-in Customer';

        // 5. Display Proper Rich Success Confirmation
        Swal.fire({
          icon: 'success',
          title: '🎉 Bill Created Successfully!',
          html: `
            <div style="text-align: left; background: #f8fafc; padding: 16px 20px; border-radius: 12px; border: 1.5px solid #e2e8f0; margin-top: 12px; font-size: 13.5px;">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; padding-bottom: 8px; border-bottom: 1px solid #e2e8f0;">
                <span style="color: #64748b; font-weight: 600;">Invoice Number:</span>
                <span style="background: #eff6ff; color: #1d4ed8; font-weight: 800; font-family: monospace; font-size: 15px; padding: 3px 10px; border-radius: 6px; border: 1px solid #bfdbfe;">#${generatedInvoiceNum}</span>
              </div>
              <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
                <span style="color: #64748b; font-weight: 600;">Customer:</span>
                <strong style="color: #0f172a;">${escapeHtml(customerName)}</strong>
              </div>
              <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
                <span style="color: #64748b; font-weight: 600;">Payment Mode:</span>
                <span class="badge-modern primary" style="font-size: 11.5px; font-weight: 800; text-transform: uppercase;">${activePaymentMode || 'CASH'}</span>
              </div>
              <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
                <span style="color: #64748b; font-weight: 600;">Items Billed:</span>
                <strong>${lineItems.length} lines (${totalQty} pcs)</strong>
              </div>
              ${changeAmt > 0 ? `
              <div style="display: flex; justify-content: space-between; margin-bottom: 8px; background: #ecfdf5; padding: 6px 10px; border-radius: 6px; border: 1px solid #a7f3d0;">
                <span style="color: #065f46; font-weight: 700;">Change Returned:</span>
                <strong style="color: #059669; font-size: 15px; font-family: monospace;">₹${changeAmt.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</strong>
              </div>` : ''}
              <div style="display: flex; justify-content: space-between; align-items: center; border-top: 2px dashed #cbd5e1; padding-top: 10px; margin-top: 10px;">
                <span style="font-weight: 800; font-size: 16px; color: #0f172a;">Grand Total:</span>
                <strong style="color: #059669; font-weight: 900; font-size: 22px; font-family: monospace;">${finalGrandTotal}</strong>
              </div>
            </div>
            ${result.sale_id ? `
            <div style="margin-top: 12px; text-align: center;">
              <a href="/admin/sales/invoice/${result.sale_id}" target="_blank" style="color: #2563eb; font-size: 12.5px; font-weight: 700; text-decoration: none; display: inline-flex; align-items: center; gap: 4px;">
                <i class="ti ti-external-link"></i> Open Full Invoice Page (#${generatedInvoiceNum})
              </a>
            </div>` : ''}
          `,
          showCancelButton: true,
          confirmButtonText: '<i class="ti ti-printer"></i> Print Bill Now',
          cancelButtonText: '➕ Next Customer (New Bill)',
          confirmButtonColor: '#10b981',
          cancelButtonColor: '#1366d9',
          reverseButtons: true
        }).then((action) => {
          const targetSaleObj = {
            id: result.sale_id,
            invoice_number: generatedInvoiceNum,
            customer: activeCustomer ? { ...activeCustomer } : { name: customerName },
            items: [...lineItems]
          };
          if (action.isConfirmed) {
            openInvoicePreviewModal(targetSaleObj);
          }
          resetInvoiceTerminal();
        });

      } catch (err) {
        Swal.fire({
          icon: 'error',
          title: 'Invoice Creation Failed',
          html: `
            <div style="color: #b91c1c; font-size: 14px; padding: 10px; font-weight: 600;">
              ${escapeHtml(err.message || 'An unexpected error occurred while saving invoice.')}
            </div>
          `,
          confirmButtonColor: '#ef4444',
          confirmButtonText: 'OK'
        });
      }
    }

    function resetInvoiceTerminal() {
      lineItems = [];
      selectedRowIndex = 0;
      activeCustomer = null; // No default customer
      document.getElementById('paymentsInput').value = '0.00';
      document.getElementById('discountRateInput').value = '0.00';
      document.getElementById('soldToName').value = '';
      document.getElementById('custCodeInput').value = '';
      document.getElementById('soldToAddress').value = '';
      document.getElementById('customerEmailInput').value = '';
      const custSelect = document.getElementById('customer_id');
      if (custSelect) custSelect.value = '';

      selectPaymentMode('CASH', document.getElementById('btnPayCash'));
      renderGrid();
      recalculateTotals();
      updateCustomerUI();

      const barcodeInput = document.getElementById('fastBarcodeInput');
      if (barcodeInput) {
        barcodeInput.value = '';
      }
      showToast('New bill ready: Select customer to start', 'info');
    }

    function openModal(id) {
      const el = document.getElementById(id);
      if (el) el.style.display = 'flex';
    }

    function closeModal(id) {
      const el = document.getElementById(id);
      if (el) el.style.display = 'none';
    }

    function showToast(msg, icon = 'info') {
      if (typeof Swal !== 'undefined' && typeof Swal.fire === 'function') {
        Swal.fire({
          toast: true,
          position: 'top-end',
          icon: icon,
          title: msg,
          showConfirmButton: false,
          timer: 2000,
          timerProgressBar: true
        });
      } else {
        alert(msg);
      }
    }

    // ----------------------------------------------------
    // KEYBOARD NAVIGATION & SHORTCUTS
    // ----------------------------------------------------
    document.addEventListener('keydown', (e) => {
      if (e.key === 'F1') {
        e.preventDefault();
        selectPaymentMode('CASH', document.getElementById('btnPayCash'));
        return;
      }
      if (e.key === 'F2' || ((e.ctrlKey || e.metaKey) && e.key === 'Enter')) {
        e.preventDefault();
        saveAndCloseSale();
        return;
      }
      if (e.key === 'F3') {
        e.preventDefault();
        openProductScanModal();
        return;
      }
      if (e.key === 'F4') {
        e.preventDefault();
        openProductCatalogModal();
        return;
      }
      if (e.key === 'F6') {
        e.preventDefault();
        openAddNewProductModal();
        return;
      }
      if (e.key === 'F8') {
        e.preventDefault();
        openPosCustomerModal();
        return;
      }
      if (e.key === 'ArrowUp' && !$('input:focus, textarea:focus, select:focus').length) {
        e.preventDefault();
        if (selectedRowIndex > 0) {
          selectRow(selectedRowIndex - 1);
        }
        return;
      }
      if (e.key === 'ArrowDown' && !$('input:focus, textarea:focus, select:focus').length) {
        e.preventDefault();
        if (selectedRowIndex < lineItems.length - 1) {
          selectRow(selectedRowIndex + 1);
        }
        return;
      }
      if (e.key === 'Escape') {
        if (typeof stopCameraScanning === 'function') stopCameraScanning();
        document.querySelectorAll('.modal').forEach(m => { m.style.display = 'none'; });
      }
    });

    // Auto-scan from URL query parameter (e.g. /admin/sales/pos?scan=890123456789)
    window.addEventListener('DOMContentLoaded', () => {
      const urlParams = new URLSearchParams(window.location.search);
      const codeToScan = urlParams.get('scan') || urlParams.get('barcode');
      if (codeToScan) {
        setTimeout(() => {
          if (!activeCustomer && typeof selectCustomer === 'function') {
            const defCust = (serverCustomers && serverCustomers.length) ? serverCustomers[0] : null;
            if (defCust) {
              selectCustomer(String(defCust.id), defCust.name, defCust.phone || '9999999999');
            } else {
              selectCustomer('1', 'Walk-in Customer', '9999999999');
            }
          }
          processSingleBarcodeScan(codeToScan, 1);
        }, 600);
      }
    });

    function escapeHtml(str) {
      return String(str || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }
  </script>
</body>
</html>