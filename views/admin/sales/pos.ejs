  function calculateTotals() {
    const currentCart = getCart();
    let subtotal = 0;
    let taxTotal = 0;

    currentCart.forEach(item => {
      const lineTotal = item.quantity * item.unit_price;
      const taxAmount = (lineTotal * item.tax_rate) / 100;
      subtotal += lineTotal;
      taxTotal += taxAmount;
    });

    const discountInput = document.getElementById('discountInput');
    const discountType = document.getElementById('discountType').value;
    let rawDiscount = Number(discountInput ? discountInput.value : 0) || 0;
    if (rawDiscount < 0) rawDiscount = 0;

    let discountAmount = rawDiscount;
    if (discountType === 'percent') {
      discountAmount = ((subtotal + taxTotal) * rawDiscount) / 100;
    }

    const tab = getActiveTab();
    const promoDisc = tab.promoDiscount || 0;
    discountAmount += promoDisc;

    // Additional Level 4 Charges
    const delivery = Number(document.getElementById('extraDeliveryCharge')?.value) || 0;
    const packaging = Number(document.getElementById('extraPackagingCharge')?.value) || 0;
    const totalExtra = delivery + packaging;

    tab.deliveryCharge = delivery;
    tab.packagingCharge = packaging;

    const extraRow = document.getElementById('additionalChargesRow');
    if (extraRow) {
      if (totalExtra > 0) {
        extraRow.style.display = 'flex';
        document.getElementById('additionalChargesTotal').textContent = '₹' + totalExtra.toFixed(2);
      } else {
        extraRow.style.display = 'none';
      }
    }

    const maxDiscount = subtotal + taxTotal;
    if (discountAmount > maxDiscount) discountAmount = maxDiscount;

    let rawNet = Math.max(0, subtotal + taxTotal + totalExtra - discountAmount);
    let finalPayable = rawNet;
    let roundOffDiff = 0;

    const roundOffCheck = document.getElementById('autoRoundOffCheck');
    if (roundOffCheck && roundOffCheck.checked) {
      finalPayable = Math.round(rawNet);
      roundOffDiff = finalPayable - rawNet;
    }

    const roundOffRow = document.getElementById('roundOffRow');
    if (roundOffRow) {
      if (Math.abs(roundOffDiff) > 0.001) {
        roundOffRow.style.display = 'flex';
        document.getElementById('roundOffValue').textContent = (roundOffDiff > 0 ? '+₹' : '-₹') + Math.abs(roundOffDiff).toFixed(2);
      } else {
        roundOffRow.style.display = 'none';
      }
    }

    document.getElementById('subtotal').textContent = '₹' + subtotal.toFixed(2);
    document.getElementById('taxTotal').textContent = '₹' + taxTotal.toFixed(2);
    document.getElementById('grandTotal').textContent = '₹' + finalPayable.toFixed(2);

    const bCartTotal = document.getElementById('bottomCartTotal');
    if (bCartTotal) bCartTotal.textContent = '₹' + finalPayable.toFixed(2);

    tab.discount = rawDiscount;
    tab.discountType = discountType;

    calcChange();
  }


  function setTender(val) {
    const grandTotalStr = document.getElementById('grandTotal').textContent.replace('₹', '');
    const grandTotal = Number(grandTotalStr) || 0;
    const input = document.getElementById('tenderAmount');

    if (val === 'exact') {
      input.value = Math.ceil(grandTotal);
    } else {
      const current = Number(input.value) || 0;
      input.value = current + Number(val);
    }
    calcChange();
  }

  function calcChange() {
    const grandTotalStr = document.getElementById('grandTotal').textContent.replace('₹', '');
    const grandTotal = Number(grandTotalStr) || 0;
    const tenderVal = Number(document.getElementById('tenderAmount').value) || 0;
    const changeEl = document.getElementById('changeReturn');

    if (tenderVal >= grandTotal && grandTotal > 0) {
      const diff = tenderVal - grandTotal;
      changeEl.textContent = '₹' + diff.toFixed(2);
      changeEl.style.color = '#059669';
    } else {
      changeEl.textContent = '₹0.00';
      changeEl.style.color = '#64748b';
    }
  }

