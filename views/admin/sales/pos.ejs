    // ----------------------------------------------------
    // CALCULATOR LOGIC
    // ----------------------------------------------------
    let calcCurrent = '0';
    let calcPrev = null;
    let calcPendingOp = null;

    function openCalculatorModal() {
      openModal('desktopCalculatorModal');
    }

    function updateCalcDisplay() {
      document.getElementById('calcDisplay').textContent = calcCurrent;
    }

    function calcNum(d) {
      if (calcCurrent === '0' && d !== '.') {
        calcCurrent = d;
      } else if (d === '.' && calcCurrent.includes('.')) {
        return;
      } else {
        calcCurrent += d;
      }
      updateCalcDisplay();
    }

    function calcClear() {
      calcCurrent = '0';
      calcPrev = null;
      calcPendingOp = null;
      updateCalcDisplay();
    }

    function calcBackspace() {
      if (calcCurrent.length > 1) {
        calcCurrent = calcCurrent.slice(0, -1);
      } else {
        calcCurrent = '0';
      }
      updateCalcDisplay();
    }

    function calcOp(op) {
      calcPrev = parseFloat(calcCurrent);
      calcPendingOp = op;
      calcCurrent = '0';
      updateCalcDisplay();
    }

    function calcPercent() {
      calcCurrent = String(parseFloat(calcCurrent) / 100);
      updateCalcDisplay();
    }

    function calcEquals() {
      if (calcPendingOp && calcPrev !== null) {
        const cur = parseFloat(calcCurrent);
        let res = 0;
        if (calcPendingOp === '+') res = calcPrev + cur;
        else if (calcPendingOp === '-') res = calcPrev - cur;
        else if (calcPendingOp === '*') res = calcPrev * cur;
        else if (calcPendingOp === '/') res = cur !== 0 ? calcPrev / cur : 0;
        calcCurrent = String(Math.round(res * 1000) / 1000);
        calcPrev = null;
        calcPendingOp = null;
        updateCalcDisplay();
      }
    }

    function pasteCalcResult(target) {
      const val = parseFloat(calcCurrent);
      if (target === 'payments') {
        document.getElementById('paymentsInput').value = val.toFixed(2);
      } else if (target === 'discount') {
        document.getElementById('discountRateInput').value = val.toFixed(2);
      }
      recalculateTotals();
      closeModal('desktopCalculatorModal');
      showToast(`Pasted ₹${val.toFixed(2)} to ${target}`, 'info');
    }

