        </div>
      </div>
    </div>
  </div>

  <!-- 10. EMAIL INVOICE MODAL -->
  <div class="modal fade" id="emailInvoiceModal" tabindex="-1" style="display: none; background: rgba(15,23,42,0.6); position: fixed; inset: 0; z-index: 1060; align-items: center; justify-content: center;">
    <div class="modal-dialog" style="max-width: 480px; width: 100%; margin: 20px;">
      <div class="modal-content" style="background: #fff; border-radius: var(--radius-md); box-shadow: var(--shadow-xl); overflow: hidden;">
        <div class="modal-header" style="background: #f8fafc; border-bottom: 1px solid var(--border-color); padding: 12px 18px; display: flex; align-items: center; justify-content: space-between;">
          <h5 style="margin: 0; font-size: 15px; font-weight: 800;"><i class="ti ti-mail" style="color: var(--primary);"></i> Email Invoice to Customer</h5>
          <button type="button" class="btn-close" onclick="closeModal('emailInvoiceModal')" style="border: none; background: transparent; font-size: 18px; cursor: pointer;">&times;</button>
        </div>
        <div class="modal-body" style="padding: 16px; display: flex; flex-direction: column; gap: 10px;">
          <div>
            <label style="font-size: 12px; font-weight: 700; color: var(--text-muted);">Recipient Email:</label>
            <input type="email" id="emailModalRecipient" class="form-control-modern" />
          </div>
          <div>
            <label style="font-size: 12px; font-weight: 700; color: var(--text-muted);">Subject:</label>
            <input type="text" id="emailModalSubject" class="form-control-modern" value="Invoice from <%= (company && company.name) || 'Company' %>" />
          </div>
          <div>
            <label style="font-size: 12px; font-weight: 700; color: var(--text-muted);">Message:</label>
            <textarea id="emailModalMessage" class="form-control-modern" style="height: 75px; resize: none;">Dear Customer, please find attached the invoice for your recent purchase. Thank you for your business!</textarea>
          </div>
        </div>
        <div class="modal-footer" style="background: #f8fafc; border-top: 1px solid var(--border-color); padding: 10px 18px; display: flex; justify-content: flex-end; gap: 8px;">
          <button type="button" class="btn-modern btn-primary-modern" onclick="sendInvoiceEmail()">Send Email</button>
          <button type="button" class="btn-modern btn-secondary-modern" onclick="closeModal('emailInvoiceModal')">Cancel</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Hidden Customer Selector for backward test compatibility -->
  <select id="customer_id" class="pos-hidden-compat">
    <option value="">Walk-in Customer</option>
    <% (customers || []).forEach(c => { %>
      <option value="<%= c.id %>"><%= c.name %> - <%= c.phone || '' %></option>
    <% }) %>
  </select>

  <!-- =========================================================================
       JAVASCRIPT ENGINE: JQUERY VALIDATIONS + ADVANCED POS SUITE
       ========================================================================= -->
  <script>
    const serverProducts = <%- JSON.stringify(products || []) %>;
    const serverCustomers = <%- JSON.stringify(customers || []) %>;
    const serverCompany = <%- JSON.stringify(company || {}) %>;
    const initialInvoiceNumber = <%- JSON.stringify(nextInvoiceNumber || 'INV#000001') %>;

    let selectedRowIndex = 0;
    // Default cart is empty for fast fresh billing
    let lineItems = [];
    let heldBills = [];
    let activeCustomer = null; // No default customer added on start

    $(document).ready(function() {
      // ----------------------------------------------------
      // 1. SETUP JQUERY VALIDATOR CUSTOM METHODS
      // ----------------------------------------------------
      if ($.validator) {
        // Indian Mobile
        if (!$.validator.methods.phoneIN) {
          $.validator.addMethod('phoneIN', function(value, element) {
            return this.optional(element) || /^[6-9]\d{9}$/.test(String(value).trim().replace(/[\s-]/g, ''));
          }, 'Please enter a valid 10-digit Indian mobile number (starts with 6, 7, 8, or 9).');
        }

        // Indian GSTIN format
        if (!$.validator.methods.gstin) {
          $.validator.addMethod('gstin', function(value, element) {
            return this.optional(element) || /^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1}$/i.test(String(value).trim());
          }, 'Please enter a valid 15-character GSTIN (e.g. 27AAPFU0939F1ZV).');
        }

        // 6-digit Pincode
        if (!$.validator.methods.pincode) {
          $.validator.addMethod('pincode', function(value, element) {
            return this.optional(element) || /^\d{6}$/.test(String(value).trim());
          }, 'Please enter a valid 6-digit postal code.');
        }

        // Greater Than Zero
        if (!$.validator.methods.greaterThanZero) {
          $.validator.addMethod('greaterThanZero', function(value, element) {
            return this.optional(element) || (parseFloat(value) > 0);
          }, 'Value must be greater than zero.');
        }

        // ----------------------------------------------------
        // 2. INITIALIZE JQUERY VALIDATE: NEW CUSTOMER FORM
        // ----------------------------------------------------
        $('#newCustomerForm').validate({
          errorElement: 'span',
          errorClass: 'invalid-feedback-custom',
          highlight: function(element) {
            $(element).addClass('is-invalid').removeClass('is-valid');
          },
          unhighlight: function(element) {
            $(element).removeClass('is-invalid').addClass('is-valid');
          },
          rules: {
            name: { required: true, minlength: 2 },
            phone: { phoneIN: true },
            email: { email: true },
            gstin: { gstin: true },
            postal_code: { pincode: true }
          },
          messages: {
            name: {
              required: 'Customer name is required',
              minlength: 'Customer name must have at least 2 characters'
            }
          },
          errorPlacement: function(error, element) {
            error.insertAfter(element);
          },
          submitHandler: function(form) {
            executeCustomerSave();
            return false;
          }
        });

        // ----------------------------------------------------
        // 3. INITIALIZE JQUERY VALIDATE: NEW PRODUCT FORM
        // ----------------------------------------------------
        $('#newProductForm').validate({
          errorElement: 'span',
          errorClass: 'invalid-feedback-custom',
          highlight: function(element) {
            $(element).addClass('is-invalid').removeClass('is-valid');
          },
          unhighlight: function(element) {
            $(element).removeClass('is-invalid').addClass('is-valid');
          },
          rules: {
            name: { required: true, minlength: 2 },
            selling_price: { required: true, number: true, min: 0.01 },
            cost_price: { number: true, min: 0 },
            tax_rate: { number: true, min: 0, max: 100 }
          },
          messages: {
            name: {
              required: 'Product name is mandatory',
              minlength: 'Name must be at least 2 characters'
            },
            selling_price: {
              required: 'Selling price is mandatory',
              min: 'Selling price must be greater than ₹0'
            }
          },
          errorPlacement: function(error, element) {
            error.insertAfter(element);
          },
          submitHandler: function(form) {
            executeProductSave();
            return false;
          }
        });

        // ----------------------------------------------------
        // 4. INITIALIZE JQUERY VALIDATE: EDIT LINE ITEM FORM
        // ----------------------------------------------------
        $('#editLineForm').validate({
          errorElement: 'span',
          errorClass: 'invalid-feedback-custom',
          highlight: function(element) {
            $(element).addClass('is-invalid').removeClass('is-valid');
          },
          unhighlight: function(element) {
            $(element).removeClass('is-invalid').addClass('is-valid');
          },
          rules: {
            name: { required: true, minlength: 1 },
            qty: { required: true, digits: true, min: 1 },
            price: { required: true, number: true, min: 0 },
            taxRate: { number: true, min: 0, max: 100 }
          },
          messages: {
            name: 'Item name is required',
            qty: 'Quantity must be at least 1 unit',
            price: 'Price must be 0 or higher'
          },
          errorPlacement: function(error, element) {
            error.insertAfter(element);
          },
          submitHandler: function(form) {
            executeSaveEditedLine();
            return false;
          }
        });
      }

      // Initialize POS in fresh state with no default customer
      calculateDueDate();
      renderGrid();
      recalculateTotals();
      updateCustomerUI();
    });

    function toggleMaximize() {
      const frame = document.getElementById('invoiceMainFrame');
      frame.classList.toggle('fullscreen');
    }

    // ----------------------------------------------------
    // CUSTOMER STATE & JQUERY VALIDATIONS
    // ----------------------------------------------------
    function updateCustomerUI() {
      const custPill = document.getElementById('posCustomerPill');
      const custDisplay = document.getElementById('custNameDisplay');
      const custIcon = document.getElementById('custPillIcon');

      if (!activeCustomer) {
        if (custPill) custPill.classList.add('empty');
        if (custIcon) custIcon.className = 'ti ti-user';
        if (custDisplay) custDisplay.innerHTML = '<span style="color: #ea580c; font-weight: 700;">Select Customer</span>';
      } else {
        if (custPill) {
          custPill.classList.remove('empty', 'is-invalid');
        }
        if (custIcon) custIcon.className = 'ti ti-user-check';
        if (custDisplay) custDisplay.innerHTML = `<span style="color: #16a34a; font-weight: 700;"><i class="ti ti-check"></i> ${escapeHtml(activeCustomer.name)}</span>`;
      }
    }

    // Validation: Without customer, do not add product
    function requireActiveCustomer(actionDescription = 'add products') {
      if (!activeCustomer) {
        const custPill = document.getElementById('posCustomerPill');
        if (custPill) {
          custPill.classList.add('is-invalid');
          setTimeout(() => { if (custPill) custPill.classList.remove('is-invalid'); }, 2000);
        }

        Swal.fire({
          icon: 'warning',
          title: 'Customer Required',
          text: 'Please select a customer first before adding products.',
          confirmButtonColor: '#2563eb',
          confirmButtonText: '<i class="ti ti-user-check"></i> Select Customer (F8)',
          showCancelButton: true,
          cancelButtonText: 'Cancel'
        }).then((res) => {
          if (res.isConfirmed) {
            openPosCustomerModal();
          }
        });
        return false;
      }
      return true;
    }

    function focusBarcodeScanner() {
      if (!requireActiveCustomer('scan products')) return;
      const bInput = document.getElementById('fastBarcodeInput');
      if (bInput) {
        bInput.focus();
        bInput.select();
      }
    }

    function setCustomer(cust) {
      activeCustomer = cust;
      document.getElementById('custCodeInput').value = String(cust.id || 1).padStart(8, '0');
      document.getElementById('soldToName').value = cust.name || '';
      
      const addr = [];
      if (cust.address) addr.push(cust.address);
      if (cust.city || cust.postal_code) addr.push(`${cust.city || ''} ${cust.postal_code || ''}`.trim());
      if (cust.phone) addr.push(`Phone: ${cust.phone}`);
      
      document.getElementById('soldToAddress').value = addr.join('\n');
      if (cust.email) {
        document.getElementById('customerEmailInput').value = cust.email;
      }
      const custSelect = document.getElementById('customer_id');
      if (custSelect) custSelect.value = cust.id || '';

      updateCustomerUI();
      
      const barcodeInput = document.getElementById('fastBarcodeInput');
      if (barcodeInput) {
        barcodeInput.focus();
      }
    }

    function syncCustomerData() {
      const custSelect = document.getElementById('customer_id');
      if (!activeCustomer && custSelect) {
        custSelect.value = '';
      }
    }

    function copySoldToShip() {
      document.getElementById('shipToName').value = document.getElementById('soldToName').value;
      document.getElementById('shipToAddress').value = document.getElementById('soldToAddress').value;
      showToast('Copied Sold to details to Ship to', 'success');
    }

    function onCustCodeChange() {
      const val = document.getElementById('custCodeInput').value.trim();
      const num = parseInt(val, 10);
      if (!isNaN(num) && serverCustomers) {
        const match = serverCustomers.find(c => c.id === num);
        if (match) setCustomer(match);
      }
    }

    function calculateDueDate() {
      const dateVal = document.getElementById('invoiceDateInput').value;
      const terms = document.getElementById('paymentTermsSelect').value;
      const baseDate = dateVal ? new Date(dateVal) : new Date();

      let days = 10;
      if (terms === 'NET15') days = 15;
      else if (terms === 'NET30') days = 30;
      else if (terms === 'NET60') days = 60;
      else if (terms === 'RECEIPT' || terms === 'CASH') days = 0;

      const dueDate = new Date(baseDate.getTime() + days * 24 * 60 * 60 * 1000);
      document.getElementById('invoiceDueDateInput').value = dueDate.toISOString().split('T')[0];
    }

    function renderGrid() {
      const tbody = document.getElementById('itemsTableBody');
      tbody.innerHTML = '';
      document.getElementById('lineCountDisplay').textContent = lineItems.length;

      if (lineItems.length === 0) {
        tbody.innerHTML = `
          <tr>
            <td colspan="8" style="text-align: center; padding: 48px 16px; color: #94a3b8;">
              <i class="ti ti-shopping-cart-x" style="font-size: 38px; display: block; margin-bottom: 8px; color: #cbd5e1;"></i>
              <div style="font-size: 15px; font-weight: 700; color: #64748b;">Cart is empty</div>
              <div style="font-size: 12px; margin-top: 4px;">Scan a barcode above or press <kbd style="background:#e2e8f0; padding:1px 5px; border-radius:4px;">F4</kbd> to pick from catalog.</div>
            </td>
          </tr>
        `;
        return;
      }

      lineItems.forEach((item, index) => {
        const tr = document.createElement('tr');
        if (index === selectedRowIndex) tr.classList.add('selected');
        tr.onclick = () => selectRow(index);
        tr.ondblclick = () => editSelectedLine();

        const lineTotal = (item.qty * item.price);

        tr.innerHTML = `
          <td class="col-ind col-indicator" style="text-align: center; color: var(--primary); font-weight: bold; font-size: 12px;">${index + 1}</td>
          <td class="col-sku"><span class="badge-modern secondary" style="font-family: var(--font-mono); font-size: 11px;">${escapeHtml(item.sku || 'SKU')}</span></td>
          <td class="col-desc">
            <div class="item-desc-cell">
              <span class="item-title">${escapeHtml(item.name || 'Description')}</span>
              ${item.barcode ? `<span class="item-subtext">Barcode: ${escapeHtml(item.barcode)}</span>` : ''}
            </div>
          </td>
          <td class="col-pr" style="text-align: right; font-family: var(--font-mono); font-weight: 700;">
            ₹${Number(item.price).toFixed(2)}
          </td>
          <td class="col-q" style="text-align: center;">
            <div class="qty-stepper-wrap" onclick="event.stopPropagation();">
              <button type="button" class="btn-qty-step" onclick="stepRowQty(${index}, -1)" title="Decrease Quantity">−</button>
              <input type="number" min="1" step="1" class="qty-cell-input" value="${item.qty}" onchange="updateRowQty(${index}, this.value)" />
              <button type="button" class="btn-qty-step" onclick="stepRowQty(${index}, 1)" title="Increase Quantity">+</button>
            </div>
          </td>
          <td class="col-tx" style="text-align: center;"><span class="badge-modern ${item.taxable === 'N' ? 'secondary' : 'success'}" style="font-size: 10px;">${item.taxable === 'N' ? 'EXEMPT' : 'GST'}</span></td>
          <td class="col-tot" style="text-align: right; font-weight: 800; font-family: var(--font-mono); color: #0f172a;">₹${lineTotal.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</td>
          <td style="text-align: center;">
            <button type="button" class="btn-del-row" onclick="event.stopPropagation(); deleteLineAt(${index});" title="Remove item">
              <i class="ti ti-trash"></i>
            </button>
          </td>
        `;
        tbody.appendChild(tr);
      });
    }

    function stepRowQty(index, delta) {
      if (lineItems[index]) {
        const newQty = (lineItems[index].qty || 1) + delta;
        if (newQty <= 0) {
          deleteLineAt(index);
        } else {
          lineItems[index].qty = newQty;
          recalculateTotals();
          renderGrid();
        }
      }
    }

    function deleteLineAt(index) {
      if (lineItems[index]) {
        const name = lineItems[index].name;
        lineItems.splice(index, 1);
        if (selectedRowIndex >= lineItems.length) selectedRowIndex = Math.max(0, lineItems.length - 1);
        recalculateTotals();
        renderGrid();
        showToast(`Removed "${name}"`, 'info');
      }
    }

    function selectRow(index) {
      selectedRowIndex = index;
      renderGrid();
    }

    function updateRowQty(index, newQty) {
      const q = parseInt(newQty, 10);
      if (isNaN(q) || q <= 0) {
        showToast('Quantity must be at least 1', 'warning');
        renderGrid();
        return;
      }
      lineItems[index].qty = q;
      recalculateTotals();
      renderGrid();
    }

    function updateRowPrice(index, newPrice) {
      const p = parseFloat(newPrice);
      if (isNaN(p) || p < 0) {
        showToast('Price cannot be negative', 'warning');
        renderGrid();
        return;
      }
      lineItems[index].price = p;
      recalculateTotals();
      renderGrid();
    }

    function addNewLinePrompt() {
      openAddNewProductModal();
    }

    function editSelectedLine() {
      if (selectedRowIndex < 0 || selectedRowIndex >= lineItems.length) {
        showToast('Please select a line to edit', 'warning');
        return;
      }
      const item = lineItems[selectedRowIndex];
      document.getElementById('editLineName').value = item.name;
      document.getElementById('editLineQty').value = item.qty;
      document.getElementById('editLinePrice').value = item.price;
      document.getElementById('editLineTax').value = item.taxRate || 10;
      document.getElementById('editLineTaxable').value = item.taxable || 'Y';
      openModal('editLineModal');
    }

    function saveEditedLine(event) {
      if (event) event.preventDefault();
      if (window.$ && $('#editLineForm').length && $('#editLineForm').data('validator')) {
        if ($('#editLineForm').valid()) {
          executeSaveEditedLine();
        }
      } else {
        executeSaveEditedLine();
      }
    }

    function executeSaveEditedLine() {
      if (selectedRowIndex >= 0 && selectedRowIndex < lineItems.length) {
        const name = document.getElementById('editLineName').value.trim();
        const qty = parseInt(document.getElementById('editLineQty').value, 10);
        const price = parseFloat(document.getElementById('editLinePrice').value);

        if (!name || isNaN(qty) || qty < 1 || isNaN(price) || price < 0) {
          showToast('Please enter valid line item details', 'error');
          return;
        }

        lineItems[selectedRowIndex].name = name;
        lineItems[selectedRowIndex].qty = qty;
        lineItems[selectedRowIndex].price = price;
        lineItems[selectedRowIndex].taxRate = parseFloat(document.getElementById('editLineTax').value) || 0;
        lineItems[selectedRowIndex].taxable = document.getElementById('editLineTaxable').value;
        closeModal('editLineModal');
        recalculateTotals();
        renderGrid();
        showToast('Line item updated', 'success');
      }
    }

    function deleteSelectedLine() {
      if (selectedRowIndex < 0 || selectedRowIndex >= lineItems.length) {
        showToast('Please select a line to delete', 'warning');
        return;
      }
      const item = lineItems[selectedRowIndex];
      Swal.fire({
        title: 'Delete Line Item?',
        text: `Are you sure you want to remove "${item.name}" from this invoice?`,
        icon: 'warning',
        showCancelButton: true,
        confirmButtonText: 'Yes, Delete',
        cancelButtonText: 'Cancel',
        confirmButtonColor: '#ef4444',
        cancelButtonColor: '#64748b'
      }).then((result) => {
        if (result.isConfirmed) {
          lineItems.splice(selectedRowIndex, 1);
          if (selectedRowIndex >= lineItems.length) {
            selectedRowIndex = Math.max(0, lineItems.length - 1);
          }
          recalculateTotals();
          renderGrid();
          showToast(`Removed "${item.name}"`, 'info');
        }
      });
    }

    function handleFastBarcode(event) {
      if (event.key === 'Enter') {
        event.preventDefault();
        const rawCode = event.target.value.trim();
        if (!rawCode) return;

        // Requirement: Without customer added do not add product
        if (!requireActiveCustomer('scan products')) {
          event.target.value = '';
          return;
        }

        // Multiple Product Add Option: Comma / Semicolon separated codes (e.g. "Milk, Bread, Tea" or "SKU1, SKU2")
        if (rawCode.includes(',') || rawCode.includes(';')) {
          const parts = rawCode.split(/[,;]+/).map(s => s.trim()).filter(Boolean);
          let addedCount = 0;
          parts.forEach(pCode => {
            if (processSingleBarcodeScan(pCode)) addedCount++;
          });
          event.target.value = '';
          if (addedCount > 0) {
            showToast(`Multi-Add: Added ${addedCount} products to bill`, 'success');
          }
          return;
        }

        // Multiple Product Add Option: Quantity multiplier (e.g. "5*Eggs" or "3*890123")
        let qtyMultiplier = 1;
        let codeToSearch = rawCode;
        if (rawCode.includes('*')) {
          const splitParts = rawCode.split('*');
          const parsedQty = parseInt(splitParts[0].trim(), 10);
          if (!isNaN(parsedQty) && parsedQty > 0) {
            qtyMultiplier = parsedQty;
            codeToSearch = splitParts.slice(1).join('*').trim();
          }
        }

        processSingleBarcodeScan(codeToSearch, qtyMultiplier);
        event.target.value = '';
      }
    }

    function playBeepTone() {
      try {
        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(920, audioCtx.currentTime);
        gain.gain.setValueAtTime(0.08, audioCtx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.0001, audioCtx.currentTime + 0.12);
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.start();
        osc.stop(audioCtx.currentTime + 0.12);
      } catch (e) {}
    }

    function processSingleBarcodeScan(code, qty = 1) {
      if (!code) return false;
      const cleanCode = String(code).trim().toLowerCase();

      // 1. Search in-memory products by Barcode or SKU first, then by exact name
      const found = (serverProducts || []).find(p => 
        (p.barcode && String(p.barcode).trim().toLowerCase() === cleanCode) ||
        (p.sku && String(p.sku).trim().toLowerCase() === cleanCode) ||
        (p.name && String(p.name).trim().toLowerCase() === cleanCode)
      ) || (serverProducts || []).find(p => 
        p.name && p.name.toLowerCase().includes(cleanCode)
      );

      if (found) {
        addProductToInvoice(found, qty);
        playBeepTone();
        const price = parseFloat(found.selling_price || 0);
        showToast(`Scanned: ${found.name} &bull; ₹${price.toFixed(2)} (Qty: ${qty})`, 'success');
        return true;
      } else {
        // Fallback: Query live database for newly created barcodes or items not yet loaded
        fetch(`/admin/sales/search/barcode?barcode=${encodeURIComponent(code)}`)
          .then(res => res.json())
          .then(data => {
            if (data && data.product) {
              const p = data.product;
              p.taxRate = (p.tax && p.tax.rate) ? Number(p.tax.rate) : 0;
              p.unit = (p.unit && p.unit.name) ? p.unit.name : (p.unit || 'Pcs');
              p.selling_price = Number(p.selling_price || 0);
              serverProducts.unshift(p);
              addProductToInvoice(p, qty);
              playBeepTone();
              showToast(`Scanned: ${p.name} &bull; ₹${p.selling_price.toFixed(2)} (Qty: ${qty})`, 'success');
            } else {
              // Unknown barcode scanned - optional quick product creation
              Swal.fire({
                icon: 'question',
                title: 'Unrecognized Barcode',
                html: `
                  <div style="font-size: 13.5px; color: #334155; margin-bottom: 8px;">
                    Barcode <strong>"${escapeHtml(code)}"</strong> was not found in catalog.
                  </div>
                  <div style="font-size: 12px; color: #64748b;">
                    Would you like to register this new product with this barcode now, or add as a quick item?
                  </div>
                `,
                showCancelButton: true,
                confirmButtonColor: '#2563eb',
                cancelButtonColor: '#64748b',
                confirmButtonText: '<i class="ti ti-plus"></i> Register Product',
                cancelButtonText: 'Add as Quick Item'
              }).then((result) => {
                if (result.isConfirmed) {
                  openAddNewProductModal(code);
                } else if (result.dismiss === Swal.DismissReason.cancel) {
                  lineItems.push({
                    id: null,
                    sku: code,
                    name: `Item (${code})`,
                    qty: qty,
                    price: 50.00,
                    taxRate: 10,
                    taxable: 'Y'
                  });
                  selectedRowIndex = lineItems.length - 1;
                  recalculateTotals();
                  renderGrid();
                  showToast(`Added quick item ${code} (Qty: ${qty})`, 'info');
                }
              });
            }
          })
          .catch(() => {
            showToast('Error looking up barcode from server', 'error');
          });

        return false;
      }
    }

    // ====================================================
    // COMPREHENSIVE PRODUCT SCANNER LOGIC (Handheld, Camera, Image)
    // ====================================================
    let html5QrScannerInstance = null;
    let isCameraScanningActive = false;
    let lastScannedBarcodeTime = 0;
    let lastScannedBarcodeValue = '';
    let currentScannerTab = 'handheld';

    function setScanMultiplier(val, btn) {
      document.getElementById('activeScanQtyMultiplier').value = val;
      const parent = btn.parentElement;
      if (parent) {
        parent.querySelectorAll('button').forEach(b => {
          b.style.background = '#e2e8f0';
          b.style.color = '#334155';
        });
      }
      btn.style.background = '#2563eb';
      btn.style.color = '#ffffff';
    }

    function switchScannerTab(tab) {
      currentScannerTab = tab;

      const paneHandheld = document.getElementById('scannerTabPaneHandheld');
      const paneCamera = document.getElementById('scannerTabPaneCamera');
      const paneImage = document.getElementById('scannerTabPaneImage');

      const btnHandheld = document.getElementById('tabBtnHandheldScan');
      const btnCamera = document.getElementById('tabBtnCameraScan');
      const btnImage = document.getElementById('tabBtnImageScan');

      // Reset all tab buttons
      [btnHandheld, btnCamera, btnImage].forEach(b => {
        if (b) {
          b.style.background = '#f1f5f9';
          b.style.color = '#475569';
          b.classList.remove('active');
        }
      });

      // Hide all panes
      if (paneHandheld) paneHandheld.style.display = 'none';
      if (paneCamera) paneCamera.style.display = 'none';
      if (paneImage) paneImage.style.display = 'none';

      if (tab === 'handheld') {
        if (paneHandheld) paneHandheld.style.display = 'block';
        if (btnHandheld) {
          btnHandheld.style.background = '#2563eb';
          btnHandheld.style.color = '#ffffff';
          btnHandheld.classList.add('active');
        }
        stopCameraScanning();
        setTimeout(() => {
          const inp = document.getElementById('handheldScanInput');
          if (inp) inp.focus();
        }, 100);
      } else if (tab === 'camera') {
        if (paneCamera) paneCamera.style.display = 'block';
        if (btnCamera) {
          btnCamera.style.background = '#2563eb';
          btnCamera.style.color = '#ffffff';
          btnCamera.classList.add('active');
        }
        populateCameraSources();
      } else if (tab === 'image') {
        if (paneImage) paneImage.style.display = 'block';
        if (btnImage) {
          btnImage.style.background = '#2563eb';
          btnImage.style.color = '#ffffff';
          btnImage.classList.add('active');
        }
        stopCameraScanning();
      }
    }

    function openProductScanModal() {
      if (!requireActiveCustomer('scan products')) return;

      const modal = document.getElementById('productScanModal');
      if (modal) modal.style.display = 'flex';

      // Always open on the zero-permission Handheld / USB Scanner tab by default
      switchScannerTab('handheld');
      
      const statusBadge = document.getElementById('scanCamStatusBadge');
      if (statusBadge) {
        statusBadge.className = 'badge-modern success';
        statusBadge.innerHTML = '<i class="ti ti-check"></i> Scanner Ready';
      }

      setTimeout(() => {
        const inp = document.getElementById('handheldScanInput');
        if (inp) {
          inp.value = '';
          inp.focus();
        }
      }, 150);
    }

    function closeProductScanModal() {
      stopCameraScanning();
      const modal = document.getElementById('productScanModal');
      if (modal) modal.style.display = 'none';

      const heroInp = document.getElementById('fastBarcodeInput');
      if (heroInp) heroInp.focus();
    }

    function executeHandheldModalScan() {
      const inp = document.getElementById('handheldScanInput');
      if (!inp) return;
      const code = inp.value.trim();
      if (!code) return;

      const qty = parseInt(document.getElementById('activeScanQtyMultiplier')?.value, 10) || 1;
      
      // Multiple items support: comma / semicolon separated
      if (code.includes(',') || code.includes(';')) {
        const parts = code.split(/[,;]+/).map(s => s.trim()).filter(Boolean);
        parts.forEach(pCode => processSingleBarcodeScan(pCode, qty));
      } else {
        processSingleBarcodeScan(code, qty);
      }

      inp.value = '';
      inp.focus();

      const feedback = document.getElementById('lastScannedFeedback');
      const nameEl = document.getElementById('lastScannedName');
      const detailsEl = document.getElementById('lastScannedDetails');
      const badgeEl = document.getElementById('lastScannedQtyBadge');

      if (feedback && nameEl) {
        feedback.style.display = 'flex';
        nameEl.textContent = `Scanned: ${code}`;
        detailsEl.textContent = `Added ${qty}x item(s) to current bill`;
        badgeEl.textContent = `+${qty} Added`;
      }
    }

    function populateCameraSources() {
      const select = document.getElementById('cameraSourceSelect');
      if (!select) return;

      if (typeof Html5Qrcode !== 'undefined' && Html5Qrcode.getCameras) {
        Html5Qrcode.getCameras().then(devices => {
          if (devices && devices.length) {
            select.innerHTML = '';
            devices.forEach((dev, idx) => {
              const opt = document.createElement('option');
              opt.value = dev.id;
              opt.textContent = dev.label || `Camera ${idx + 1}`;
              select.appendChild(opt);
            });
          }
        }).catch(err => {
          console.warn('Camera device listing notice:', err);
        });
      }
    }

    function toggleCameraScanning() {
      if (isCameraScanningActive) {
        stopCameraScanning();
      } else {
        startCameraScanning();
      }
    }

    function switchCameraSource(cameraId) {
      if (isCameraScanningActive) {
        stopCameraScanning();
        setTimeout(() => startCameraScanning(cameraId), 300);
      }
    }

    function startCameraScanning(selectedCameraId) {
      if (typeof Html5Qrcode === 'undefined') {
        showToast('Camera scanner library loading, please wait a moment...', 'info');
        return;
      }

      const placeholder = document.getElementById('cameraPlaceholderNotice');
      const deniedBox = document.getElementById('cameraPermissionDeniedBox');
      const targetGuide = document.getElementById('scannerTargetGuide');
      const statusBadge = document.getElementById('scanCamStatusBadge');
      const toggleBtn = document.getElementById('btnToggleCameraFeed');

      if (!html5QrScannerInstance) {
        html5QrScannerInstance = new Html5Qrcode('html5QrCodeReader');
      }

      const cameraId = selectedCameraId || document.getElementById('cameraSourceSelect')?.value;
      const cameraConfig = cameraId ? { deviceId: { exact: cameraId } } : { facingMode: 'environment' };

      const scanConfig = {
        fps: 15,
        qrbox: { width: 280, height: 160 },
        aspectRatio: 1.777778
      };

      if (placeholder) placeholder.style.display = 'none';
      if (deniedBox) deniedBox.style.display = 'none';

      if (statusBadge) {
        statusBadge.className = 'badge-modern warning';
        statusBadge.innerHTML = '<i class="ti ti-loader-2" style="animation:loaderSpin 0.75s linear infinite; display:inline-block;"></i> Connecting Camera...';
      }

      html5QrScannerInstance.start(
        cameraConfig,
        scanConfig,
        (decodedText, decodedResult) => {
          handleDetectedCameraBarcode(decodedText);
        },
        (errorMessage) => {}
      ).then(() => {
        isCameraScanningActive = true;
        if (targetGuide) targetGuide.style.display = 'block';
        if (statusBadge) {
          statusBadge.className = 'badge-modern success';
          statusBadge.innerHTML = '<i class="ti ti-circle-check"></i> Live Camera Active';
        }
        if (toggleBtn) {
          toggleBtn.className = 'btn-modern btn-danger-modern btn-sm-modern';
          toggleBtn.innerHTML = '<i class="ti ti-video-off"></i> Stop Camera';
        }
      }).catch(err => {
        console.warn('Camera permission or device notice:', err);
        isCameraScanningActive = false;
        if (targetGuide) targetGuide.style.display = 'none';
        if (placeholder) placeholder.style.display = 'none';
        if (deniedBox) deniedBox.style.display = 'flex';

        if (statusBadge) {
          statusBadge.className = 'badge-modern warning';
          statusBadge.innerHTML = '<i class="ti ti-lock"></i> Camera Blocked';
        }
        if (toggleBtn) {
          toggleBtn.className = 'btn-modern btn-primary-modern btn-sm-modern';
          toggleBtn.innerHTML = '<i class="ti ti-camera"></i> Turn On Camera';
        }
      });
    }

    function stopCameraScanning() {
      const statusBadge = document.getElementById('scanCamStatusBadge');
      const placeholder = document.getElementById('cameraPlaceholderNotice');
      const deniedBox = document.getElementById('cameraPermissionDeniedBox');
      const targetGuide = document.getElementById('scannerTargetGuide');
      const toggleBtn = document.getElementById('btnToggleCameraFeed');

      if (targetGuide) targetGuide.style.display = 'none';
      if (deniedBox) deniedBox.style.display = 'none';

      if (html5QrScannerInstance && isCameraScanningActive) {
        html5QrScannerInstance.stop().then(() => {
          isCameraScanningActive = false;
          if (placeholder) placeholder.style.display = 'block';
          if (statusBadge) {
            statusBadge.className = 'badge-modern success';
            statusBadge.innerHTML = '<i class="ti ti-check"></i> Scanner Ready';
          }
          if (toggleBtn) {
            toggleBtn.className = 'btn-modern btn-primary-modern btn-sm-modern';
            toggleBtn.innerHTML = '<i class="ti ti-camera"></i> Turn On Camera';
          }
        }).catch(err => {
          isCameraScanningActive = false;
        });
      } else {
        isCameraScanningActive = false;
        if (placeholder) placeholder.style.display = 'block';
      }
    }

    function handleDetectedCameraBarcode(code) {
      const now = Date.now();
      const clean = String(code || '').trim();
      if (!clean) return;

      if (clean === lastScannedBarcodeValue && (now - lastScannedBarcodeTime < 1500)) {
        return;
      }
      lastScannedBarcodeValue = clean;
      lastScannedBarcodeTime = now;

      const qty = parseInt(document.getElementById('activeScanQtyMultiplier')?.value, 10) || 1;
      const targetGuide = document.getElementById('scannerTargetGuide');

      if (targetGuide) {
        targetGuide.style.borderColor = '#10b981';
        targetGuide.style.boxShadow = '0 0 15px 3px rgba(16, 185, 129, 0.75), 0 0 0 9999px rgba(0, 0, 0, 0.5)';
        setTimeout(() => {
          targetGuide.style.borderColor = 'rgba(59, 130, 246, 0.85)';
          targetGuide.style.boxShadow = '0 0 0 9999px rgba(0, 0, 0, 0.5)';
        }, 400);
      }

      processSingleBarcodeScan(clean, qty);

      const feedback = document.getElementById('lastScannedFeedback');
      const nameEl = document.getElementById('lastScannedName');
      const detailsEl = document.getElementById('lastScannedDetails');
      const badgeEl = document.getElementById('lastScannedQtyBadge');

      if (feedback && nameEl) {
        feedback.style.display = 'flex';
        nameEl.textContent = `Barcode: ${clean}`;
        detailsEl.textContent = `Scanned ${qty}x unit(s) into current bill`;
        badgeEl.textContent = `+${qty} Added`;
      }
    }

    function handleBarcodeImageFile(input) {
      if (!input.files || !input.files[0]) return;
      const file = input.files[0];

      if (!html5QrScannerInstance) {
        html5QrScannerInstance = new Html5Qrcode('html5QrCodeReader');
      }

      Swal.fire({
        title: 'Decoding Barcode...',
        text: 'Reading image file for barcodes',
        allowOutsideClick: false,
        didOpen: () => Swal.showLoading()
      });

      const qty = parseInt(document.getElementById('activeScanQtyMultiplier')?.value, 10) || 1;

      html5QrScannerInstance.scanFile(file, true)
        .then(decodedText => {
          Swal.close();
          processSingleBarcodeScan(decodedText, qty);
          showToast(`Decoded barcode: ${decodedText}`, 'success');
          input.value = '';
        })
        .catch(err => {
          Swal.fire({
            icon: 'warning',
            title: 'Barcode Not Detected',
            text: 'Could not clearly identify a barcode in this image. Please ensure the barcode is clear, well-lit, and try again, or type it in Handheld mode.',
            confirmButtonColor: '#2563eb'
          });
          input.value = '';
        });
    }

    function addProductToInvoice(p, qtyToAdd = 1) {
      // Requirement: Without customer added do not add product
      if (!requireActiveCustomer('add products')) return;

      const q = Math.max(1, parseInt(qtyToAdd, 10) || 1);
      const existing = lineItems.find(i => i.id === p.id);
      if (existing) {
        existing.qty += q;
      } else {
        lineItems.push({
          id: p.id,
          sku: p.sku || p.barcode || `SKU-${p.id}`,
          name: p.name,
          qty: q,
          price: parseFloat(p.selling_price || 0),
          taxRate: p.tax ? parseFloat(p.tax.rate || 10) : 10,
          taxable: 'Y'
        });
      }
      selectedRowIndex = lineItems.length - 1;
      recalculateTotals();
      renderGrid();
      showToast(`Added "${p.name}" (Qty: ${q})`, 'success');
    }

    function recalculateTotals() {
      let subtotal = 0;
      lineItems.forEach(item => {
        subtotal += (item.qty * item.price);
      });

      const discRate = parseFloat(document.getElementById('discountRateInput').value) || 0;
      const discAmount = (subtotal * discRate) / 100;
      const subtotalAfterDisc = Math.max(0, subtotal - discAmount);

      const taxRate = parseFloat(document.getElementById('taxRateInput').value) || 0;
      const taxAmount = (subtotalAfterDisc * taxRate) / 100;

      const delivery = parseFloat(document.getElementById('deliveryCostsInput').value) || 0;
      const invoiceTotal = subtotalAfterDisc + taxAmount + delivery;

      const payments = parseFloat(document.getElementById('paymentsInput').value) || 0;
      const amountDue = Math.max(0, invoiceTotal - payments);

      document.getElementById('subTotalDisplay').value = `₹${subtotal.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
      document.getElementById('taxAmountDisplay').value = `₹${taxAmount.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
      document.getElementById('invoiceTotalDisplay').value = `₹${invoiceTotal.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
      document.getElementById('amountDueDisplay').value = `₹${amountDue.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;

      const bigTotalEl = document.getElementById('bigGrandTotalDisplay');
      if (bigTotalEl) {
        bigTotalEl.textContent = `₹${invoiceTotal.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
      }

      const discPreview = document.getElementById('discountValPreview');
      if (discPreview) {
        discPreview.textContent = `- ₹${discAmount.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
      }

      const changeReturnVal = document.getElementById('changeReturnVal');
      const changeAmt = payments >= invoiceTotal ? (payments - invoiceTotal) : 0;
      if (changeReturnVal) {
        changeReturnVal.textContent = `₹${changeAmt.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
      }

      const changeEl = document.getElementById('changeReturn');
      if (changeEl) {
        changeEl.textContent = changeAmt.toFixed(2);
      }
    }

    let activePaymentMode = 'CASH';
    function selectPaymentMode(mode, btn) {
      activePaymentMode = mode;
      document.querySelectorAll('.pay-tile').forEach(b => b.classList.remove('active'));
      if (btn) btn.classList.add('active');

      const tenderBox = document.getElementById('tenderBoxContainer');
      const label = document.getElementById('checkoutBtnLabel');
      if (mode === 'CASH') {
        if (tenderBox) tenderBox.style.display = 'flex';
        if (label) label.textContent = 'PAY WITH CASH & PRINT';
      } else if (mode === 'UPI') {
        setExactTender();
        if (tenderBox) tenderBox.style.display = 'none';
        if (label) label.textContent = 'PAY VIA UPI / QR & PRINT';
      } else if (mode === 'CARD') {
        setExactTender();
        if (tenderBox) tenderBox.style.display = 'none';
        if (label) label.textContent = 'SWIPE CARD & PRINT';
      } else {
        document.getElementById('paymentsInput').value = '0.00';
        recalculateTotals();
        if (tenderBox) tenderBox.style.display = 'none';
        if (label) label.textContent = 'SAVE ON CREDIT & PRINT';
      }
    }

    function setExactTender() {
      const invTotalStr = document.getElementById('invoiceTotalDisplay').value.replace(/[^0-9.]/g, '');
      const tot = parseFloat(invTotalStr) || 0;
      document.getElementById('paymentsInput').value = tot.toFixed(2);
      recalculateTotals();
    }

    function addTender(amt) {
      const cur = parseFloat(document.getElementById('paymentsInput').value) || 0;
      document.getElementById('paymentsInput').value = (cur + amt).toFixed(2);
      recalculateTotals();
    }

    function calculateChangeReturn() {
      recalculateTotals();
    }

    function toggleAdvancedOptions() {
      const drawer = document.getElementById('posAdvancedDrawer');
      if (drawer) {
        drawer.style.display = drawer.style.display === 'none' ? 'block' : 'none';
      }
    }

    function markAsPaid() {
      let subtotal = 0;
      lineItems.forEach(item => { subtotal += (item.qty * item.price); });
      const discRate = parseFloat(document.getElementById('discountRateInput').value) || 0;
      const discAmount = (subtotal * discRate) / 100;
      const subtotalAfterDisc = Math.max(0, subtotal - discAmount);
      const taxRate = parseFloat(document.getElementById('taxRateInput').value) || 0;
      const taxAmount = (subtotalAfterDisc * taxRate) / 100;
      const delivery = parseFloat(document.getElementById('deliveryCostsInput').value) || 0;
      const total = subtotalAfterDisc + taxAmount + delivery;

      document.getElementById('paymentsInput').value = total.toFixed(2);
      recalculateTotals();
      showToast('Marked as PAID in full', 'success');
    }

    function switchTab(paneId, btn) {
      document.querySelectorAll('.pos-tab-pane').forEach(p => p.classList.remove('active'));
      document.querySelectorAll('.pos-tab-btn').forEach(b => b.classList.remove('active'));
      document.getElementById(paneId).classList.add('active');
      btn.classList.add('active');
    }

    function openPosCustomerModal() {
      openCustomerSelectModal();
    }

    function openCustomerSelectModal() {
      filterCustomerList();
      openModal('customerSelectModal');
    }

    function filterCustomerList() {
      const q = (document.getElementById('custSearchInput').value || '').toLowerCase();
      const tbody = document.getElementById('customerTableBody');
      tbody.innerHTML = '';

      (serverCustomers || []).filter(c => 
        (c.name && c.name.toLowerCase().includes(q)) ||
        (c.phone && c.phone.includes(q)) ||
        (c.email && c.email.toLowerCase().includes(q)) ||
        (c.city && c.city.toLowerCase().includes(q))
      ).forEach(c => {
        const tr = document.createElement('tr');
        tr.innerHTML = `
          <td style="font-family: var(--font-mono);">${String(c.id).padStart(4, '0')}</td>
          <td style="font-weight: 700;">${escapeHtml(c.name)}</td>
          <td>${escapeHtml(c.phone || '-')}</td>
          <td>${escapeHtml(c.email || '-')}</td>
          <td>${escapeHtml(c.city || '-')}</td>
          <td style="text-align: center;">
            <button type="button" class="btn-modern btn-primary-modern btn-sm-modern" onclick="pickCustomer(${c.id})">Select</button>
          </td>
        `;
        tbody.appendChild(tr);
      });
    }

    function pickCustomer(id) {
      const c = (serverCustomers || []).find(x => x.id === id);
      if (c) {
        setCustomer(c);
        closeModal('customerSelectModal');
        showToast(`Selected Customer: ${c.name}`, 'success');
      }
    }

    function openAddNewCustomerModal() {
      closeModal('customerSelectModal');
      $('#newCustomerForm').validate().resetForm();
      $('#newCustomerForm').find('.is-invalid, .is-valid').removeClass('is-invalid is-valid');
      document.getElementById('newCustomerForm').reset();
      openModal('addNewCustomerModal');
    }

    // Customer Save execution (Triggered by jQuery Validation or direct call)
    function submitNewCustomerForm(event) {
      if (event) event.preventDefault();
      executeCustomerSave();
    }

    async function executeCustomerSave() {
      const name = document.getElementById('nc_name').value.trim();
      const phone = document.getElementById('nc_phone').value.trim();
      const email = document.getElementById('nc_email').value.trim();
      const address = document.getElementById('nc_address').value.trim();
      const city = document.getElementById('nc_city').value.trim();
      const state = document.getElementById('nc_state').value.trim();
      const postal_code = document.getElementById('nc_postal_code').value.trim();
      const gstin = document.getElementById('nc_gstin').value.trim();
      const customer_type = document.getElementById('nc_customer_type').value;
      const credit_limit = parseFloat(document.getElementById('nc_credit_limit').value) || 0;

      Swal.fire({
        title: 'Registering Customer...',
        allowOutsideClick: false,
        didOpen: () => Swal.showLoading()
      });

      try {
        const response = await fetch('/admin/master/customers', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify({
            name, phone, email, address, city, state, postal_code, gstin, customer_type, credit_limit
          })
        });

        const result = await response.json();
        if (!response.ok || !result.success) {
          throw new Error(result.error || 'Failed to save customer');
        }

        const newCustomer = result.customer;
        serverCustomers.unshift(newCustomer);
        setCustomer(newCustomer);
        closeModal('addNewCustomerModal');

        Swal.fire({
          icon: 'success',
          title: 'Customer Added!',
          text: `"${newCustomer.name}" has been registered and selected.`,
          timer: 1600,
          showConfirmButton: false
        });

      } catch (err) {
        Swal.fire({
          icon: 'error',
          title: 'Product Creation Error',
          text: err.message
        });
      }
    }

    function openProductCatalogModal() {
      // Requirement: Without customer added do not add product
      if (!requireActiveCustomer('browse product catalog')) return;
      filterProductList();
      openModal('productSelectModal');
    }

    function filterProductList() {
      const q = (document.getElementById('productSearchInput').value || '').toLowerCase();
      const catId = document.getElementById('productCategoryFilter').value;
      const tbody = document.getElementById('productTableBody');
      tbody.innerHTML = '';

      const filtered = (serverProducts || []).filter(p => {
        const matchQ = (p.name && p.name.toLowerCase().includes(q)) ||
                       (p.sku && p.sku.toLowerCase().includes(q)) ||
                       (p.barcode && p.barcode.toLowerCase().includes(q));
        const matchCat = !catId || String(p.category_id) === String(catId);
        return matchQ && matchCat;
      });

      if (filtered.length === 0) {
        tbody.innerHTML = `<tr><td colspan="7" class="text-center" style="padding: 24px; color: #94a3b8;">No matching products found.</td></tr>`;
        updateMultiProductCount();
        return;
      }

      filtered.forEach(p => {
        const tr = document.createElement('tr');
        const price = parseFloat(p.selling_price || 0);
        const taxRate = p.tax ? p.tax.rate : 10;
        tr.innerHTML = `
          <td style="text-align: center;">
            <input type="checkbox" class="product-multi-chk" data-id="${p.id}" onchange="updateMultiProductCount()" />
          </td>
          <td style="font-family: var(--font-mono); font-size: 11px;">${escapeHtml(p.sku || p.barcode || '-')}</td>
          <td style="font-weight: 600;">${escapeHtml(p.name)}</td>
          <td style="text-align: right; font-weight: 700; font-family: var(--font-mono);">₹${price.toFixed(2)}</td>
          <td style="text-align: center;">${taxRate}%</td>
          <td style="text-align: center;">
            <div style="display: inline-flex; align-items: center; border: 1px solid #cbd5e1; border-radius: 6px; overflow: hidden; background: #fff;">
              <button type="button" onclick="adjustCatalogQty(${p.id}, -1)" style="border:none; background:#f1f5f9; width: 22px; height: 24px; cursor:pointer; font-weight:bold; font-size: 13px;">-</button>
              <input type="number" id="catQty_${p.id}" value="1" min="1" oninput="onCatalogQtyChange(${p.id})" style="width: 36px; text-align: center; border: none; font-size: 12px; font-weight:700;" />
              <button type="button" onclick="adjustCatalogQty(${p.id}, 1)" style="border:none; background:#f1f5f9; width: 22px; height: 24px; cursor:pointer; font-weight:bold; font-size: 13px;">+</button>
            </div>
          </td>
          <td style="text-align: center;">
            <button type="button" class="btn-modern btn-primary-modern btn-sm-modern" onclick="pickProductWithQty(${p.id})" title="Add 1 item immediately">+ Add</button>
          </td>
        `;
        tbody.appendChild(tr);
      });

      updateMultiProductCount();
    }

    function adjustCatalogQty(pId, delta) {
      const input = document.getElementById(`catQty_${pId}`);
      if (input) {
        const cur = Math.max(1, parseInt(input.value, 10) || 1);
        const next = Math.max(1, cur + delta);
        input.value = next;
        const chk = document.querySelector(`.product-multi-chk[data-id="${pId}"]`);
        if (chk && !chk.checked && delta > 0) {
          chk.checked = true;
        }
        updateMultiProductCount();
      }
    }

    function onCatalogQtyChange(pId) {
      const input = document.getElementById(`catQty_${pId}`);
      if (input) {
        const cur = parseInt(input.value, 10);
        if (isNaN(cur) || cur < 1) input.value = 1;
        const chk = document.querySelector(`.product-multi-chk[data-id="${pId}"]`);
        if (chk && !chk.checked) {
          chk.checked = true;
        }
        updateMultiProductCount();
      }
    }

    function toggleSelectAllProducts(checked) {
      document.querySelectorAll('.product-multi-chk').forEach(chk => {
        chk.checked = checked;
      });
      updateMultiProductCount();
    }

    function updateMultiProductCount() {
      const checkedBoxes = document.querySelectorAll('.product-multi-chk:checked');
      const count = checkedBoxes ? checkedBoxes.length : 0;
      let totalUnits = 0;
      if (checkedBoxes) {
        checkedBoxes.forEach(chk => {
          const pId = chk.getAttribute('data-id');
          const qtyInput = document.getElementById(`catQty_${pId}`);
          totalUnits += Math.max(1, parseInt(qtyInput ? qtyInput.value : 1, 10) || 1);
        });
      }

      const counterBadge = document.getElementById('multiSelectCounterBadge');
      if (counterBadge) counterBadge.textContent = `${count} Selected (${totalUnits} pcs)`;

      const countBtn = document.getElementById('multiSelectCountBtn');
      if (countBtn) countBtn.textContent = `${count} items, ${totalUnits} pcs`;

      const summaryText = document.getElementById('multiSelectSummaryText');
      if (summaryText) {
        summaryText.textContent = count > 0 ? `${count} products checked (${totalUnits} units total)` : 'No products checked';
      }

      const addBtn = document.getElementById('btnAddMultiProducts');
      if (addBtn) {
        if (count > 0) {
          addBtn.disabled = false;
          addBtn.style.opacity = '1';
        } else {
          addBtn.disabled = true;
          addBtn.style.opacity = '0.55';
        }
      }

      const allBoxes = document.querySelectorAll('.product-multi-chk');
      const selectAll = document.getElementById('selectAllProductsCheck');
      if (selectAll && allBoxes.length > 0) {
        selectAll.checked = (count === allBoxes.length);
      }
    }

    function pickProductWithQty(id) {
      if (!requireActiveCustomer('add products')) return;
      const p = (serverProducts || []).find(x => x.id === id);
      const qtyInput = document.getElementById(`catQty_${id}`);
      const qty = Math.max(1, parseInt(qtyInput ? qtyInput.value : 1, 10) || 1);
      if (p) {
        addProductToInvoice(p, qty);
        closeModal('productSelectModal');
      }
    }

    function addSelectedProductsToCart() {
      if (!requireActiveCustomer('add products')) return;
      const chks = document.querySelectorAll('.product-multi-chk:checked');
      if (!chks || chks.length === 0) {
        showToast('Please check at least one product to add', 'warning');
        return;
      }
      let addedProducts = 0;
      let totalUnits = 0;
      chks.forEach(chk => {
        const pId = parseInt(chk.getAttribute('data-id'), 10);
        const p = (serverProducts || []).find(x => x.id === pId);
        const qtyInput = document.getElementById(`catQty_${pId}`);
        const qty = Math.max(1, parseInt(qtyInput ? qtyInput.value : 1, 10) || 1);
        if (p) {
          addProductToInvoice(p, qty);
          addedProducts++;
          totalUnits += qty;
        }
      });
      closeModal('productSelectModal');
      showToast(`Batch added ${addedProducts} products (${totalUnits} pcs) to cart`, 'success');
    }

    function generateNewProductBarcode() {
      // Generate standard 12/13-digit retail barcode with India GS1 prefix 890
      const rand9 = Math.floor(100000000 + Math.random() * 900000000);
      const raw12 = '890' + rand9;
      let sum = 0;
      for (let i = 0; i < 12; i++) {
        sum += parseInt(raw12[i], 10) * (i % 2 === 0 ? 1 : 3);
      }
      const checkDigit = (10 - (sum % 10)) % 10;
      const fullBarcode = raw12 + checkDigit;
      const barcodeEl = document.getElementById('np_barcode');
      if (barcodeEl) {
        barcodeEl.value = fullBarcode;
        renderBarcodeVisual(fullBarcode);
      }
      return fullBarcode;
    }

    function generateNewProductSku() {
      const sku = 'SKU-' + Math.floor(1000 + Math.random() * 9000);
      const skuEl = document.getElementById('np_sku');
      if (skuEl) skuEl.value = sku;
    }

    function renderBarcodeVisual(code) {
      const container = document.getElementById('npBarcodeSvgContainer');
      const textDisplay = document.getElementById('npBarcodeCodeDisplay');
      if (!container || !textDisplay) return;

      const val = String(code || '').trim();
      if (!val) {
        container.innerHTML = '<span style="font-size: 10px; color: #94a3b8;">Barcode optional</span>';
        textDisplay.textContent = 'Optional';
        return;
      }

      textDisplay.textContent = val;
      let barsHtml = '';
      for (let i = 0; i < val.length; i++) {
        const charCode = val.charCodeAt(i);
        const w = (charCode % 3 === 0) ? 3 : (charCode % 2 === 0 ? 2 : 1);
        const h = 14 + (charCode % 7);
        barsHtml += `<div style="width:${w}px; height:${h}px; background:#0f172a; margin-right: 1.5px;"></div>`;
      }
      container.innerHTML = barsHtml;
    }

