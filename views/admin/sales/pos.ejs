<!-- ==========================================================
     ADVANCED POS LOGIC & MULTI-LEVEL ENGINE
     ========================================================== -->
<script>
  // Web Audio Synthesizer Feedback
  const PosAudio = {
    enabled: true,
    ctx: null,
    init() {
      if (!this.ctx && (window.AudioContext || window.webkitAudioContext)) {
        this.ctx = new (window.AudioContext || window.webkitAudioContext)();
      }
    },
    beep() {
      if (!this.enabled) return;
      try {
        this.init();
        if (!this.ctx) return;
        const osc = this.ctx.createOscillator();
        const gain = this.ctx.createGain();
        osc.connect(gain);
        gain.connect(this.ctx.destination);
        osc.frequency.setValueAtTime(880, this.ctx.currentTime);
        gain.gain.setValueAtTime(0.12, this.ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + 0.09);
        osc.start();
        osc.stop(this.ctx.currentTime + 0.09);
      } catch (e) {}
    },
    success() {
      if (!this.enabled) return;
      try {
        this.init();
        if (!this.ctx) return;
        const notes = [523.25, 659.25, 783.99, 1046.50];
        notes.forEach((freq, i) => {
          const osc = this.ctx.createOscillator();
          const gain = this.ctx.createGain();
          osc.connect(gain);
          gain.connect(this.ctx.destination);
          osc.frequency.setValueAtTime(freq, this.ctx.currentTime + i * 0.08);
          gain.gain.setValueAtTime(0.14, this.ctx.currentTime + i * 0.08);
          gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + (i + 1) * 0.08);
          osc.start(this.ctx.currentTime + i * 0.08);
          osc.stop(this.ctx.currentTime + (i + 1) * 0.08);
        });
      } catch (e) {}
    },
    error() {
      if (!this.enabled) return;
      try {
        this.init();
        if (!this.ctx) return;
        const osc = this.ctx.createOscillator();
        const gain = this.ctx.createGain();
        osc.type = 'sawtooth';
        osc.connect(gain);
        gain.connect(this.ctx.destination);
        osc.frequency.setValueAtTime(220, this.ctx.currentTime);
        gain.gain.setValueAtTime(0.15, this.ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + 0.2);
        osc.start();
        osc.stop(this.ctx.currentTime + 0.2);
      } catch (e) {}
    }
  };

  function togglePosAudio() {
    PosAudio.enabled = !PosAudio.enabled;
    const btn = document.getElementById('audioToggleBtn');
    if (PosAudio.enabled) {
      btn.innerHTML = '<i class="ti ti-volume"></i>';
      showToast('info', 'Audio feedback enabled');
      PosAudio.beep();
    } else {
      btn.innerHTML = '<i class="ti ti-volume-off"></i>';
      showToast('info', 'Audio feedback muted');
    }
  }

  // ==========================================================
  // MULTI-LEVEL & MULTI-CART STATE
  // ==========================================================
  let currentLevel = 1;
  let orderTabs = [
    {
      id: 0,
      title: 'Cart #1',
      cart: [],
      customer_id: '',
      customer_name: 'Walk-in Customer',
      payment_mode_id: '',
      discount: 0,
      discountType: 'flat',
      deliveryCharge: 0,
      packagingCharge: 0,
      promoDiscount: 0,
      notes: ''
    }
  ];
  let activeTabIndex = 0;
  let currentSelectedCategory = 'all';
  let activeInvoiceData = null;

  function getActiveTab() {
    return orderTabs[activeTabIndex] || orderTabs[0];
  }

  function getCart() {
    return getActiveTab().cart;
  }

  // Level Navigation (Levels 1 to 5)
  function goToLevel(level) {
    const currentCart = getCart();

    if (level > 1 && currentCart.length === 0) {
      PosAudio.error();
      showWarning('Empty Cart', 'Please add products to the cart first.');
      return;
    }

    currentLevel = level;

    for (let i = 1; i <= 5; i++) {
      const panel = document.getElementById(`levelPanel${i}`);
      if (panel) panel.style.display = (i === level) ? 'block' : 'none';

      const btn = document.getElementById(`levelBtn${i}`);
      if (btn) {
        btn.classList.remove('active');
        if (i === level) btn.classList.add('active');
        if (i < level) btn.classList.add('completed');
        else btn.classList.remove('completed');
      }
    }

    const backBtn = document.getElementById('wizardBackBtn');
    const nextBtn = document.getElementById('wizardNextBtn');
    const payBtn = document.getElementById('wizardPayBtn');
    const navRow = document.getElementById('wizardNavRow');

    if (level === 1) {
      backBtn.style.display = 'none';
      nextBtn.style.display = 'inline-flex';
      nextBtn.innerHTML = 'Continue to Customer (Level 2) <i class="ti ti-chevron-right"></i>';
      payBtn.style.display = 'none';
      navRow.className = 'pos-nav-controls single-col';
    } else if (level === 2) {
      backBtn.style.display = 'inline-flex';
      backBtn.innerHTML = '<i class="ti ti-chevron-left"></i> Back to Items';
      nextBtn.style.display = 'inline-flex';
      nextBtn.innerHTML = 'Continue to Payment (Level 3) <i class="ti ti-chevron-right"></i>';
      payBtn.style.display = 'none';
      navRow.className = 'pos-nav-controls';
    } else if (level === 3) {
      backBtn.style.display = 'inline-flex';
      backBtn.innerHTML = '<i class="ti ti-chevron-left"></i> Back';
      nextBtn.style.display = 'inline-flex';
      nextBtn.innerHTML = 'Advanced Options (Level 4) <i class="ti ti-chevron-right"></i>';
      payBtn.style.display = 'inline-flex';
      payBtn.innerHTML = '<i class="ti ti-printer"></i> Instant Pay (F2)';
      navRow.className = 'pos-nav-controls';
    } else if (level === 4) {
      backBtn.style.display = 'inline-flex';
      backBtn.innerHTML = '<i class="ti ti-chevron-left"></i> Back';
      nextBtn.style.display = 'inline-flex';
      nextBtn.innerHTML = 'Preview Invoice (Level 5) <i class="ti ti-chevron-right"></i>';
      payBtn.style.display = 'inline-flex';
      payBtn.innerHTML = '<i class="ti ti-printer"></i> Instant Pay (F2)';
      navRow.className = 'pos-nav-controls';
    } else if (level === 5) {
      backBtn.style.display = 'inline-flex';
      backBtn.innerHTML = '<i class="ti ti-chevron-left"></i> Back to Settings';
      nextBtn.style.display = 'none';
      payBtn.style.display = 'inline-flex';
      payBtn.innerHTML = '<i class="ti ti-printer"></i> Confirm &amp; Print Bill (F2)';
      navRow.className = 'pos-nav-controls single-col';
      renderInlineInvoicePreview();
    }
  }

  function nextLevel() {
    if (currentLevel < 5) {
      goToLevel(currentLevel + 1);
    }
  }

  function prevLevel() {
    if (currentLevel > 1) {
      goToLevel(currentLevel - 1);
    }
  }

  // Multi-Order Tab Rendering
  function renderOrderTabs() {
    const container = document.getElementById('parkedTabsBar');
    container.innerHTML = orderTabs.map((tab, idx) => {
      let tabTotal = 0;
      tab.cart.forEach(item => {
        tabTotal += (item.quantity * item.unit_price) * (1 + item.tax_rate / 100);
      });
      const isActive = (idx === activeTabIndex);
      return `
        <button type="button" class="pos-tab-chip ${isActive ? 'active' : ''}" onclick="switchOrderTab(${idx})">
          <i class="ti ti-shopping-cart"></i>
          <span>${tab.title} (₹${tabTotal.toFixed(2)})</span>
        </button>
      `;
    }).join('');
  }

  function createNewOrderTab() {
    const newIdx = orderTabs.length;
    orderTabs.push({
      id: newIdx,
      title: `Cart #${newIdx + 1}`,
      cart: [],
      customer_id: '',
      customer_name: 'Walk-in Customer',
      payment_mode_id: document.getElementById('payment_mode_id').value || '',
      discount: 0,
      discountType: 'flat',
      deliveryCharge: 0,
      packagingCharge: 0,
      promoDiscount: 0,
      notes: ''
    });
    switchOrderTab(newIdx);
    showToast('info', `Opened new Cart #${newIdx + 1}`);
  }

  function switchOrderTab(idx) {
    if (idx < 0 || idx >= orderTabs.length) return;
    activeTabIndex = idx;
    const tab = getActiveTab();
    
    document.getElementById('customer_id').value = tab.customer_id || '';
    if (tab.payment_mode_id) {
      document.getElementById('payment_mode_id').value = tab.payment_mode_id;
    }
    document.getElementById('discountInput').value = tab.discount || 0;
    document.getElementById('discountType').value = tab.discountType || 'flat';
    document.getElementById('extraDeliveryCharge').value = tab.deliveryCharge || 0;
    document.getElementById('extraPackagingCharge').value = tab.packagingCharge || 0;
    document.getElementById('invoice_notes').value = tab.notes || '';

    updateCustomerPreview();
    renderOrderTabs();
    renderCart();
    goToLevel(1);
  }

  // Floating Live Item-Added Banner Trigger
  let bannerTimer = null;
  function showItemAddedBanner(name, qty, price) {
    const banner = document.getElementById('posItemAddedBanner');
    document.getElementById('bannerItemName').textContent = `Added: ${name}`;
    document.getElementById('bannerItemMeta').textContent = `Qty: ${qty} • Rate: ₹${Number(price).toFixed(2)}`;
    banner.classList.add('show');
    clearTimeout(bannerTimer);
    bannerTimer = setTimeout(() => {
      banner.classList.remove('show');
    }, 2400);
  }

  // Cart Operations
  function addToCart(productId, name, price, taxRate) {
    const pId = productId ? Number(productId) : null;
    const pPrice = Number(price) || 0;
    const pTax = Number(taxRate) || 0;
    const currentCart = getCart();

    const existing = pId ? currentCart.find(item => item.product_id === pId) : null;
    let finalQty = 1;
    let targetIndex = -1;

    if (existing) {
      existing.quantity += 1;
      finalQty = existing.quantity;
      targetIndex = currentCart.indexOf(existing);
    } else {
      currentCart.push({
        product_id: pId,
        name: name,
        unit_price: pPrice,
        tax_rate: pTax,
        quantity: 1
      });
      targetIndex = currentCart.length - 1;
    }

    PosAudio.beep();
    showItemAddedBanner(name, finalQty, pPrice);
    renderCart();
    renderOrderTabs();

    // Highlight row
    setTimeout(() => {
      const rows = document.querySelectorAll('#cartTableRows tr');
      if (rows[targetIndex]) {
        rows[targetIndex].classList.add('cart-row-highlight');
      }
    }, 50);
  }

  function addProductToCart(element) {
    const id = Number(element.dataset.id);
    const name = element.dataset.name;
    const price = Number(element.dataset.price);
    const tax = Number(element.dataset.tax);

    if (!name || price < 0) {
      PosAudio.error();
      showWarning('Invalid Product', 'Product data is incomplete.');
      return;
    }

    addToCart(id, name, price, tax);
  }

  function updateQuantity(index, delta) {
    const currentCart = getCart();
    if (index < 0 || index >= currentCart.length) return;
    currentCart[index].quantity += delta;
    if (currentCart[index].quantity <= 0) {
      currentCart.splice(index, 1);
    }
    PosAudio.beep();
    renderCart();
    renderOrderTabs();
  }

  function removeFromCart(index) {
    const currentCart = getCart();
    if (index < 0 || index >= currentCart.length) return;
    currentCart.splice(index, 1);
    renderCart();
    renderOrderTabs();
  }

  function clearCart() {
    const currentCart = getCart();
    if (currentCart.length === 0) return;
    showConfirm('Clear Cart?', 'All items will be removed from cart.', 'Yes, Clear')
      .then(res => {
        if (res.isConfirmed) {
          getActiveTab().cart = [];
          getActiveTab().promoDiscount = 0;
          renderCart();
          renderOrderTabs();
          goToLevel(1);
          showToast('info', 'Cart cleared.');
        }
      });
  }

  // Mobile View Switcher for Handheld / Mobile POS Terminals
  function switchMobilePosView(view) {
    if (view === 'cart') {
      document.body.classList.remove('pos-mobile-mode-products');
      document.body.classList.add('pos-mobile-mode-cart');
      const tabP = document.getElementById('mTabProducts');
      const tabC = document.getElementById('mTabCart');
      if (tabP) tabP.classList.remove('active');
      if (tabC) tabC.classList.add('active');
      window.scrollTo({ top: 0, behavior: 'smooth' });
    } else {
      document.body.classList.remove('pos-mobile-mode-cart');
      document.body.classList.add('pos-mobile-mode-products');
      const tabP = document.getElementById('mTabProducts');
      const tabC = document.getElementById('mTabCart');
      if (tabP) tabP.classList.add('active');
      if (tabC) tabC.classList.remove('active');
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }
  }

  // Initialize mobile mode to products catalog by default
  document.body.classList.add('pos-mobile-mode-products');

  function renderCart() {
    const tbody = document.getElementById('cartTableRows');
    const emptyNotice = document.getElementById('cartEmptyNotice');
    const tableEl = document.getElementById('cartTableElement');
    const countBadge = document.getElementById('cartCountBadge');
    const mCartBadge = document.getElementById('mMobileCartBadge');
    const bCartCount = document.getElementById('bottomCartCount');
    const bCartBar = document.getElementById('posMobileBottomBar');
    const currentCart = getCart();

