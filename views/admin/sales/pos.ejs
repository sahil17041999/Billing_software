  // Complete Sale & Live Step-by-Step "Adding Bill" Message Overlay
  async function completeSale() {
    const currentCart = getCart();
    if (currentCart.length === 0) {
      PosAudio.error();
      showWarning('Empty Cart', 'Please add at least one product before checkout.');
      return;
    }

    const customerId = document.getElementById('customer_id').value || null;
    const paymentModeId = document.getElementById('payment_mode_id').value || null;
    const customerSelect = document.getElementById('customer_id');
    const customerName = customerSelect.options[customerSelect.selectedIndex]?.text || 'Walk-in Customer';
    
    const grandTotalStr = document.getElementById('grandTotal').textContent.replace('₹', '');
    const subtotalStr = document.getElementById('subtotal').textContent.replace('₹', '');
    const taxStr = document.getElementById('taxTotal').textContent.replace('₹', '');
    const subtotal = Number(subtotalStr) || 0;
    const taxTotal = Number(taxStr) || 0;
    const grandTotal = Number(grandTotalStr) || 0;
    const discount = Math.max(0, (subtotal + taxTotal) - grandTotal);

    const payload = {
      customer_id: customerId ? Number(customerId) : null,
      payment_mode_id: paymentModeId ? Number(paymentModeId) : null,
      discount_amount: discount,
      items: currentCart.map(item => ({
        product_id: item.product_id,
        name: item.name,
        quantity: item.quantity,
        unit_price: item.unit_price,
        tax_rate: item.tax_rate,
        discount_amount: 0,
        discount_percent: 0
      }))
    };

    const overlay = document.getElementById('posBillProcessingOverlay');
    const s1 = document.getElementById('pStep1');
    const s2 = document.getElementById('pStep2');
    const s3 = document.getElementById('pStep3');
    const s4 = document.getElementById('pStep4');

    // Reset steps
    [s1, s2, s3, s4].forEach(s => { s.className = 'pos-step-indicator-item'; });
    s1.className = 'pos-step-indicator-item active';
    overlay.classList.add('active');

    // Step 1: Validating stock
    await new Promise(r => setTimeout(r, 280));
    s1.className = 'pos-step-indicator-item completed';
    s2.className = 'pos-step-indicator-item active';

    // Step 2: Applying taxes
    await new Promise(r => setTimeout(r, 280));
    s2.className = 'pos-step-indicator-item completed';
    s3.className = 'pos-step-indicator-item active';

    try {
      const response = await fetch('/admin/sales', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify(payload)
      });

      const result = await response.json();
      if (!response.ok || !result.success) {
        throw new Error(result.error || 'Failed to complete sale');
      }

      s3.className = 'pos-step-indicator-item completed';
      s4.className = 'pos-step-indicator-item active';
      await new Promise(r => setTimeout(r, 220));
      s4.className = 'pos-step-indicator-item completed';

      overlay.classList.remove('active');
      PosAudio.success();

      const invoiceNum = result.invoice_number || 'N/A';
      const saleId = result.sale_id;
      const finalTotal = Number(result.grand_total || grandTotal).toFixed(2);

      activeInvoiceData = {
        saleId,
        invoiceNum,
        customerName,
        date: new Date().toLocaleString('en-IN'),
        items: [...currentCart],
        subtotal: subtotal.toFixed(2),
        tax: taxTotal.toFixed(2),
        discount: discount.toFixed(2),
        grandTotal: finalTotal
      };

      // Empty active cart immediately on successful bill creation
      const activeTab = getActiveTab();
      if (activeTab) {
        activeTab.cart = [];
        activeTab.customer_id = '';
        activeTab.customer_name = 'Walk-in Customer';
        activeTab.discount = 0;
        activeTab.deliveryCharge = 0;
        activeTab.packagingCharge = 0;
        activeTab.promoDiscount = 0;
        activeTab.notes = '';
      }
      
      const custSelect = document.getElementById('customer_id');
      if (custSelect) custSelect.value = '';
      const discInput = document.getElementById('discountInput');
      if (discInput) discInput.value = '0';
      const delInput = document.getElementById('extraDeliveryCharge');
      if (delInput) delInput.value = '0';
      const packInput = document.getElementById('extraPackagingCharge');
      if (packInput) packInput.value = '0';
      const notesInput = document.getElementById('invoice_notes');
      if (notesInput) notesInput.value = '';
      const promoBadge = document.getElementById('appliedPromoBadge');
      if (promoBadge) promoBadge.style.display = 'none';
      const promoInp = document.getElementById('promoCodeInput');
      if (promoInp) promoInp.value = '';
      
      calculateTotals();
      renderCart();
      renderOrderTabs();
      updateCustomerPreview();
      goToLevel(1);

      renderSuccessInvoice(activeInvoiceData);
      showToast('success', `🎉 Bill Added! Invoice #${invoiceNum} generated.`);

    } catch (err) {
      overlay.classList.remove('active');
      PosAudio.error();
      showError('Sale Error', err.message);
    }
  }

  function renderSuccessInvoice(data) {
    const area = document.getElementById('successInvoiceRenderArea');
    area.innerHTML = `
      <div style="text-align: center; margin-bottom: 16px;">
        <div class="pos-success-badge-pulse">
          <i class="ti ti-check"></i>
        </div>
        <h3 style="font-size: 20px; font-weight: 800; color: #0f172a; margin: 0;">TAX INVOICE GENERATED</h3>
        <p style="font-size: 12px; color: #64748b; margin-top: 2px;">GST Rule 46 Compliant Bill Generated Successfully</p>
      </div>

      <div style="display: flex; justify-content: space-between; border-bottom: 2px solid #0f172a; padding-bottom: 10px; margin-bottom: 12px;">
        <div>
          <div style="font-size: 13px; font-weight: 700; color: #0f172a;">Invoice Number</div>
          <span style="font-size: 15px; font-weight: 800; color: var(--pos-primary); font-family: var(--pos-font-mono);">#${data.invoiceNum}</span>
        </div>
        <div style="text-align: right;">
          <div style="font-size: 13px; font-weight: 700; color: #0f172a;">Billing Date &amp; Time</div>
          <div style="font-size: 12px; color: #64748b;">${data.date}</div>
        </div>
      </div>

      <div style="display: flex; justify-content: space-between; background: #f8fafc; padding: 8px 12px; border-radius: 6px; border: 1px solid #e2e8f0; margin-bottom: 12px; font-size: 12px;">
        <div><strong>Billed To:</strong> ${escapeHtml(data.customerName)}</div>
        <div style="color: #059669; font-weight: 700;">PAID &bull; COMPLETED</div>
      </div>

      <table style="width: 100%; border-collapse: collapse; font-size: 12px; margin-bottom: 12px;">
        <thead>
          <tr style="background: #f1f5f9; border-bottom: 1px solid #cbd5e1;">
            <th style="padding: 6px; text-align: left;">Item Description</th>
            <th style="padding: 6px; text-align: center;">Qty</th>
            <th style="padding: 6px; text-align: right;">Rate</th>
            <th style="padding: 6px; text-align: right;">Total</th>
          </tr>
        </thead>
        <tbody>
          ${data.items.map(item => `
            <tr style="border-bottom: 1px solid #f1f5f9;">
              <td style="padding: 6px;">${escapeHtml(item.name)}</td>
              <td style="padding: 6px; text-align: center;">${item.quantity}</td>
              <td style="padding: 6px; text-align: right;">₹${item.unit_price.toFixed(2)}</td>
              <td style="padding: 6px; text-align: right; font-weight: 700;">₹${(item.quantity * item.unit_price).toFixed(2)}</td>
            </tr>
          `).join('')}
        </tbody>
      </table>

      <div style="display: flex; justify-content: flex-end;">
        <div style="width: 220px; font-size: 12.5px;">
          <div style="display: flex; justify-content: space-between; padding: 2px 0;">
            <span style="color: #64748b;">Subtotal:</span>
            <span>₹${data.subtotal}</span>
          </div>
          <div style="display: flex; justify-content: space-between; padding: 2px 0;">
            <span style="color: #64748b;">GST:</span>
            <span>₹${data.tax}</span>
          </div>
          <div style="display: flex; justify-content: space-between; padding: 6px 0; border-top: 2px solid #0f172a; margin-top: 4px; font-size: 16px; font-weight: 800; color: var(--pos-primary);">
            <span>Grand Total:</span>
            <span>₹${data.grandTotal}</span>
          </div>
        </div>
      </div>
    `;

    document.getElementById('posInvoiceSuccessModal').classList.add('show');
  }

  function closeSuccessInvoiceModal() {
    document.getElementById('posInvoiceSuccessModal').classList.remove('show');
  }

  function closeSuccessInvoiceModalAndNext() {
    closeSuccessInvoiceModal();
    getActiveTab().cart = [];
    getActiveTab().promoDiscount = 0;
    document.getElementById('discountInput').value = 0;
    document.getElementById('tenderAmount').value = '';
    document.getElementById('promoCodeInput').value = '';
    document.getElementById('promoSuccessBadge').style.display = 'none';
    renderCart();
    renderOrderTabs();
    goToLevel(1);
    document.getElementById('searchInput').focus();
  }

  function printActiveInvoice(format) {
    if (!activeInvoiceData || !activeInvoiceData.saleId) return;
    window.open(`/admin/sales/invoice/${activeInvoiceData.saleId}?format=${format || 'a4'}`, '_blank');
  }

  function shareActiveInvoiceWhatsapp() {
    if (!activeInvoiceData) return;
    const msg = `Tax Invoice #${activeInvoiceData.invoiceNum}%0ATotal Amount: ₹${activeInvoiceData.grandTotal}%0ABilled to: ${activeInvoiceData.customerName}%0AThank you for shopping with us!`;
    window.open(`https://api.whatsapp.com/send?text=${msg}`, '_blank');
  }

  function emailActiveInvoice() {
    if (!activeInvoiceData || !activeInvoiceData.saleId) return;
    Swal.fire({
      title: `Email Invoice #${activeInvoiceData.invoiceNum}`,
      html: `<input type="email" id="posEmailInput" class="swal2-input" placeholder="e.g. customer@example.com" style="width:100%;">`,
      showCancelButton: true,
      confirmButtonText: 'Send Email'
    }).then(res => {
      if (res.isConfirmed) {
        const email = document.getElementById('posEmailInput').value.trim();
        if (email) {
          fetch(`/admin/sales/invoice/${activeInvoiceData.saleId}/email`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email })
          })
          .then(r => r.json())
          .then(d => showToast('success', d.message || 'Invoice emailed!'))
          .catch(() => showToast('error', 'Failed to send email'));
        }
      }
    });
  }

  // Search & Enter Auto-Add
  function filterCatalog() {
    const search = document.getElementById('searchInput').value.toLowerCase().trim();
    const cards = document.querySelectorAll('.product-card');

    cards.forEach(card => {
      const text = card.textContent.toLowerCase();
      const barcode = (card.dataset.barcode || '').toLowerCase();
      const sku = (card.dataset.sku || '').toLowerCase();
      const cat = (card.dataset.cat || '').toLowerCase();

      const matchesSearch = text.includes(search) || barcode.includes(search) || sku.includes(search);
      const matchesCat = (currentSelectedCategory === 'all' || cat === currentSelectedCategory);

      card.style.display = (matchesSearch && matchesCat) ? 'flex' : 'none';
    });
  }

  function selectCategory(cat, btn) {
    currentSelectedCategory = cat;
    document.querySelectorAll('.pos-cat-chip').forEach(b => b.classList.remove('active'));
    if (btn) btn.classList.add('active');
    filterCatalog();
  }

  document.getElementById('searchInput').addEventListener('keydown', async function(e) {
    if (e.key === 'Enter') {
      e.preventDefault();
      const query = this.value.trim();
      if (!query) return;

      const exactMatch = Array.from(document.querySelectorAll('.product-card')).find(c => 
        (c.dataset.barcode && c.dataset.barcode.toLowerCase() === query.toLowerCase()) ||
        (c.dataset.sku && c.dataset.sku.toLowerCase() === query.toLowerCase())
      );

      if (exactMatch) {
        addProductToCart(exactMatch);
        this.value = '';
        filterCatalog();
        return;
      }

      try {
        const res = await fetch(`/admin/sales/search/barcode?barcode=${encodeURIComponent(query)}`);
        const data = await res.json();
        if (res.ok && data.product) {
          const p = data.product;
          const taxRate = p.tax ? Number(p.tax.rate) : (p.Tax ? Number(p.Tax.rate) : 0);
          addToCart(p.id, p.name, Number(p.selling_price), taxRate);
          this.value = '';
          filterCatalog();
        } else {
          PosAudio.error();
          showWarning('Item Not Found', `No product found matching '${query}'.`);
        }
      } catch(err) {
        PosAudio.error();
      }
    }
  });

  // Global Fast Keyboard Shortcuts Engine for POS
  document.addEventListener('keydown', function(e) {
    const isInput = ['INPUT', 'TEXTAREA', 'SELECT'].includes(document.activeElement.tagName);

    // F2 or Ctrl+Enter -> Fast Invoice Creation / Print Bill
    if (e.key === 'F2' || ((e.ctrlKey || e.metaKey) && e.key === 'Enter')) {
      e.preventDefault();
      completeSale();
      return;
    }
    // F4 or / -> Focus Barcode / Search
    if (e.key === 'F4' || (e.key === '/' && !isInput)) {
      e.preventDefault();
      const searchInp = document.getElementById('searchInput');
      if (searchInp) { searchInp.focus(); searchInp.select(); }
      return;
    }
    // F6 -> Open New Order Cart Tab
    if (e.key === 'F6') {
      e.preventDefault();
      createNewOrderTab();
      return;
    }
    // F8 -> Quick Add Customer
    if (e.key === 'F8') {
      e.preventDefault();
      openPosCustomerModal();
      return;
    }
    // F9 -> Quick Cash & Auto Tender Exact
    if (e.key === 'F9') {
      e.preventDefault();
      const pmSelect = document.getElementById('payment_mode_id');
      if (pmSelect) {
        Array.from(pmSelect.options).forEach(opt => {
          if (opt.text.toLowerCase().includes('cash')) pmSelect.value = opt.value;
        });
      }
      setTender('exact');
      showToast('info', '💵 Payment set to Cash (Exact Tender)');
      return;
    }
    // F10 -> Quick UPI / QR Payment
    if (e.key === 'F10') {
      e.preventDefault();
      const pmSelect = document.getElementById('payment_mode_id');
      if (pmSelect) {
        Array.from(pmSelect.options).forEach(opt => {
          if (opt.text.toLowerCase().includes('upi') || opt.text.toLowerCase().includes('qr') || opt.text.toLowerCase().includes('online')) pmSelect.value = opt.value;
        });
      }
      setTender('exact');
      showToast('info', '📱 Payment set to UPI / QR');
      return;
    }
  });

  function escapeHtml(str) {
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  // Initial Run
  renderOrderTabs();
  calculateTotals();
  renderCart();
  goToLevel(1);
</script>

</body>
</html>