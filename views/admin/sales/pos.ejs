                <input type="number" id="editLineQty" name="editLineQty" class="form-control-modern" min="1" step="1" required />
              </div>
              <div>
                <label style="font-size: 12px; font-weight: 700; color: var(--text-muted);">Price (₹):</label>
                <input type="number" id="editLinePrice" name="editLinePrice" class="form-control-modern" min="0" step="0.01" required />
