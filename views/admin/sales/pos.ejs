          <h5 style="margin: 0; font-size: 16px; font-weight: 800;"><i class="ti ti-plus" style="color: var(--success);"></i> Add New Product to Catalog</h5>
          <button type="button" class="btn-close" onclick="closeModal('addNewProductModal')" style="border: none; background: transparent; font-size: 20px; cursor: pointer;">&times;</button>
        </div>
        <form id="newProductForm" novalidate>
          <div class="modal-body" style="padding: 18px; display: flex; flex-direction: column; gap: 12px; max-height: 75vh; overflow-y: auto;">
            <div>
              <label style="font-size: 12px; font-weight: 700; color: var(--text-muted);">Product Name <span style="color: #ef4444;">*</span></label>
              <input type="text" id="np_name" name="name" class="form-control-modern" placeholder="e.g. Premium Basmati Rice 5kg" required />
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 10px;">
              <div>
                <label style="font-size: 12px; font-weight: 700; color: var(--text-muted);">Category <span style="color: #ef4444;">*</span></label>
                <select id="np_category_id" name="category_id" class="form-control-modern" required>
                  <option value="">Select Category</option>
                  <% (categories || []).forEach(cat => { %>
                    <option value="<%= cat.id %>"><%= cat.name %></option>
                  <% }) %>
                </select>
              </div>
              <div>
                <label style="font-size: 12px; font-weight: 700; color: var(--text-muted);">Unit <span style="color: #ef4444;">*</span></label>
                <select id="np_unit_id" name="unit_id" class="form-control-modern" required>
                  <option value="">Select Unit</option>
                  <% (units || []).forEach(u => { %>
                    <option value="<%= u.id %>"><%= u.name %> (<%= u.code || u.name %>)</option>
                  <% }) %>
                </select>
              </div>
              <div>
                <label style="font-size: 12px; font-weight: 700; color: var(--text-muted);">GST Tax Rate</label>
                <select id="np_tax_id" name="tax_id" class="form-control-modern">
                  <% (taxes || []).forEach(t => { %>
                    <option value="<%= t.id %>"><%= t.name %> (<%= t.rate %>%)</option>
                  <% }) %>
                </select>
              </div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
              <div>
                <label style="font-size: 12px; font-weight: 700; color: var(--text-muted);">Selling Price (₹ / $) <span style="color: #ef4444;">*</span></label>
                <input type="number" id="np_selling_price" name="selling_price" class="form-control-modern" placeholder="0.00" step="0.01" min="0.01" required />
              </div>
              <div>
                <label style="font-size: 12px; font-weight: 700; color: var(--text-muted);">Purchase Price (₹ / $) <span style="color: #ef4444;">*</span></label>
                <input type="number" id="np_purchase_price" name="purchase_price" class="form-control-modern" placeholder="0.00" step="0.01" min="0" required />
              </div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1.2fr; gap: 12px;">
              <div>
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2px;">
                  <label style="font-size: 12px; font-weight: 700; color: var(--text-muted);">Item SKU / Code</label>
                  <button type="button" onclick="generateNewProductSku()" style="background: none; border: none; color: var(--primary); font-size: 11px; font-weight: 700; cursor: pointer; padding: 0;">Auto SKU</button>
                </div>
                <input type="text" id="np_sku" name="sku" class="form-control-modern" placeholder="e.g. SKU-1001" />
              </div>
              <div>
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2px;">
                  <label style="font-size: 12px; font-weight: 700; color: var(--text-muted);">Barcode <span style="font-size: 10.5px; color: #64748b; font-weight: normal;">(Optional)</span></label>
                  <button type="button" onclick="generateNewProductBarcode()" style="background: none; border: none; color: var(--primary); font-size: 11px; font-weight: 700; cursor: pointer; padding: 0;">
                    <i class="ti ti-wand"></i> Auto Gen
                  </button>
                </div>
                <div style="display: flex; gap: 6px;">
                  <input type="text" id="np_barcode" name="barcode" class="form-control-modern" placeholder="Scan or type barcode (Optional)" oninput="renderBarcodeVisual(this.value)" style="font-family: monospace;" />
                  <button type="button" class="btn-modern btn-secondary-modern" onclick="generateNewProductBarcode()" title="Generate Barcode" style="padding: 0 10px; font-size: 11px; white-space: nowrap;">
                    <i class="ti ti-barcode"></i> Gen
                  </button>
                </div>
                <!-- Live Barcode Visual Preview -->
                <div id="npBarcodeVisualPreview" style="margin-top: 6px; padding: 4px 10px; background: #f8fafc; border: 1px dashed #cbd5e1; border-radius: 6px; display: flex; align-items: center; justify-content: space-between; min-height: 32px;">
                  <div id="npBarcodeSvgContainer" style="display: flex; align-items: flex-end; gap: 2px; height: 22px;"></div>
                  <span id="npBarcodeCodeDisplay" style="font-family: var(--font-mono); font-size: 10.5px; font-weight: 700; color: #475569;">No Barcode</span>
                </div>
              </div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
              <div>
                <label style="font-size: 12px; font-weight: 700; color: var(--text-muted);">Initial Stock Quantity</label>
                <input type="number" id="np_initial_stock" name="initial_stock" class="form-control-modern" value="100" min="0" />
              </div>
              <div>
                <label style="font-size: 12px; font-weight: 700; color: var(--text-muted);">Brand</label>
                <select id="np_brand_id" name="brand_id" class="form-control-modern">
                  <option value="">No Brand (Generic)</option>
                  <% (brands || []).forEach(b => { %>
                    <option value="<%= b.id %>"><%= b.name %></option>
                  <% }) %>
                </select>
              </div>
            </div>
          </div>
          <div class="modal-footer" style="background: #f8fafc; border-top: 1px solid var(--border-color); padding: 12px 18px; display: flex; justify-content: flex-end; gap: 8px;">
            <button type="submit" class="btn-modern btn-success-modern">
              <i class="ti ti-check"></i>
              <span>Save &amp; Add to Bill</span>
            </button>
            <button type="button" class="btn-modern btn-secondary-modern" onclick="closeModal('addNewProductModal')">Cancel</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- 5. EDIT SELECTED LINE MODAL -->
  <div class="modal fade" id="editLineModal" tabindex="-1" style="display: none; background: rgba(15,23,42,0.6); position: fixed; inset: 0; z-index: 1060; align-items: center; justify-content: center;">
    <div class="modal-dialog" style="max-width: 440px; width: 100%; margin: 20px;">
      <div class="modal-content" style="background: #fff; border-radius: var(--radius-md); box-shadow: var(--shadow-xl); overflow: hidden;">
        <div class="modal-header" style="background: #f8fafc; border-bottom: 1px solid var(--border-color); padding: 12px 18px; display: flex; align-items: center; justify-content: space-between;">
          <h5 style="margin: 0; font-size: 15px; font-weight: 800;"><i class="ti ti-edit" style="color: var(--primary);"></i> Edit Selected Line</h5>
          <button type="button" class="btn-close" onclick="closeModal('editLineModal')" style="border: none; background: transparent; font-size: 18px; cursor: pointer;">&times;</button>
        </div>
        <form id="editLineForm" novalidate onsubmit="saveEditedLine(event)">
