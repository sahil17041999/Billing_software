       ========================================================================= -->

  <!-- 1. CUSTOMER LOOKUP MODAL -->
  <div class="modal fade" id="customerSelectModal" tabindex="-1" style="display: none; background: rgba(15,23,42,0.6); position: fixed; inset: 0; z-index: 1060; align-items: center; justify-content: center;">
    <div class="modal-dialog" style="max-width: 720px; width: 100%; margin: 20px;">
      <div class="modal-content" style="background: #fff; border-radius: var(--radius-md); box-shadow: var(--shadow-xl); overflow: hidden;">
        <div class="modal-header" style="background: #f8fafc; border-bottom: 1px solid var(--border-color); padding: 14px 18px; display: flex; align-items: center; justify-content: space-between;">
          <h5 style="margin: 0; font-size: 16px; font-weight: 800;"><i class="ti ti-users" style="color: var(--primary);"></i> Select Customer</h5>
          <button type="button" class="btn-close" onclick="closeModal('customerSelectModal')" style="border: none; background: transparent; font-size: 20px; cursor: pointer;">&times;</button>
        </div>
        <div class="modal-body" style="padding: 18px;">
          <div style="display: flex; gap: 8px; margin-bottom: 14px;">
            <input type="text" id="custSearchInput" class="form-control-modern" placeholder="Search by customer name, phone, email, or city..." oninput="filterCustomerList()" />
            <button type="button" class="btn-modern btn-success-modern btn-sm-modern" onclick="openAddNewCustomerModal()">
              <i class="ti ti-user-plus"></i> New Customer
            </button>
          </div>
          <div style="border: 1px solid var(--border-color); border-radius: 6px; max-height: 320px; overflow-y: auto;">
            <table class="pos-grid-table">
              <thead>
                <tr>
                  <th style="width: 60px;">ID</th>
                  <th>Customer Name</th>
                  <th>Phone</th>
                  <th>Email</th>
                  <th>City</th>
                  <th style="width: 85px; text-align: center;">Action</th>
                </tr>
              </thead>
              <tbody id="customerTableBody">
                <!-- Customer items -->
              </tbody>
            </table>
          </div>
        </div>
        <div class="modal-footer" style="background: #f8fafc; border-top: 1px solid var(--border-color); padding: 10px 18px; display: flex; justify-content: flex-end;">
          <button type="button" class="btn-modern btn-secondary-modern" onclick="closeModal('customerSelectModal')">Close</button>
        </div>
      </div>
    </div>
  </div>

  <!-- 2. ADD NEW CUSTOMER PROPER MODAL (With jQuery Validation) -->
  <div class="modal fade" id="addNewCustomerModal" tabindex="-1" style="display: none; background: rgba(15,23,42,0.6); position: fixed; inset: 0; z-index: 1070; align-items: center; justify-content: center;">
    <div class="modal-dialog" style="max-width: 640px; width: 100%; margin: 20px;">
      <div class="modal-content" style="background: #fff; border-radius: var(--radius-md); box-shadow: var(--shadow-xl); overflow: hidden;">
        <div class="modal-header" style="background: #f8fafc; border-bottom: 1px solid var(--border-color); padding: 14px 18px; display: flex; align-items: center; justify-content: space-between;">
          <h5 style="margin: 0; font-size: 16px; font-weight: 800;"><i class="ti ti-user-plus" style="color: var(--success);"></i> Add New Customer</h5>
          <button type="button" class="btn-close" onclick="closeModal('addNewCustomerModal')" style="border: none; background: transparent; font-size: 20px; cursor: pointer;">&times;</button>
        </div>
        <form id="newCustomerForm" novalidate>
          <div class="modal-body" style="padding: 18px; display: flex; flex-direction: column; gap: 12px; max-height: 75vh; overflow-y: auto;">
            <div style="display: grid; grid-template-columns: 1.5fr 1fr; gap: 12px;">
              <div>
                <label style="font-size: 12px; font-weight: 700; color: var(--text-muted);">Customer Full Name <span style="color: #ef4444;">*</span></label>
                <input type="text" id="nc_name" name="name" class="form-control-modern" placeholder="e.g. Acme Enterprises / Rahul Sharma" required />
              </div>
              <div>
                <label style="font-size: 12px; font-weight: 700; color: var(--text-muted);">Mobile Phone</label>
                <input type="text" id="nc_phone" name="phone" class="form-control-modern" placeholder="10-digit Indian Mobile" maxlength="10" />
              </div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
              <div>
                <label style="font-size: 12px; font-weight: 700; color: var(--text-muted);">Email Address</label>
                <input type="email" id="nc_email" name="email" class="form-control-modern" placeholder="customer@example.com" />
              </div>
              <div>
                <label style="font-size: 12px; font-weight: 700; color: var(--text-muted);">GSTIN Number</label>
                <input type="text" id="nc_gstin" name="gstin" class="form-control-modern" placeholder="15-digit GSTIN (optional)" maxlength="15" style="text-transform: uppercase;" />
              </div>
            </div>

            <div>
              <label style="font-size: 12px; font-weight: 700; color: var(--text-muted);">Street Address</label>
              <textarea id="nc_address" name="address" class="form-control-modern" style="height: 52px; resize: none;" placeholder="Shop / Building, Street, Area"></textarea>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 10px;">
              <div>
                <label style="font-size: 12px; font-weight: 700; color: var(--text-muted);">City</label>
                <input type="text" id="nc_city" name="city" class="form-control-modern" placeholder="City" />
              </div>
              <div>
                <label style="font-size: 12px; font-weight: 700; color: var(--text-muted);">State</label>
                <input type="text" id="nc_state" name="state" class="form-control-modern" placeholder="State" />
              </div>
              <div>
                <label style="font-size: 12px; font-weight: 700; color: var(--text-muted);">Postal Code</label>
                <input type="text" id="nc_postal_code" name="postal_code" class="form-control-modern" placeholder="6-digit Pincode" maxlength="6" />
              </div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
              <div>
                <label style="font-size: 12px; font-weight: 700; color: var(--text-muted);">Customer Type</label>
                <select id="nc_customer_type" name="customer_type" class="form-control-modern">
                  <option value="retail" selected>Retail Customer</option>
                  <option value="wholesale">Wholesale / B2B</option>
                </select>
              </div>
              <div>
                <label style="font-size: 12px; font-weight: 700; color: var(--text-muted);">Credit Limit (₹)</label>
                <input type="number" id="nc_credit_limit" name="credit_limit" class="form-control-modern" value="0.00" step="100" min="0" />
              </div>
            </div>
          </div>
          <div class="modal-footer" style="background: #f8fafc; border-top: 1px solid var(--border-color); padding: 12px 18px; display: flex; justify-content: flex-end; gap: 8px;">
            <button type="submit" class="btn-modern btn-success-modern">
              <i class="ti ti-check"></i>
              <span>Save &amp; Select Customer</span>
            </button>
            <button type="button" class="btn-modern btn-secondary-modern" onclick="closeModal('addNewCustomerModal')">Cancel</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- 2B. COMPREHENSIVE PRODUCT BARCODE SCANNER MODAL -->
  <div class="modal fade" id="productScanModal" tabindex="-1" style="display: none; background: rgba(15,23,42,0.75); position: fixed; inset: 0; z-index: 1070; align-items: center; justify-content: center; backdrop-filter: blur(4px);">
    <div class="modal-dialog" style="max-width: 600px; width: 100%; margin: 20px;">
      <div class="modal-content" style="background: #ffffff; border-radius: 14px; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25); overflow: hidden; border: 1px solid #e2e8f0;">
        
        <!-- Header -->
        <div class="modal-header" style="background: #0f172a; color: #ffffff; padding: 14px 18px; display: flex; align-items: center; justify-content: space-between;">
          <div style="display: flex; align-items: center; gap: 8px;">
            <i class="ti ti-scan" style="color: #38bdf8; font-size: 22px;"></i>
            <h5 style="margin: 0; font-size: 15px; font-weight: 800; color: #ffffff;">Product Barcode Scanner</h5>
            <span id="scanCamStatusBadge" class="badge-modern success" style="font-size: 10px; background: #166534; color: #bbf7d0;">
              <i class="ti ti-check"></i> Scanner Ready
            </span>
          </div>
          <button type="button" class="btn-close" onclick="closeProductScanModal()" style="border: none; background: transparent; font-size: 20px; color: #94a3b8; cursor: pointer;">&times;</button>
        </div>

        <div class="modal-body" style="padding: 16px;">
          <!-- 3-Way Scanner Mode Tabs -->
          <div style="display: flex; gap: 6px; margin-bottom: 14px; border-bottom: 1.5px solid #e2e8f0; padding-bottom: 10px;">
            <button type="button" class="btn-modern btn-sm-modern active" id="tabBtnHandheldScan" onclick="switchScannerTab('handheld')" style="font-weight: 700;">
              <i class="ti ti-barcode"></i> Handheld / USB Scanner
            </button>
            <button type="button" class="btn-modern btn-sm-modern" id="tabBtnCameraScan" onclick="switchScannerTab('camera')" style="font-weight: 700; background: #f1f5f9; color: #475569;">
              <i class="ti ti-camera"></i> Camera / Webcam
            </button>
            <button type="button" class="btn-modern btn-sm-modern" id="tabBtnImageScan" onclick="switchScannerTab('image')" style="font-weight: 700; background: #f1f5f9; color: #475569;">
              <i class="ti ti-photo"></i> Upload Image
            </button>
          </div>

          <!-- Quantity Multiplier Bar (Applies to all modes) -->
          <div style="display: flex; justify-content: space-between; align-items: center; background: #f8fafc; padding: 8px 12px; border-radius: 8px; margin-bottom: 14px; border: 1px solid #e2e8f0;">
            <span style="font-size: 12px; font-weight: 700; color: #334155;">
              <i class="ti ti-layers-subtract"></i> Scan Quantity Multiplier:
            </span>
            <div style="display: flex; gap: 6px; align-items: center;">
              <button type="button" class="btn-modern btn-sm-modern" onclick="setScanMultiplier(1, this)" style="padding: 2px 8px; font-weight: 700; background: #2563eb; color: #fff;">1x</button>
              <button type="button" class="btn-modern btn-sm-modern" onclick="setScanMultiplier(2, this)" style="padding: 2px 8px; font-weight: 700; background: #e2e8f0; color: #334155;">2x</button>
              <button type="button" class="btn-modern btn-sm-modern" onclick="setScanMultiplier(3, this)" style="padding: 2px 8px; font-weight: 700; background: #e2e8f0; color: #334155;">3x</button>
              <button type="button" class="btn-modern btn-sm-modern" onclick="setScanMultiplier(5, this)" style="padding: 2px 8px; font-weight: 700; background: #e2e8f0; color: #334155;">5x</button>
              <button type="button" class="btn-modern btn-sm-modern" onclick="setScanMultiplier(10, this)" style="padding: 2px 8px; font-weight: 700; background: #e2e8f0; color: #334155;">10x</button>
              <input type="hidden" id="activeScanQtyMultiplier" value="1" />
            </div>
          </div>

          <!-- TAB 1: HANDHELD SCANNER & RAPID INPUT (ACTIVE BY DEFAULT, ZERO PERMISSIONS REQUIRED) -->
          <div id="scannerTabPaneHandheld" style="display: block;">
            <div style="text-align: center; padding: 18px 14px; background: #f0fdf4; border: 2px dashed #86efac; border-radius: 12px; margin-bottom: 14px;">
              <i class="ti ti-scan" style="font-size: 42px; color: #16a34a; display: block; margin-bottom: 6px;"></i>
              <div style="font-size: 14px; font-weight: 800; color: #15803d; margin-bottom: 2px;">
                Ready to Scan with Handheld Laser/USB Gun
              </div>
              <div style="font-size: 11.5px; color: #475569; margin-bottom: 12px;">
                Point your scanner gun at any barcode, or type product digits and press Enter
              </div>

              <div style="display: flex; gap: 8px; max-width: 440px; margin: 0 auto;">
                <div style="position: relative; flex: 1;">
                  <i class="ti ti-barcode" style="position: absolute; left: 12px; top: 11px; font-size: 20px; color: #2563eb;"></i>
                  <input type="text" id="handheldScanInput" class="form-control-modern" 
                         placeholder="Scan barcode or type code..." 
                         style="height: 44px; padding-left: 40px; font-size: 15px; font-weight: 700; border-color: #2563eb;" 
                         onkeydown="if(event.key==='Enter') executeHandheldModalScan()" autofocus />
                </div>
                <button type="button" class="btn-modern btn-primary-modern" onclick="executeHandheldModalScan()" style="height: 44px; padding: 0 18px; font-weight: 700;">
                  <i class="ti ti-plus"></i> Add
                </button>
              </div>
            </div>
          </div>

          <!-- TAB 2: CAMERA / WEBCAM SCANNER -->
          <div id="scannerTabPaneCamera" style="display: none;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
              <select id="cameraSourceSelect" class="form-control-modern" style="max-width: 220px; height: 32px; padding: 2px 8px; font-size: 11.5px;" onchange="switchCameraSource(this.value)">
                <option value="">Default Camera</option>
              </select>
              <button type="button" id="btnToggleCameraFeed" class="btn-modern btn-primary-modern btn-sm-modern" onclick="toggleCameraScanning()" style="height: 32px; font-size: 12px; padding: 0 12px;">
                <i class="ti ti-camera"></i> <span>Turn On Camera</span>
              </button>
            </div>

            <!-- Video Viewport / Scanner Target -->
            <div class="scanner-viewport-box" id="scannerViewportBox">
              <div id="html5QrCodeReader" style="width: 100%; height: 100%;"></div>
              <div class="scanner-target-guide" id="scannerTargetGuide" style="display: none;">
                <div class="scanner-laser-line"></div>
              </div>
              <!-- Camera Idle / Permission State Box -->
              <div id="cameraPlaceholderNotice" style="position: absolute; text-align: center; color: #ffffff; padding: 20px; z-index: 1;">
                <i class="ti ti-camera" style="font-size: 38px; color: #38bdf8; display: block; margin-bottom: 8px;"></i>
                <div style="font-size: 14px; font-weight: 700; color: #f8fafc; margin-bottom: 4px;">Camera Barcode Scanner</div>
                <div style="font-size: 11.5px; color: #94a3b8; margin-bottom: 12px;">Click below to grant camera permission and scan via webcam</div>
                <button type="button" class="btn-modern btn-primary-modern btn-sm-modern" onclick="startCameraScanning()" style="font-weight: 700; padding: 6px 16px;">
                  <i class="ti ti-video"></i> Start Camera Scanner
                </button>
              </div>

              <!-- Camera Blocked Help Guide (Shown if permission denied) -->
              <div id="cameraPermissionDeniedBox" style="display: none; position: absolute; inset: 0; background: #0f172a; color: #ffffff; padding: 18px; text-align: center; z-index: 5; flex-direction: column; align-items: center; justify-content: center;">
                <i class="ti ti-lock-access" style="font-size: 36px; color: #f59e0b; margin-bottom: 6px;"></i>
                <div style="font-size: 13.5px; font-weight: 800; color: #f8fafc; margin-bottom: 4px;">Camera Permission Blocked in Browser</div>
                <div style="font-size: 11.5px; color: #cbd5e1; max-width: 380px; line-height: 1.4; margin-bottom: 12px;">
                  1. Click the <strong>🔒 Lock</strong> icon beside <code style="background:#1e293b; padding:2px 4px; border-radius:4px;">localhost:3000</code> in your URL bar.<br>
                  2. Set <strong>Camera</strong> to <strong>"Allow"</strong>.<br>
                  3. Click <strong>"Retry Camera"</strong> below.
                </div>
                <div style="display: flex; gap: 8px;">
                  <button type="button" class="btn-modern btn-primary-modern btn-sm-modern" onclick="startCameraScanning()">
                    <i class="ti ti-refresh"></i> Retry Camera
                  </button>
                  <button type="button" class="btn-modern btn-secondary-modern btn-sm-modern" onclick="switchScannerTab('handheld')" style="color: #ffffff; border-color: #475569;">
                    <i class="ti ti-barcode"></i> Use Handheld / USB Scanner
                  </button>
                </div>
              </div>
            </div>
          </div>

          <!-- TAB 3: UPLOAD BARCODE IMAGE / PHOTO -->
          <div id="scannerTabPaneImage" style="display: none;">
            <div style="border: 2px dashed #cbd5e1; border-radius: 12px; padding: 24px 16px; text-align: center; background: #f8fafc;">
              <i class="ti ti-photo" style="font-size: 38px; color: #4f46e5; display: block; margin-bottom: 6px;"></i>
              <div style="font-size: 13.5px; font-weight: 800; color: #1e293b; margin-bottom: 4px;">Scan Barcode from Photo or Image</div>
              <div style="font-size: 11.5px; color: #64748b; margin-bottom: 14px;">Select any picture of a barcode sticker or product label</div>
              <input type="file" id="barcodeImageFileInput" accept="image/*" style="display: none;" onchange="handleBarcodeImageFile(this)">
              <button type="button" class="btn-modern btn-primary-modern btn-sm-modern" onclick="document.getElementById('barcodeImageFileInput').click()" style="font-weight: 700;">
                <i class="ti ti-upload"></i> Browse Barcode Photo
              </button>
            </div>
          </div>

          <!-- Last Scanned Confirmation Alert -->
          <div id="lastScannedFeedback" style="display: none; margin-top: 12px; padding: 10px 14px; background: #ecfdf5; border: 1.5px solid #10b981; border-radius: 8px; align-items: center; justify-content: space-between;">
            <div style="display: flex; align-items: center; gap: 8px;">
              <i class="ti ti-circle-check" style="color: #10b981; font-size: 22px;"></i>
              <div>
                <div style="font-size: 12.5px; font-weight: 800; color: #065f46;" id="lastScannedName">Scanned Product</div>
                <div style="font-size: 11px; color: #047857;" id="lastScannedDetails">Added to current invoice bill</div>
              </div>
            </div>
            <span class="badge-modern success" style="font-size: 11px; font-weight: 800;" id="lastScannedQtyBadge">+1 Added</span>
          </div>

        </div>

        <div class="modal-footer" style="background: #f8fafc; border-top: 1px solid #e2e8f0; padding: 12px 18px; display: flex; justify-content: space-between; align-items: center;">
          <div style="font-size: 11px; color: #64748b;">
            <i class="ti ti-check"></i> Scanned items add automatically to bill in real-time
          </div>
          <button type="button" class="btn-modern btn-secondary-modern" onclick="closeProductScanModal()">
            Done Scanning
          </button>
        </div>

      </div>
    </div>
  </div>

  <!-- 3. PRODUCT CATALOG LOOKUP MODAL (WITH MULTI-PRODUCT SELECTION) -->
  <div class="modal fade" id="productSelectModal" tabindex="-1" style="display: none; background: rgba(15,23,42,0.6); position: fixed; inset: 0; z-index: 1060; align-items: center; justify-content: center;">
    <div class="modal-dialog" style="max-width: 840px; width: 100%; margin: 20px;">
      <div class="modal-content" style="background: #fff; border-radius: var(--radius-md); box-shadow: var(--shadow-xl); overflow: hidden;">
        <div class="modal-header" style="background: #f8fafc; border-bottom: 1px solid var(--border-color); padding: 14px 18px; display: flex; align-items: center; justify-content: space-between;">
          <div style="display: flex; align-items: center; gap: 8px;">
            <h5 style="margin: 0; font-size: 16px; font-weight: 800;"><i class="ti ti-package" style="color: var(--primary);"></i> Product Catalog &bull; Multi-Product Picker</h5>
            <span class="badge-modern primary" style="font-size: 10px;">Select multiple items below</span>
          </div>
          <button type="button" class="btn-close" onclick="closeModal('productSelectModal')" style="border: none; background: transparent; font-size: 20px; cursor: pointer;">&times;</button>
        </div>
        <div class="modal-body" style="padding: 18px;">
          <div style="display: flex; gap: 8px; margin-bottom: 14px; flex-wrap: wrap;">
            <input type="text" id="productSearchInput" class="form-control-modern" placeholder="Search product name, SKU, or barcode..." oninput="filterProductList()" style="flex: 1; min-width: 220px;" />
            <select id="productCategoryFilter" class="form-control-modern" style="max-width: 190px;" onchange="filterProductList()">
              <option value="">All Categories</option>
              <% (categories || []).forEach(cat => { %>
                <option value="<%= cat.id %>"><%= cat.name %></option>
              <% }) %>
            </select>
            <button type="button" class="btn-modern btn-success-modern btn-sm-modern" onclick="openAddNewProductModal()">
              <i class="ti ti-plus"></i> New Product
            </button>
          </div>

          <!-- Quick Multi-Add Instruction Banner -->
          <div style="background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 6px; padding: 6px 12px; margin-bottom: 10px; font-size: 11.5px; color: #1e40af; display: flex; align-items: center; justify-content: space-between;">
            <span><i class="ti ti-info-circle"></i> Check items below and set quantity to add multiple products in one click, or use <strong>+ Add</strong> for 1-click single addition.</span>
            <span id="multiSelectCounterBadge" style="font-weight: 800; background: #2563eb; color: #fff; padding: 2px 8px; border-radius: 4px;">0 Selected</span>
          </div>

          <div style="border: 1px solid var(--border-color); border-radius: 6px; max-height: 350px; overflow-y: auto;">
            <table class="pos-grid-table">
              <thead>
                <tr>
                  <th style="width: 36px; text-align: center;">
                    <input type="checkbox" id="selectAllProductsCheck" onchange="toggleSelectAllProducts(this.checked)" title="Select All Items" />
                  </th>
                  <th style="width: 110px;">SKU / Code</th>
                  <th>Product Description</th>
                  <th style="width: 90px; text-align: right;">Price</th>
                  <th style="width: 65px; text-align: center;">Tax</th>
                  <th style="width: 105px; text-align: center;">Qty to Add</th>
                  <th style="width: 80px; text-align: center;">Action</th>
                </tr>
              </thead>
              <tbody id="productTableBody">
                <!-- Dynamic rows rendered with checkboxes and quantity steppers -->
              </tbody>
            </table>
          </div>
        </div>
        <div class="modal-footer" style="background: #f8fafc; border-top: 1px solid var(--border-color); padding: 10px 18px; display: flex; justify-content: space-between; align-items: center;">
          <div style="font-size: 12px; color: #475569; font-weight: 600;">
            <span id="multiSelectSummaryText">No products checked</span>
          </div>
          <div style="display: flex; gap: 8px;">
