  <!-- 6. CALCULATOR MODAL -->
  <div class="modal fade" id="desktopCalculatorModal" tabindex="-1" style="display: none; background: rgba(15,23,42,0.6); position: fixed; inset: 0; z-index: 1060; align-items: center; justify-content: center;">
    <div class="modal-dialog" style="max-width: 320px; width: 100%; margin: 20px;">
      <div class="modal-content" style="background: #fff; border-radius: var(--radius-md); box-shadow: var(--shadow-xl); overflow: hidden;">
        <div class="modal-header" style="background: #f8fafc; border-bottom: 1px solid var(--border-color); padding: 10px 16px; display: flex; align-items: center; justify-content: space-between;">
          <h5 style="margin: 0; font-size: 14px; font-weight: 800;"><i class="ti ti-calculator" style="color: var(--primary);"></i> Calculator</h5>
          <button type="button" class="btn-close" onclick="closeModal('desktopCalculatorModal')" style="border: none; background: transparent; font-size: 18px; cursor: pointer;">&times;</button>
        </div>
        <div class="modal-body" style="padding: 14px;">
          <div class="calc-box-display" id="calcDisplay">0</div>
          <div class="calc-btn-grid">
            <button type="button" class="btn-modern btn-secondary-modern" onclick="calcClear()">C</button>
            <button type="button" class="btn-modern btn-secondary-modern" onclick="calcBackspace()">⌫</button>
            <button type="button" class="btn-modern btn-secondary-modern" onclick="calcPercent()">%</button>
            <button type="button" class="btn-modern btn-primary-modern" onclick="calcOp('/')">÷</button>

            <button type="button" class="btn-modern btn-secondary-modern" onclick="calcNum('7')">7</button>
            <button type="button" class="btn-modern btn-secondary-modern" onclick="calcNum('8')">8</button>
            <button type="button" class="btn-modern btn-secondary-modern" onclick="calcNum('9')">9</button>
            <button type="button" class="btn-modern btn-primary-modern" onclick="calcOp('*')">×</button>

            <button type="button" class="btn-modern btn-secondary-modern" onclick="calcNum('4')">4</button>
            <button type="button" class="btn-modern btn-secondary-modern" onclick="calcNum('5')">5</button>
            <button type="button" class="btn-modern btn-secondary-modern" onclick="calcNum('6')">6</button>
            <button type="button" class="btn-modern btn-primary-modern" onclick="calcOp('-')">-</button>

            <button type="button" class="btn-modern btn-secondary-modern" onclick="calcNum('1')">1</button>
            <button type="button" class="btn-modern btn-secondary-modern" onclick="calcNum('2')">2</button>
            <button type="button" class="btn-modern btn-secondary-modern" onclick="calcNum('3')">3</button>
            <button type="button" class="btn-modern btn-primary-modern" onclick="calcOp('+')">+</button>

            <button type="button" class="btn-modern btn-secondary-modern" onclick="calcNum('0')">0</button>
            <button type="button" class="btn-modern btn-secondary-modern" onclick="calcNum('.')">.</button>
            <button type="button" class="btn-modern btn-success-modern" style="grid-column: span 2;" onclick="calcEquals()">=</button>
          </div>
          <div style="margin-top: 10px; display: flex; gap: 6px;">
            <button type="button" class="btn-modern btn-secondary-modern btn-sm-modern" style="flex: 1;" onclick="pasteCalcResult('payments')">Paste Payment</button>
            <button type="button" class="btn-modern btn-secondary-modern btn-sm-modern" style="flex: 1;" onclick="pasteCalcResult('discount')">Paste Discount</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- 7. EDIT PAYMENTS & DYNAMIC UPI QR MODAL -->
  <div class="modal fade" id="paymentModal" tabindex="-1" style="display: none; background: rgba(15,23,42,0.6); position: fixed; inset: 0; z-index: 1060; align-items: center; justify-content: center;">
    <div class="modal-dialog" style="max-width: 520px; width: 100%; margin: 20px;">
      <div class="modal-content" style="background: #fff; border-radius: var(--radius-md); box-shadow: var(--shadow-xl); overflow: hidden;">
        <div class="modal-header" style="background: #f8fafc; border-bottom: 1px solid var(--border-color); padding: 14px 18px; display: flex; align-items: center; justify-content: space-between;">
          <h5 style="margin: 0; font-size: 15px; font-weight: 800;"><i class="ti ti-credit-card" style="color: var(--primary);"></i> Payment Settlement &amp; UPI QR</h5>
          <button type="button" class="btn-close" onclick="closeModal('paymentModal')" style="border: none; background: transparent; font-size: 18px; cursor: pointer;">&times;</button>
        </div>
        <div class="modal-body" style="padding: 18px; display: flex; flex-direction: column; gap: 14px;">
          <div>
            <label style="font-size: 12px; font-weight: 700; color: var(--text-muted);">Payment Mode:</label>
            <select id="payment_mode_id" class="form-control-modern" onchange="onPaymentModeChange()">
              <% (paymentModes || []).forEach(pm => { %>
                <option value="<%= pm.id %>" <%= pm.name.toLowerCase().includes('cash') ? 'selected' : '' %> data-name="<%= pm.name.toLowerCase() %>"><%= pm.name %></option>
              <% }) %>
            </select>
          </div>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
            <div>
              <label style="font-size: 12px; font-weight: 700; color: var(--text-muted);">Invoice Total:</label>
              <input type="text" id="modalInvTotal" class="form-control-modern" readonly style="font-weight: 800; font-family: var(--font-mono); background: #f8fafc;" />
            </div>
            <div>
              <label style="font-size: 12px; font-weight: 700; color: var(--text-muted);">Amount Tendered:</label>
              <input type="number" id="tenderAmount" class="form-control-modern" step="1" oninput="calculateModalChange()" style="font-weight: 800; font-family: var(--font-mono);" />
            </div>
          </div>

          <!-- Quick Cash Preset Denomination Chips -->
          <div>
            <div style="font-size: 11px; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Quick Cash Tender Presets:</div>
            <div class="quick-preset-btns">
              <button type="button" class="quick-preset-btn" onclick="presetTender('exact')">Exact Total</button>
              <button type="button" class="quick-preset-btn" onclick="presetTender(100)">₹100</button>
              <button type="button" class="quick-preset-btn" onclick="presetTender(500)">₹500</button>
              <button type="button" class="quick-preset-btn" onclick="presetTender(1000)">₹1,000</button>
              <button type="button" class="quick-preset-btn" onclick="presetTender(2000)">₹2,000</button>
            </div>
          </div>

          <!-- Live Change Return Display -->
          <div style="background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 6px; padding: 10px 14px; display: flex; justify-content: space-between; align-items: center;">
            <span style="font-size: 12.5px; font-weight: 700; color: #166534;">Change Return Due:</span>
            <span style="font-size: 16px; font-weight: 900; color: #15803d; font-family: var(--font-mono);" id="modalChangeReturnDisplay">₹0.00</span>
          </div>

          <!-- Dynamic UPI QR Container -->
          <div id="upiQrSection" style="display: none; text-align: center; border-top: 1px solid #e2e8f0; padding-top: 12px;">
            <div style="font-size: 12px; font-weight: 800; color: var(--primary); margin-bottom: 8px;">Scan with any UPI App (GPay / PhonePe / Paytm)</div>
            <div id="modalUpiQrCode" style="display: inline-block; padding: 8px; background: #ffffff; border: 1px solid #cbd5e1; border-radius: 8px;"></div>
            <div style="font-size: 11px; color: var(--text-muted); margin-top: 6px;">Instant bank settlement confirmation</div>
          </div>
        </div>
        <div class="modal-footer" style="background: #f8fafc; border-top: 1px solid var(--border-color); padding: 12px 18px; display: flex; justify-content: flex-end; gap: 8px;">
          <button type="button" class="btn-modern btn-primary-modern" onclick="applyPaymentModal()">
            <i class="ti ti-check"></i>
            <span>Complete &amp; Print Bill (F2 / Space)</span>
          </button>
          <button type="button" class="btn-modern btn-secondary-modern" onclick="closeModal('paymentModal')">Close</button>
        </div>
      </div>
    </div>
  </div>

