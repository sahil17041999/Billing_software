<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit INVOICE - <%= (company && company.name) || (user && user.Company && user.Company.name) || 'Your Company Name' %> - POS Terminal</title>
  <meta name="description" content="Advanced Enterprise Point of Sale (POS) &amp; Billing Terminal">
  <link rel="shortcut icon" type="image/png" href="/assets/images/logos/favicon.png" />
  <link rel="icon" type="image/png" href="/assets/images/logos/favicon.png" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css" />
  <link rel="stylesheet" href="/assets/css/icons/tabler-icons/tabler-icons.css" />
  <link rel="stylesheet" href="/assets/css/admin-theme.css" />

  <!-- jQuery & jQuery Validation CDN -->
  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
  <script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.6/dist/JsBarcode.all.min.js"></script>

  <style>
    /* ==========================================================================
       ADVANCED ENTERPRISE POS BILLING SUITE - ZOHO ADMIN PANEL DESIGN
       ========================================================================== */

    /* POS Breadcrumb & Top bar */
    .pos-page-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 16px;
      gap: 12px;
      flex-wrap: wrap;
    }

    .pos-page-title-group {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .pos-page-icon {
      width: 44px;
      height: 44px;
      border-radius: var(--radius-sm);
      background: linear-gradient(135deg, #1366d9 0%, #0b50b3 100%);
      color: #ffffff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 24px;
      box-shadow: 0 4px 12px rgba(19, 102, 217, 0.25);
    }

    .pos-session-meta {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 12px;
      color: var(--text-muted);
    }

    .pos-meta-item {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 4px 10px;
      border-radius: var(--radius-full);
      background: #ffffff;
      border: 1px solid var(--border-color);
      font-weight: 600;
    }

    /* Main POS Master Frame */
    .pos-master-card {
      background: #ffffff;
      border: 1px solid var(--border-color);
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-sm);
      overflow: hidden;
      margin-bottom: 24px;
    }

    .pos-window-titlebar {
      background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
      color: #ffffff;
      padding: 10px 18px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .pos-title-left {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 13.5px;
      font-weight: 700;
      letter-spacing: 0.3px;
    }

    .pos-title-left i {
      font-size: 18px;
      color: #38bdf8;
    }

    .pos-window-controls {
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .pos-win-btn {
      width: 28px;
      height: 28px;
      border-radius: 6px;
      background: rgba(255, 255, 255, 0.12);
      border: 1px solid rgba(255, 255, 255, 0.2);
      color: #ffffff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 13px;
      cursor: pointer;
      text-decoration: none;
      transition: var(--transition);
    }

    .pos-win-btn:hover {
      background: rgba(255, 255, 255, 0.25);
    }

    .pos-win-btn.close:hover {
      background: #ef4444;
      border-color: #ef4444;
    }

    /* POS Body Layout */
    .pos-window-body {
      padding: 16px;
      background: #f8fafc;
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    /* Top Grid: Sold to | Ship to | INVOICE */
    .pos-top-grid {
      display: grid;
      grid-template-columns: 1fr 1fr 340px;
      gap: 14px;
      align-items: stretch;
    }

    @media (max-width: 1100px) {
      .pos-top-grid {
        grid-template-columns: 1fr;
      }
    }

    /* Group Card Box */
    .pos-group-card {
      background: #ffffff;
      border: 1px solid var(--border-color);
      border-radius: var(--radius-sm);
      padding: 12px 14px;
      display: flex;
      flex-direction: column;
      gap: 8px;
      box-shadow: var(--shadow-xs);
      transition: var(--transition);
    }

    .pos-group-card:hover {
      border-color: #cbd5e1;
      box-shadow: var(--shadow-sm);
    }

    .pos-group-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      border-bottom: 1px solid #f1f5f9;
      padding-bottom: 8px;
      margin-bottom: 2px;
    }

    .pos-group-title {
      font-size: 12px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: var(--text-muted);
      display: flex;
      align-items: center;
      gap: 6px;
    }

    /* INVOICE Details Card (Right Side) */
    .pos-invoice-card {
      background: #ffffff;
      border: 1.5px solid #bfdbfe;
      border-radius: var(--radius-sm);
      padding: 12px 14px;
      display: flex;
      flex-direction: column;
      box-shadow: 0 4px 12px rgba(19, 102, 217, 0.05);
    }

    .pos-invoice-header-badge {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 8px;
      padding-bottom: 6px;
      border-bottom: 2px solid var(--primary);
    }

    .pos-invoice-header-title {
      font-size: 18px;
      font-weight: 900;
      color: var(--primary);
      letter-spacing: 1px;
    }

    .pos-invoice-form-grid {
      display: grid;
      grid-template-columns: 85px 1fr;
      gap: 6px 8px;
      align-items: center;
    }

    .pos-invoice-form-grid label {
      font-size: 11.5px;
      font-weight: 700;
      color: var(--text-muted);
      margin: 0;
    }

    .pos-invoice-form-grid .form-control-modern {
      height: 28px;
      padding: 2px 8px;
      font-size: 12px;
    }

    /* Sub-row: Email + Calculator + Barcode + Fast Park */
    .pos-subrow-card {
      background: #ffffff;
      border: 1px solid var(--border-color);
      border-radius: var(--radius-sm);
      padding: 10px 14px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      flex-wrap: wrap;
    }

    .pos-subrow-left {
      display: flex;
      align-items: center;
      gap: 10px;
      flex: 1;
      min-width: 280px;
    }

    .pos-subrow-right {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }

    /* Action Toolbar */
    .pos-action-toolbar {
      background: #ffffff;
      border: 1px solid var(--border-color);
      border-radius: var(--radius-sm);
      padding: 8px 14px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      flex-wrap: wrap;
    }

    .pos-toolbar-group {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }

    .pos-line-count-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 4px 10px;
      border-radius: 6px;
      background: var(--primary-light);
      color: var(--primary);
      border: 1px solid var(--primary-border);
      font-size: 12px;
      font-weight: 700;
    }

    /* DataGridView Line Items Table */
    .pos-grid-wrapper {
      background: #ffffff;
      border: 1px solid var(--border-color);
      border-radius: var(--radius-sm);
      overflow-x: auto;
      min-height: 200px;
      max-height: 300px;
      box-shadow: var(--shadow-xs);
    }

    .pos-grid-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 12.5px;
      table-layout: fixed;
    }

    .pos-grid-table thead th {
      background: #f1f5f9;
      color: var(--text-main);
      font-weight: 700;
      padding: 8px 10px;
      border-right: 1px solid var(--border-color);
      border-bottom: 1.5px solid #cbd5e1;
      text-align: left;
      position: sticky;
      top: 0;
      z-index: 2;
      font-size: 12px;
    }

    .pos-grid-table thead th:last-child {
      border-right: none;
    }

    .pos-grid-table tbody td {
      padding: 6px 10px;
      border-right: 1px solid #f1f5f9;
      border-bottom: 1px solid #f1f5f9;
      vertical-align: middle;
      font-size: 12px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .pos-grid-table tbody td:last-child {
      border-right: none;
    }

    .pos-grid-table tbody tr {
      cursor: pointer;
      transition: background 0.12s ease;
    }

    .pos-grid-table tbody tr:hover {
      background: #f8fafc;
    }

    .pos-grid-table tbody tr.selected {
      background: #eff6ff !important;
      color: #1e3a8a;
    }

    .pos-grid-table tbody tr.selected td {
      border-color: #dbeafe;
    }

    .col-ind { width: 28px; text-align: center; color: var(--primary); font-weight: 900; font-size: 11px; }
    .col-sku { width: 140px; font-family: var(--font-mono); }
    .col-desc { width: auto; font-weight: 600; }
    .col-q { width: 85px; text-align: center; }
    .col-pr { width: 110px; text-align: right; font-family: var(--font-mono); }
    .col-tx { width: 80px; text-align: center; }
    .col-tot { width: 125px; text-align: right; font-weight: 800; font-family: var(--font-mono); color: var(--text-main); }

    .pos-cell-input {
      width: 100%;
      height: 24px;
      border: 1px solid #cbd5e1;
      border-radius: 4px;
      padding: 1px 6px;
      font-size: 12px;
      font-family: inherit;
      background: #ffffff;
      transition: border 0.15s;
    }

    .pos-cell-input:focus {
      outline: none;
      border-color: var(--primary);
      box-shadow: 0 0 0 1px var(--primary);
    }

    /* Bottom Section: Tabs + Financial Totals */
    .pos-bottom-grid {
      display: grid;
      grid-template-columns: 1fr 360px;
      gap: 14px;
      align-items: stretch;
    }

    @media (max-width: 900px) {
      .pos-bottom-grid {
        grid-template-columns: 1fr;
      }
    }

    /* Tabs Card */
    .pos-tabs-card {
      background: #ffffff;
      border: 1px solid var(--border-color);
      border-radius: var(--radius-sm);
      display: flex;
      flex-direction: column;
      overflow: hidden;
      box-shadow: var(--shadow-xs);
    }

    .pos-tab-nav {
      display: flex;
      background: #f8fafc;
      border-bottom: 1px solid var(--border-color);
      padding: 6px 8px 0;
      gap: 4px;
      overflow-x: auto;
    }

    .pos-tab-btn {
      padding: 6px 14px;
      border: 1px solid transparent;
      border-bottom: none;
      border-radius: 6px 6px 0 0;
      background: transparent;
      font-size: 12px;
      font-weight: 600;
      color: var(--text-muted);
      cursor: pointer;
      white-space: nowrap;
      margin-bottom: -1px;
      transition: all 0.15s;
    }

    .pos-tab-btn:hover {
      color: var(--text-main);
      background: #f1f5f9;
    }

    .pos-tab-btn.active {
      background: #ffffff;
      border-color: var(--border-color);
      color: var(--primary);
      font-weight: 700;
      border-top: 2.5px solid var(--primary);
    }

    .pos-tab-pane-container {
      padding: 12px 14px;
      background: #ffffff;
      flex: 1;
      min-height: 120px;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .pos-tab-pane {
      display: none;
    }

    .pos-tab-pane.active {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    /* Financial Totals Card (Right Side) */
    .pos-totals-card {
      background: #ffffff;
      border: 1px solid var(--border-color);
      border-radius: var(--radius-sm);
      padding: 12px 16px;
      display: flex;
      flex-direction: column;
      gap: 6px;
      box-shadow: var(--shadow-xs);
    }

    .pos-total-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      font-size: 12.5px;
    }

    .pos-total-row label {
      font-size: 12px;
      font-weight: 600;
      color: var(--text-body);
      margin: 0;
    }

    .pos-total-val-box {
      width: 120px;
      height: 26px;
      background: #f8fafc;
      border: 1px solid var(--border-color);
      border-radius: 4px;
      text-align: right;
      padding: 2px 8px;
      font-size: 12.5px;
      font-weight: 700;
      font-family: var(--font-mono);
      color: var(--text-main);
    }

    .pos-total-val-box.amount-due {
      color: #dc2626 !important;
      font-size: 14.5px !important;
      font-weight: 900 !important;
      background: #fef2f2 !important;
      border-color: #fca5a5 !important;
    }

    /* Footer Actions Bar */
    .pos-footer-actions {
      background: #ffffff;
      border: 1px solid var(--border-color);
      border-radius: var(--radius-sm);
      padding: 10px 16px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      flex-wrap: wrap;
      box-shadow: var(--shadow-sm);
    }

    .pos-footer-group {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }

    /* Quick Preset Denominations */
    .quick-preset-btns {
      display: flex;
      gap: 6px;
      flex-wrap: wrap;
      margin-top: 6px;
    }

    .quick-preset-btn {
      padding: 3px 8px;
      border-radius: 4px;
      border: 1px solid var(--border-color);
      background: #f8fafc;
      font-size: 11px;
      font-weight: 700;
      color: var(--text-muted);
      cursor: pointer;
      transition: var(--transition);
    }

    .quick-preset-btn:hover {
      background: var(--primary-light);
      border-color: var(--primary-border);
      color: var(--primary);
    }

    /* Calculator Display & Pad */
    .calc-box-display {
      background: #0f172a;
      color: #38bdf8;
      border-radius: 6px;
      font-family: var(--font-mono);
      font-size: 26px;
      font-weight: 800;
      text-align: right;
      padding: 10px 14px;
      margin-bottom: 12px;
      letter-spacing: 1px;
    }

    .calc-btn-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 6px;
    }

    .calc-btn-grid button {
      height: 42px;
      font-size: 15px;
      font-weight: 700;
      border-radius: 6px;
    }

    /* JQUERY VALIDATION ERROR STYLING */
    .is-invalid {
      border-color: #ef4444 !important;
      background-color: #fffafb !important;
    }

    .is-invalid:focus {
      box-shadow: 0 0 0 2px rgba(239, 68, 68, 0.2) !important;
    }

    .is-valid {
      border-color: #10b981 !important;
      background-color: #f7fee7 !important;
    }

    span.invalid-feedback-custom {
      display: block;
      color: #ef4444;
      font-size: 11px;
      font-weight: 600;
      margin-top: 3px;
    }

    span.invalid-feedback-custom i {
      vertical-align: -1px;
      margin-right: 2px;
    }

    /* ==========================================================================
       MODERN GROCERY POS & FAST BILLING TERMINAL REDESIGN
       ========================================================================== */

    .pos-modern-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      background: #ffffff;
      border: 1px solid var(--border-color);
      border-radius: 12px;
      padding: 10px 16px;
      margin-bottom: 14px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.03);
      flex-wrap: wrap;
    }

    .pos-header-left {
      display: flex;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
    }

    .pos-brand-badge {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 15px;
      font-weight: 800;
      color: #0f172a;
    }

    .pos-brand-badge i {
      width: 32px;
      height: 32px;
      border-radius: 8px;
      background: linear-gradient(135deg, #1366d9 0%, #3b82f6 100%);
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 18px;
    }

    .pos-live-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 11px;
      font-weight: 700;
      color: #10b981;
      background: #ecfdf5;
      border: 1px solid #a7f3d0;
      padding: 3px 8px;
      border-radius: 20px;
    }

    .pos-live-pill .pulse-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #10b981;
      animation: pulse 1.5s infinite;
    }

    .pos-customer-pill {
      display: flex;
      align-items: center;
      gap: 8px;
      background: #f8fafc;
      border: 1.5px solid #cbd5e1;
      border-radius: 30px;
      padding: 4px 12px;
      cursor: pointer;
      transition: all 0.2s;
    }

    .pos-customer-pill:hover {
      border-color: #3b82f6;
      background: #eff6ff;
    }

    .pos-customer-pill i {
      color: #3b82f6;
      font-size: 18px;
    }

    .pos-cust-info {
      display: flex;
      flex-direction: column;
      line-height: 1.1;
    }

    .cust-label {
      font-size: 10px;
      font-weight: 700;
      color: #64748b;
      text-transform: uppercase;
    }

    .cust-val {
      font-size: 13px;
      font-weight: 800;
      color: #0f172a;
      max-width: 140px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .btn-cust-change {
      background: #e2e8f0;
      border: none;
      border-radius: 12px;
      padding: 3px 8px;
      font-size: 11px;
      font-weight: 700;
      color: #334155;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 3px;
    }

    .btn-cust-new {
      background: #10b981;
      border: none;
      border-radius: 50%;
      width: 22px;
      height: 22px;
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      font-size: 12px;
    }

    .pos-header-right {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }

    .pos-meta-chip {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 12px;
      color: #475569;
      background: #f1f5f9;
      padding: 5px 10px;
      border-radius: 8px;
      font-weight: 600;
    }

    .btn-pos-chip {
      border: none;
      padding: 6px 12px;
      border-radius: 8px;
      font-size: 12px;
      font-weight: 700;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: all 0.2s;
    }

    .btn-pos-chip.warning {
      background: #fffbeb;
      color: #b45309;
      border: 1px solid #fde68a;
    }
    .btn-pos-chip.warning:hover { background: #fef3c7; }

    .btn-pos-chip.secondary {
      background: #f1f5f9;
      color: #334155;
      border: 1px solid #e2e8f0;
    }
    .btn-pos-chip.secondary:hover { background: #e2e8f0; }

    .btn-pos-chip.danger {
      background: #fef2f2;
      color: #b91c1c;
      border: 1px solid #fecaca;
    }
    .btn-pos-chip.danger:hover { background: #fee2e2; }

    /* 2-Column POS Layout */
    .pos-split-layout {
      display: grid;
      grid-template-columns: 1fr 380px;
      gap: 16px;
      align-items: start;
    }

    @media (max-width: 1100px) {
      .pos-split-layout {
        grid-template-columns: 1fr;
      }
    }

    /* Left Panel */
    .pos-left-panel {
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .pos-scanner-hero {
      background: #ffffff;
      border: 1.5px solid #bfdbfe;
      border-radius: 12px;
      padding: 10px 14px;
      box-shadow: 0 4px 14px rgba(19, 102, 217, 0.06);
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .pos-barcode-input-box {
      flex: 1;
      position: relative;
      display: flex;
      align-items: center;
    }

    .pos-barcode-input-box .ti-barcode-scanner-icon {
      position: absolute;
      left: 14px;
      font-size: 22px;
      color: #3b82f6;
      pointer-events: none;
    }

    .pos-hero-input {
      width: 100%;
      height: 48px;
      background: #f8fafc;
      border: 1.5px solid #cbd5e1;
      border-radius: 10px;
      padding: 0 75px 0 46px;
      font-size: 15px;
      font-weight: 600;
      color: #0f172a;
      outline: none;
      transition: all 0.2s;
    }

    .pos-hero-input:focus {
      border-color: #2563eb;
      background: #ffffff;
      box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
    }

    .pos-kbd-hint {
