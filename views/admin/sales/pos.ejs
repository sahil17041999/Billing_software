  <!-- 4. ADD NEW PRODUCT PROPER MODAL (With jQuery Validation) -->
  <div class="modal fade" id="addNewProductModal" tabindex="-1" style="display: none; background: rgba(15,23,42,0.6); position: fixed; inset: 0; z-index: 1070; align-items: center; justify-content: center;">
    <div class="modal-dialog" style="max-width: 660px; width: 100%; margin: 20px;">
      <div class="modal-content" style="background: #fff; border-radius: var(--radius-md); box-shadow: var(--shadow-xl); overflow: hidden;">
