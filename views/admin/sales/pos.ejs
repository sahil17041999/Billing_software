        if (!lineItems || lineItems.length === 0) {
          showToast('Cart is empty. Add products before previewing invoice.', 'warning');
          return;
        }
      }

      const invoiceNo = (targetSale && targetSale.invoice_number) ? targetSale.invoice_number : (document.getElementById('invoiceNumberInput').value || 'INV-2026-000001');
      const invDate = new Date();
      const formattedDate = invDate.toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' });
      const formattedTime = invDate.toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit', hour12: true });

      const customerName = (targetSale && targetSale.customer && targetSale.customer.name) || (activeCustomer ? activeCustomer.name : (document.getElementById('soldToName').value || ''));
      const customerPhone = (activeCustomer && activeCustomer.phone) ? activeCustomer.phone : '';
      const customerEmail = (activeCustomer && activeCustomer.email) ? activeCustomer.email : (document.getElementById('customerEmailInput').value || '');
      const customerAddress = (activeCustomer && activeCustomer.address) ? activeCustomer.address : (document.getElementById('soldToAddress').value || '');
      const customerGstin = (activeCustomer && activeCustomer.gstin) ? activeCustomer.gstin : '';

      const companyName = (serverCompany && serverCompany.name) || '<%= (company && company.name) || "SAMPLE STORE" %>';
      const companyAddress = (serverCompany && serverCompany.address) || '<%= (company && company.address) || "Main Market Road" %>';
      const companyPhone = (serverCompany && serverCompany.phone) || '<%= (company && company.phone) || "9999999999" %>';
      const companyEmail = (serverCompany && serverCompany.email) || '<%= (company && company.email) || "store@example.com" %>';
      const companyState = (serverCompany && serverCompany.state) || '<%= (company && company.state) || "West Bengal" %>';
      const companyGstin = (serverCompany && serverCompany.gstin) || '<%= (company && company.gstin) || "" %>';
      const companyPan = (serverCompany && serverCompany.pan) || '<%= (company && company.pan) || "" %>';
      const companyLogo = (serverCompany && serverCompany.logo_path) || '<%= (company && company.logo_path) || "" %>';
      const signatoryImg = '<%= (user && user.signature_image) ? user.signature_image : "" %>';
      const signatoryStamp = '<%= (user && user.stamp_image) || (company && company.stamp_image) || "" %>';
      const signatoryName = '<%= (user && user.signatory_name) ? user.signatory_name : "" %>';
      const signatoryTitle = '<%= (user && user.signatory_designation) ? user.signatory_designation : "AUTHORIZED SIGNATORY" %>';

      const items = (targetSale && targetSale.items && targetSale.items.length > 0) ? targetSale.items : lineItems;

      let subtotal = 0;
      let totalQty = 0;
      let totalLineDiscount = 0;
      let taxMap = {};

      const processedItems = items.map((item, idx) => {
        const q = Number(item.qty || item.quantity || 1);
        const rate = Number(item.price || item.unit_price || 0);
        const disc = Number(item.discount_amount || 0);
        const taxable = (rate * q) - disc;
        const taxRate = Number(item.taxRate || item.tax_rate || 5);
        const taxAmount = (taxable * taxRate) / 100;
        const lineTotal = taxable + taxAmount;
        const hsn = (item.barcode ? String(item.barcode).substring(0, 6) : (item.sku ? String(item.sku).substring(0, 6) : '0000'));
        const unit = item.unit || 'Pcs';

        subtotal += (rate * q);
        totalQty += q;
        totalLineDiscount += disc;

        if (!taxMap[taxRate]) {
          taxMap[taxRate] = { rate: taxRate, taxable: 0, taxAmt: 0 };
        }
        taxMap[taxRate].taxable += taxable;
        taxMap[taxRate].taxAmt += taxAmount;

        return {
          idx: idx + 1,
          name: item.name || 'Item',
          sku: item.sku || '',
          hsn,
          qty: q,
          unit,
          rate,
          disc,
