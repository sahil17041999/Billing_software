    async function executeProductSave() {
      const name = document.getElementById('np_name').value.trim();
      const category_id = document.getElementById('np_category_id').value;
      const unit_id = document.getElementById('np_unit_id').value;
      const tax_id = document.getElementById('np_tax_id').value;
      const brand_id = document.getElementById('np_brand_id').value;
      const selling_price = parseFloat(document.getElementById('np_selling_price').value);
      const purchase_price = parseFloat(document.getElementById('np_purchase_price').value);
      const sku = document.getElementById('np_sku').value.trim();
      const barcode = document.getElementById('np_barcode').value.trim();
      const initial_stock = parseInt(document.getElementById('np_initial_stock').value, 10) || 100;

      Swal.fire({
        title: 'Saving New Product...',
        allowOutsideClick: false,
        didOpen: () => Swal.showLoading()
      });

      try {
        const response = await fetch('/admin/master/products', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify({
            name, category_id, unit_id, tax_id, brand_id, selling_price, purchase_price, sku, barcode, initial_stock
          })
        });

        const result = await response.json();
        if (!response.ok || !result.success) {
          throw new Error(result.error || 'Failed to save product');
        }

        const newProduct = result.product;
        serverProducts.unshift(newProduct);
        addProductToInvoice(newProduct);
        closeModal('addNewProductModal');

        Swal.fire({
          icon: 'success',
          title: 'Product Created & Added!',
          html: `
            <div style="font-size: 13.5px; color: #334155;">
              <strong>${escapeHtml(newProduct.name)}</strong> (₹${parseFloat(newProduct.selling_price || 0).toFixed(2)}) has been added to your bill.
            </div>
            ${newProduct.barcode ? `
            <div style="margin-top: 8px; font-size: 11.5px; color: #475569; background: #f8fafc; padding: 6px 10px; border-radius: 6px; border: 1px solid #e2e8f0; font-family: monospace;">
              Barcode: <strong>${escapeHtml(newProduct.barcode)}</strong> (Ready for scanning)
            </div>` : ''}
          `,
          timer: 1800,
          showConfirmButton: false
        });

      } catch (err) {
        Swal.fire({
          icon: 'error',
          title: 'Product Creation Error',
          text: err.message
        });
      }
    }

