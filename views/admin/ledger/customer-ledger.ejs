<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Customer Ledger - Grocery Billing ERP</title>
  <link rel="shortcut icon" type="image/png" href="/assets/images/logos/favicon.png" />
  <link rel="stylesheet" href="/assets/css/icons/tabler-icons/tabler-icons.css" />
  <link rel="stylesheet" href="/assets/css/admin-theme.css" />
</head>
<body>
  <div class="admin-layout">
    <!-- Sidebar -->
    <%- include('../../partials/sidebar.ejs', { currentPage: 'ledger' }) %>

    <div class="page-wrapper">
      <div class="body-wrapper">
        <!-- Header -->
        <%- include('../../partials/header.ejs') %>

        <main class="page-content">
          <!-- Page Header -->
          <div class="page-title-box">
            <div class="page-title-left">
              <h1 class="page-main-heading">
                <i class="ti ti-user" style="color: var(--primary);"></i> Customer Account Ledger
              </h1>
              <p class="page-subheading">Statement of sales debits, customer payments, receipts, and running balance</p>
            </div>
            
            <div class="page-title-actions">
              <a href="/admin/master/customers" class="btn-modern btn-secondary-modern">
                <i class="ti ti-users"></i> All Customers
              </a>
            </div>
          </div>

          <!-- Hero Balance Banner -->
          <div class="card-modern" style="padding: 20px 24px; background: linear-gradient(135deg, #ffffff 0%, var(--bg-subtle) 100%); margin-bottom: 24px;">
            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 14px;">
              <div>
                <div style="font-size: 12px; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Total Outstanding Receivables</div>
                <div style="font-size: 26px; font-weight: 800; font-family: var(--font-mono); color: <%= currentBalance > 0 ? '#ef4444' : '#10b981' %>; margin-top: 4px;">
                  ₹<%= Number(currentBalance || 0).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
                </div>
              </div>
              <div>
                <span class="badge-modern <%= currentBalance > 0 ? 'danger' : 'success' %>" style="font-size: 13px; padding: 6px 14px;">
                  <%= currentBalance > 0 ? 'Pending Collection' : 'Settled In Full' %>
                </span>
              </div>
            </div>
          </div>

          <!-- Main Table Card -->
          <div class="card-modern">
            <div class="card-body-modern">
              
              <div class="table-responsive-wrapper">
                <table class="table-modern no-datatable server-paginated">
                  <thead>
                    <tr>
                      <th style="width: 70px;">ID</th>
                      <th>Transaction Date</th>
                      <th>Description</th>
                      <th>Reference</th>
                      <th style="text-align: right;">Debit (+)</th>
                      <th style="text-align: right;">Credit (-)</th>
                      <th style="text-align: right;">Running Balance</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% if (ledger.length === 0) { %>
                      <tr>
                        <td colspan="7" class="table-empty-state">
                          <i class="ti ti-report-off icon"></i>
                          <p>No customer transactions in ledger.</p>
                        </td>
                      </tr>
                    <% } %>
                    <% ledger.forEach(entry => { %>
                      <tr>
                        <td><span style="font-family: var(--font-mono); color: var(--text-light); font-weight: 600;">#<%= entry.id %></span></td>
                        <td>
                          <span style="color: var(--text-muted);">
                            <%= new Date(entry.transaction_date).toLocaleDateString('en-IN', { year: 'numeric', month: 'short', day: 'numeric' }) %>
                          </span>
                        </td>
                        <td><strong><%= entry.description || '-' %></strong></td>
                        <td><span class="badge-modern secondary"><%= entry.reference_type || '-' %> #<%= entry.reference_id || '-' %></span></td>
                        <td style="text-align: right; color: #ef4444;" class="amount-cell">
                          <%= entry.debit_amount > 0 ? '₹' + Number(entry.debit_amount).toFixed(2) : '-' %>
                        </td>
                        <td style="text-align: right; color: #10b981;" class="amount-cell">
                          <%= entry.credit_amount > 0 ? '₹' + Number(entry.credit_amount).toFixed(2) : '-' %>
                        </td>
                        <td style="text-align: right; font-weight: 700;" class="amount-cell">
                          ₹<%= Number(entry.runningBalance || 0).toFixed(2) %>
                        </td>
                      </tr>
                    <% }); %>
                  </tbody>
                </table>
              </div>

              <!-- Pagination -->
              <div class="pagination-modern">
                <span style="font-size: 13px; color: var(--text-muted);">
                  Showing Page <strong><%= page %></strong> of <strong><%= Math.max(1, totalPages) %></strong>
                </span>
                <div class="pagination-controls">
                  <% const maxPages = Math.max(1, totalPages); %>
                  <% if (page > 1) { %>
                    <a href="/admin/ledger/customer?page=<%= page - 1 %>&limit=<%= limit %>" class="page-btn-modern">
                      <i class="ti ti-chevron-left"></i> Previous
                    </a>
                  <% } else { %>
                    <span class="page-btn-modern disabled">
                      <i class="ti ti-chevron-left"></i> Previous
                    </span>
                  <% } %>

                  <% for (let p = Math.max(1, page - 2); p <= Math.min(maxPages, page + 2); p++) { %>
                    <a href="/admin/ledger/customer?page=<%= p %>&limit=<%= limit %>" class="page-btn-modern <%= p === page ? 'active' : '' %>"><%= p %></a>
                  <% } %>

                  <% if (page < maxPages) { %>
                    <a href="/admin/ledger/customer?page=<%= page + 1 %>&limit=<%= limit %>" class="page-btn-modern">
                      Next <i class="ti ti-chevron-right"></i>
                    </a>
                  <% } else { %>
                    <span class="page-btn-modern disabled">
                      Next <i class="ti ti-chevron-right"></i>
                    </span>
                  <% } %>
                </div>
              </div>

            </div>
          </div>

        </main>

        <!-- Footer -->
        <%- include('../../partials/footer.ejs') %>
      </div>
    </div>
  </div>
</body>
</html>