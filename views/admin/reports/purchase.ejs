<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Purchase Inward Report - Grocery Billing ERP</title>
  <link rel="shortcut icon" type="image/png" href="/assets/images/logos/favicon.png" />
  <link rel="stylesheet" href="/assets/css/icons/tabler-icons/tabler-icons.css" />
  <link rel="stylesheet" href="/assets/css/admin-theme.css" />
</head>
<body>
  <div class="admin-layout">
    <!-- Sidebar -->
    <%- include('../../partials/sidebar.ejs', { currentPage: 'reports' }) %>

    <div class="page-wrapper">
      <div class="body-wrapper">
        <!-- Header -->
        <%- include('../../partials/header.ejs') %>

        <main class="page-content">
          <!-- Page Header -->
          <div class="page-title-box">
            <div class="page-title-left">
              <h1 class="page-main-heading">
                <i class="ti ti-truck-delivery" style="color: var(--primary);"></i> Purchase Procurement Report
              </h1>
              <p class="page-subheading">Track supplier invoice volume, procurement spend, and inward GST totals</p>
            </div>
            
            <div class="page-title-actions">
              <a href="/admin/purchases" class="btn-modern btn-secondary-modern">
                <i class="ti ti-truck-loading"></i> Purchase Orders
              </a>
            </div>
          </div>

          <!-- Filter Toolbar Card -->
          <div class="card-modern" style="padding: 18px 24px; margin-bottom: 20px;">
            <div style="display: flex; gap: 14px; align-items: flex-end; flex-wrap: wrap;">
              <div class="form-group-modern" style="margin-bottom: 0;">
                <label class="form-label-modern" for="fromDate">From Date</label>
                <input type="date" id="fromDate" class="form-control-modern" style="width: 170px;">
              </div>
              <div class="form-group-modern" style="margin-bottom: 0;">
                <label class="form-label-modern" for="toDate">To Date</label>
                <input type="date" id="toDate" class="form-control-modern" style="width: 170px;">
              </div>
              <div class="form-group-modern" style="margin-bottom: 0;">
                <label class="form-label-modern" for="groupBy">Group By</label>
                <select id="groupBy" class="form-control-modern" style="width: 150px;">
                  <option value="daily">Daily</option>
                  <option value="weekly">Weekly</option>
                  <option value="monthly">Monthly</option>
                </select>
              </div>
              <button type="button" class="btn-modern btn-primary-modern" onclick="loadReport()" style="height: 42px;" id="generateBtn">
                <i class="ti ti-chart-pie"></i> Generate Report
              </button>
              <div style="display: flex; gap: 6px; align-items: center; margin-left: auto; flex-wrap: wrap;">
                <button type="button" class="btn-modern btn-secondary-modern btn-sm-modern" onclick="setDatePreset('today')">Today</button>
                <button type="button" class="btn-modern btn-secondary-modern btn-sm-modern" onclick="setDatePreset('month')">This Month</button>
                <button type="button" class="btn-modern btn-secondary-modern btn-sm-modern" onclick="setDatePreset('last30')">Last 30 Days</button>
                <button type="button" class="btn-modern btn-secondary-modern btn-sm-modern" onclick="setDatePreset('all')">All Time</button>
              </div>
            </div>
          </div>

          <!-- Stat KPI Summary Cards -->
          <div class="stat-cards-grid" id="summaryCards">
            <div class="stat-card-modern">
              <div class="stat-card-header">
                <div class="stat-card-icon-box emerald"><i class="ti ti-truck-loading"></i></div>
                <span class="stat-card-tag up">Net Purchases</span>
              </div>
              <div class="stat-card-title">Total Inward Value</div>
              <div class="stat-card-value" id="kpiTotal">₹0.00</div>
            </div>

            <div class="stat-card-modern">
              <div class="stat-card-header">
                <div class="stat-card-icon-box indigo"><i class="ti ti-percentage"></i></div>
                <span class="stat-card-tag neutral">Input Tax</span>
              </div>
              <div class="stat-card-title">Input GST Claimable</div>
              <div class="stat-card-value" id="kpiTax">₹0.00</div>
            </div>

            <div class="stat-card-modern">
              <div class="stat-card-header">
                <div class="stat-card-icon-box amber"><i class="ti ti-tag"></i></div>
                <span class="stat-card-tag neutral">Vendor Discounts</span>
              </div>
              <div class="stat-card-title">Total Discounts Received</div>
              <div class="stat-card-value" id="kpiDiscount">₹0.00</div>
            </div>

            <div class="stat-card-modern">
              <div class="stat-card-header">
                <div class="stat-card-icon-box cyan"><i class="ti ti-list-check"></i></div>
                <span class="stat-card-tag up">Orders</span>
              </div>
              <div class="stat-card-title">Total Inward Bills</div>
              <div class="stat-card-value" id="kpiCount">0</div>
            </div>
          </div>

          <!-- Results Table Card -->
          <div class="card-modern">
            <div class="card-body-modern">
              <div class="table-responsive-wrapper">
                <table class="table-modern">
                  <thead>
                    <tr>
                      <th>Time Period</th>
                      <th style="text-align: center;">Orders</th>
                      <th style="text-align: right;">Subtotal (₹)</th>
                      <th style="text-align: right;">Tax (GST ₹)</th>
                      <th style="text-align: right;">Discount (₹)</th>
                      <th style="text-align: right;">Total Purchases (₹)</th>
                    </tr>
                  </thead>
                  <tbody id="reportBody">
                    <tr>
                      <td colspan="6" class="table-empty-state">
                        <i class="ti ti-chart-line icon"></i>
                        <p>Click "Generate Report" above to compile purchase figures.</p>
                      </td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>

        </main>

        <!-- Footer -->
        <%- include('../../partials/footer.ejs') %>
      </div>
    </div>
  </div>

  <script>
    function formatDateYMD(d) {
      const year = d.getFullYear();
      const month = String(d.getMonth() + 1).padStart(2, '0');
      const day = String(d.getDate()).padStart(2, '0');
      return `${year}-${month}-${day}`;
    }

    function setDatePreset(type) {
      const now = new Date();
      const fromEl = document.getElementById('fromDate');
      const toEl = document.getElementById('toDate');
      
      if (type === 'today') {
        fromEl.value = formatDateYMD(now);
        toEl.value = formatDateYMD(now);
      } else if (type === 'month') {
        const firstDay = new Date(now.getFullYear(), now.getMonth(), 1);
        fromEl.value = formatDateYMD(firstDay);
        toEl.value = formatDateYMD(now);
      } else if (type === 'last30') {
        const past = new Date();
        past.setDate(now.getDate() - 30);
        fromEl.value = formatDateYMD(past);
        toEl.value = formatDateYMD(now);
      } else if (type === 'all') {
        fromEl.value = '';
        toEl.value = '';
      }
      loadReport();
    }

    function loadReport() {
      const fromDate = document.getElementById('fromDate').value;
      const toDate = document.getElementById('toDate').value;
      const groupBy = document.getElementById('groupBy').value;
      const tbody = document.getElementById('reportBody');
      const btn = document.getElementById('generateBtn');

      if (window.jQuery && $.fn.DataTable && $.fn.DataTable.isDataTable('.table-modern')) {
        $('.table-modern').DataTable().destroy();
      }

      tbody.innerHTML = '<tr><td colspan="6" class="table-empty-state"><div class="spinner-border text-primary" role="status" style="width: 28px; height: 28px; border-width: 3px;"></div><p style="margin-top: 8px;">Compiling report metrics...</p></td></tr>';
      if (btn) btn.disabled = true;

      let url = '/admin/reports/purchase?groupBy=' + groupBy;
      if (fromDate) url += '&fromDate=' + fromDate;
      if (toDate) url += '&toDate=' + toDate;
      
      fetch(url, { headers: { 'Accept': 'application/json' } })
        .then(res => res.json())
        .then(data => {
          if (btn) btn.disabled = false;
          if (data.success) {
            const report = data.data || [];
            
            if (report.length === 0) {
              tbody.innerHTML = '<tr><td colspan="6" class="table-empty-state"><i class="ti ti-database-off icon"></i><p>No purchase records found in the selected range.</p></td></tr>';
            } else {
              tbody.innerHTML = report.map(row => `
                <tr>
                  <td><strong>${row.period}</strong></td>
                  <td style="text-align: center;"><span class="badge-modern secondary">${row.count}</span></td>
                  <td style="text-align: right;" class="amount-cell">₹${parseFloat(row.subtotal || 0).toFixed(2)}</td>
                  <td style="text-align: right;" class="amount-cell">₹${parseFloat(row.tax || 0).toFixed(2)}</td>
                  <td style="text-align: right; color: #059669;" class="amount-cell">₹${parseFloat(row.discount || 0).toFixed(2)}</td>
                  <td style="text-align: right; color: var(--primary); font-weight: 700;" class="amount-cell">₹${parseFloat(row.total || 0).toFixed(2)}</td>
                </tr>
              `).join('');

              if (typeof initStandardDataTable === 'function') {
                initStandardDataTable('.table-modern');
              }
            }
            
            // Update summary
            const total = report.reduce((sum, r) => sum + parseFloat(r.total || 0), 0);
            const totalTax = report.reduce((sum, r) => sum + parseFloat(r.tax || 0), 0);
            const totalDiscount = report.reduce((sum, r) => sum + parseFloat(r.discount || 0), 0);
            const totalCount = report.reduce((sum, r) => sum + parseInt(r.count || 0), 0);
            
            document.getElementById('kpiTotal').textContent = '₹' + total.toLocaleString('en-IN', { minimumFractionDigits: 2 });
            document.getElementById('kpiTax').textContent = '₹' + totalTax.toLocaleString('en-IN', { minimumFractionDigits: 2 });
            document.getElementById('kpiDiscount').textContent = '₹' + totalDiscount.toLocaleString('en-IN', { minimumFractionDigits: 2 });
            document.getElementById('kpiCount').textContent = totalCount;
          }
        })
        .catch(err => {
          if (btn) btn.disabled = false;
          tbody.innerHTML = '<tr><td colspan="6" class="table-empty-state"><i class="ti ti-alert-triangle icon" style="color:#ef4444;"></i><p>Error compiling report: ' + (err.message || 'Network error') + '</p></td></tr>';
        });
    }

    // Default: Set current month and trigger report
    document.addEventListener('DOMContentLoaded', function() {
      const now = new Date();
      const firstDay = new Date(now.getFullYear(), now.getMonth(), 1);
      document.getElementById('fromDate').value = formatDateYMD(firstDay);
      document.getElementById('toDate').value = formatDateYMD(now);
      loadReport();
    });
  </script>
</body>
</html>