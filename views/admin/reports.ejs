<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Reports &amp; Analytics Hub - Grocery Billing ERP</title>
  <link rel="shortcut icon" type="image/png" href="/assets/images/logos/favicon.png" />
  <link rel="stylesheet" href="/assets/css/icons/tabler-icons/tabler-icons.css" />
  <link rel="stylesheet" href="/assets/css/admin-theme.css" />
  <style>
    .report-card-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 20px;
    }
    .report-nav-card {
      background: white;
      border: 1px solid var(--border-color);
      border-radius: var(--radius-lg);
      padding: 24px;
      text-decoration: none;
      color: inherit;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition: all 0.25s ease;
      box-shadow: var(--shadow-sm);
    }
    .report-nav-card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-md);
      border-color: var(--primary);
    }
    .report-nav-icon {
      width: 48px;
      height: 48px;
      border-radius: var(--radius-md);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 24px;
      margin-bottom: 16px;
    }
  </style>
</head>
<body>
  <div class="admin-layout">
    <!-- Sidebar -->
    <%- include('../partials/sidebar.ejs', { currentPage: 'reports' }) %>

    <div class="page-wrapper">
      <div class="body-wrapper">
        <!-- Header -->
        <%- include('../partials/header.ejs') %>

        <main class="page-content">
          <!-- Page Header -->
          <div class="page-title-box">
            <div class="page-title-left">
              <h1 class="page-main-heading">
                <i class="ti ti-chart-dots" style="color: var(--primary);"></i> Reports &amp; Business Intelligence
              </h1>
              <p class="page-subheading">Generate actionable insights across retail sales, margins, inventory valuation, and cash logs</p>
            </div>
          </div>

          <!-- Reports Navigation Grid -->
          <div class="report-card-grid">
            
            <!-- Sales Report -->
            <a href="/admin/reports/sales" class="report-nav-card">
              <div>
                <div class="report-nav-icon" style="background: var(--primary-light); color: var(--primary);">
                  <i class="ti ti-chart-bar"></i>
                </div>
                <h3 style="font-size: 17px; font-weight: 700; color: var(--text-main); margin-bottom: 6px;">Sales Analytics</h3>
                <p style="font-size: 13.5px; color: var(--text-muted); line-height: 1.5;">Track daily/monthly sales volume, GST taxes, customer discounts, and revenue trends.</p>
              </div>
              <div style="margin-top: 16px; font-size: 13px; font-weight: 700; color: var(--primary); display: flex; align-items: center; gap: 4px;">
                Open Report <i class="ti ti-arrow-right"></i>
              </div>
            </a>

            <!-- Profit & Loss -->
            <a href="/admin/reports/profit-loss" class="report-nav-card">
              <div>
                <div class="report-nav-icon" style="background: var(--success-light); color: var(--success);">
                  <i class="ti ti-trending-up"></i>
                </div>
                <h3 style="font-size: 17px; font-weight: 700; color: var(--text-main); margin-bottom: 6px;">Profit &amp; Loss (P&amp;L)</h3>
                <p style="font-size: 13.5px; color: var(--text-muted); line-height: 1.5;">Net profit margins computed by deducting COGS and operating expenses from billed income.</p>
              </div>
              <div style="margin-top: 16px; font-size: 13px; font-weight: 700; color: var(--success); display: flex; align-items: center; gap: 4px;">
                Open Report <i class="ti ti-arrow-right"></i>
              </div>
            </a>

            <!-- Stock Valuation -->
            <a href="/admin/reports/stock" class="report-nav-card">
              <div>
                <div class="report-nav-icon" style="background: #e0f2fe; color: #0284c7;">
                  <i class="ti ti-box"></i>
                </div>
                <h3 style="font-size: 17px; font-weight: 700; color: var(--text-main); margin-bottom: 6px;">Inventory &amp; Stock Report</h3>
                <p style="font-size: 13.5px; color: var(--text-muted); line-height: 1.5;">Total inventory valuation at cost and retail prices, low stock counts, and batch quantities.</p>
              </div>
              <div style="margin-top: 16px; font-size: 13px; font-weight: 700; color: #0284c7; display: flex; align-items: center; gap: 4px;">
                Open Report <i class="ti ti-arrow-right"></i>
              </div>
            </a>

            <!-- Purchase Report -->
            <a href="/admin/reports/purchase" class="report-nav-card">
              <div>
                <div class="report-nav-icon" style="background: var(--secondary-light); color: var(--secondary);">
                  <i class="ti ti-truck-loading"></i>
                </div>
                <h3 style="font-size: 17px; font-weight: 700; color: var(--text-main); margin-bottom: 6px;">Purchase Inward Report</h3>
                <p style="font-size: 13.5px; color: var(--text-muted); line-height: 1.5;">Breakdown of supplier orders, inward taxes paid, and inventory acquisition costs.</p>
              </div>
              <div style="margin-top: 16px; font-size: 13px; font-weight: 700; color: var(--secondary); display: flex; align-items: center; gap: 4px;">
                Open Report <i class="ti ti-arrow-right"></i>
              </div>
            </a>

            <!-- Expense Report -->
            <a href="/admin/reports/expense" class="report-nav-card">
              <div>
                <div class="report-nav-icon" style="background: var(--danger-light); color: var(--danger);">
                  <i class="ti ti-receipt-tax"></i>
                </div>
                <h3 style="font-size: 17px; font-weight: 700; color: var(--text-main); margin-bottom: 6px;">Expense Breakdown</h3>
                <p style="font-size: 13.5px; color: var(--text-muted); line-height: 1.5;">Store overhead expenditure categorised by rent, utilities, staff salaries, and logistics.</p>
              </div>
              <div style="margin-top: 16px; font-size: 13px; font-weight: 700; color: var(--danger); display: flex; align-items: center; gap: 4px;">
                Open Report <i class="ti ti-arrow-right"></i>
              </div>
            </a>

            <!-- Cashier Audits -->
            <a href="/admin/reports/cashier" class="report-nav-card">
              <div>
                <div class="report-nav-icon" style="background: #fef3c7; color: #d97706;">
                  <i class="ti ti-user-check"></i>
                </div>
                <h3 style="font-size: 17px; font-weight: 700; color: var(--text-main); margin-bottom: 6px;">Cashier Shift Performance</h3>
                <p style="font-size: 13.5px; color: var(--text-muted); line-height: 1.5;">Audit individual cashier transaction speeds, billing counts, and collected totals.</p>
              </div>
              <div style="margin-top: 16px; font-size: 13px; font-weight: 700; color: #d97706; display: flex; align-items: center; gap: 4px;">
                Open Report <i class="ti ti-arrow-right"></i>
              </div>
            </a>

            <!-- Day End Report -->
            <a href="/admin/reports/day-end" class="report-nav-card">
              <div>
                <div class="report-nav-icon" style="background: #f3e8ff; color: #9333ea;">
                  <i class="ti ti-calendar-stats"></i>
                </div>
                <h3 style="font-size: 17px; font-weight: 700; color: var(--text-main); margin-bottom: 6px;">Day End Closing History</h3>
                <p style="font-size: 13.5px; color: var(--text-muted); line-height: 1.5;">Historical record of daily cash reconciliations, floats, and register drawer variances.</p>
              </div>
              <div style="margin-top: 16px; font-size: 13px; font-weight: 700; color: #9333ea; display: flex; align-items: center; gap: 4px;">
                Open Report <i class="ti ti-arrow-right"></i>
              </div>
            </a>

          </div>

        </main>

        <!-- Footer -->
        <%- include('../partials/footer.ejs') %>
      </div>
    </div>
  </div>
</body>
</html>
