                          <%= profile.signatory_designation || 'AUTHORIZED SIGNATORY' %>
                        </div>
                      </div>
                      <div style="font-size: 11px; color: #94a3b8; text-align: center; margin-top: 8px; line-height: 1.3;">
                        Both signature &amp; stamp will print together on official tax invoices and POS receipts.
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- System Account & Role Overview Card -->
              <div class="card-profile-section">
                <div class="card-profile-header">
                  <h3 class="card-profile-title">
                    <i class="ti ti-shield-lock" style="color: #0284c7;"></i> Account Privilege &amp; Session Info
                  </h3>
                </div>

                <div class="card-profile-body">
                  <div class="system-overview-grid">
                    <div class="system-stat-box">
                      <div class="system-stat-icon"><i class="ti ti-hash"></i></div>
                      <div class="system-stat-meta">
                        <div class="stat-label">User ID</div>
                        <div class="stat-value">#<%= profile.id %></div>
                      </div>
                    </div>

                    <div class="system-stat-box">
                      <div class="system-stat-icon"><i class="ti ti-building-store"></i></div>
                      <div class="system-stat-meta">
                        <div class="stat-label">Store Enterprise</div>
                        <div class="stat-value"><%= profile.company ? profile.company.name : 'Main Organization' %></div>
                      </div>
                    </div>

                    <div class="system-stat-box">
                      <div class="system-stat-icon"><i class="ti ti-user-check"></i></div>
                      <div class="system-stat-meta">
                        <div class="stat-label">System Role</div>
                        <div class="stat-value">
                          <span class="badge-modern <%= isSub ? 'primary' : 'info' %>"><%= isSub ? 'STORE OWNER (SUBSCRIBER)' : (profile.role ? profile.role.name.toUpperCase() : 'STAFF') %></span>
                        </div>
                      </div>
                    </div>

                    <div class="system-stat-box">
                      <div class="system-stat-icon"><i class="ti ti-clock-check"></i></div>
                      <div class="system-stat-meta">
                        <div class="stat-label">Account Status</div>
                        <div class="stat-value">
                          <span class="badge-modern <%= profile.is_active ? 'success' : 'danger' %>">
                            <%= profile.is_active ? 'Active & Ready' : 'Suspended' %>
                          </span>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

            </div>

          </div>
        </main>

        <%- include('../partials/footer.ejs') %>
      </div>
    </div>
  </div>

<!-- ==========================================================
     SCRIPTS & JQUERY VALIDATION ENGINE
     ========================================================== -->
<script>
function handleSaveStoreBusiness(e) {
  e.preventDefault();
  const btn = document.getElementById('saveStoreBtn');
  btn.disabled = true;
  btn.innerHTML = '<i class="ti ti-loader rotate"></i> Saving...';

  const data = {
    name: document.getElementById('store_name').value,
    gstin: document.getElementById('store_gstin').value,
    phone: document.getElementById('store_phone').value,
    email: document.getElementById('store_email').value,
    address: document.getElementById('store_address').value,
    city: document.getElementById('store_city').value,
    state: document.getElementById('store_state').value
  };

  fetch('/subscriber/profile', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(data)
  })
  .then(res => res.json())
  .then(result => {
    btn.disabled = false;
    btn.innerHTML = '<i class="ti ti-building-store"></i> Update Store Details';
    if (result.success) {
      showAlert('Store details updated successfully!', 'success');
      const hint = document.getElementById('saveStoreStatusHint');
      if (hint) {
        hint.style.display = 'inline';
        setTimeout(() => { hint.style.display = 'none'; }, 3000);
      }
    } else {
      showAlert(result.error || 'Failed to update store details', 'danger');
    }
  })
  .catch(err => {
    btn.disabled = false;
    btn.innerHTML = '<i class="ti ti-building-store"></i> Update Store Details';
    showAlert('Error saving store details', 'danger');
  });
}

function showAlert(msg, type) {
  const el = document.getElementById('profileAlert');
  if (!el) return;
  el.className = 'alert-banner alert-' + type;
  el.innerHTML = `<i class="ti ti-${type === 'success' ? 'circle-check' : 'alert-circle'}"></i> ${msg}`;
  el.style.display = 'flex';
  window.scrollTo({ top: 0, behavior: 'smooth' });
  setTimeout(() => { el.style.display = 'none'; }, 5000);
}

// Trigger hidden file input
function triggerAvatarUpload() {
  const fileInput = document.getElementById('avatarFileInput');
  if (fileInput) fileInput.click();
}

// Handle Avatar Selection & Upload
function handleAvatarFileSelect(input) {
  if (!input.files || !input.files[0]) return;
  const file = input.files[0];

  // Validate File Type
  const validTypes = ['image/png', 'image/jpeg', 'image/jpg', 'image/webp'];
  if (!validTypes.includes(file.type)) {
    if (typeof showError === 'function') {
      showError('Invalid File Type', 'Please upload a PNG, JPG, or WebP image.');
    } else {
      alert('Please upload a PNG, JPG, or WebP image.');
    }
    input.value = '';
    return;
  }

  // Validate File Size (Max 5MB)
  if (file.size > 5 * 1024 * 1024) {
    if (typeof showError === 'function') {
      showError('File Too Large', 'Profile photo must be less than 5MB.');
    } else {
      alert('Profile photo must be less than 5MB.');
    }
    input.value = '';
    return;
  }

  // Read base64 data and upload via AJAX
  const reader = new FileReader();
  reader.onload = function(e) {
    const base64Data = e.target.result;

    // Instant local preview
    $('#profileAvatarImg').attr('src', base64Data);

    if (typeof showPageLoader === 'function') {
      showPageLoader('Uploading profile photo...');
    }

    fetch('/admin/users/profile/avatar', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Accept': 'application/json'
      },
      body: JSON.stringify({ avatarData: base64Data })
    })
    .then(res => res.json().then(data => ({ ok: res.ok, data })))
    .then(({ ok, data }) => {
      if (typeof hidePageLoader === 'function') hidePageLoader();

      if (!ok || !data.success) {
        if (typeof showError === 'function') {
          showError('Upload Failed', data.error || 'Could not update profile photo.');
        } else {
          alert(data.error || 'Could not update profile photo.');
        }
      } else {
        // Update avatar in UI
        const newAvatar = data.avatar;
        $('#profileAvatarImg').attr('src', newAvatar);
        $('#removeAvatarBtn').show();

        // Update header & sidebar avatar images dynamically
        $('.header-user-avatar-img').attr('src', newAvatar);
        $('.user-avatar-small').attr('src', newAvatar);

        if (typeof showToast === 'function') {
          showToast('success', 'Profile photo updated successfully!');
        } else if (typeof showSuccess === 'function') {
          showSuccess('Success', 'Profile photo updated successfully!');
        }
      }
    })
    .catch(err => {
      if (typeof hidePageLoader === 'function') hidePageLoader();
      if (typeof showError === 'function') {
        showError('Network Error', 'Failed to upload photo. Please check your connection.');
      }
    });
  };

  reader.readAsDataURL(file);
}

// Remove Avatar Handler
function handleRemoveAvatar() {
  if (typeof Swal !== 'undefined') {
    Swal.fire({
      title: 'Remove Profile Photo?',
      text: 'Your profile avatar will be reset to the default image.',
      icon: 'question',
      showCancelButton: true,
      confirmButtonColor: '#ef4444',
      confirmButtonText: 'Yes, Remove Photo',
      cancelButtonText: 'Cancel'
    }).then((result) => {
      if (result.isConfirmed) {
        executeRemoveAvatar();
      }
    });
  } else {
    if (confirm('Are you sure you want to remove your profile photo?')) {
      executeRemoveAvatar();
    }
  }
}

function executeRemoveAvatar() {
  if (typeof showPageLoader === 'function') showPageLoader('Removing photo...');

  fetch('/admin/users/profile/avatar', {
    method: 'DELETE',
    headers: { 'Accept': 'application/json' }
  })
  .then(res => res.json().then(data => ({ ok: res.ok, data })))
  .then(({ ok, data }) => {
    if (typeof hidePageLoader === 'function') hidePageLoader();

    if (ok && data.success) {
      const defaultImg = '/assets/images/profile/user-1.jpg';
      $('#profileAvatarImg').attr('src', defaultImg);
      $('#removeAvatarBtn').hide();
      $('#avatarFileInput').val('');

      $('.header-user-avatar-img').attr('src', defaultImg);
      $('.user-avatar-small').attr('src', defaultImg);

      if (typeof showToast === 'function') {
        showToast('success', 'Profile photo removed.');
      }
    } else {
      if (typeof showError === 'function') {
        showError('Error', data.error || 'Failed to remove profile photo.');
      }
    }
  })
  .catch(() => {
    if (typeof hidePageLoader === 'function') hidePageLoader();
  });
}

// ==========================================================
// AUTHORIZED SIGNATORY & SIGNATURE CONTROLLER
// ==========================================================
function updateSignatoryPreview() {
  const nameVal = $('#p_signatory_name').val().trim();
  const defaultName = $('#heroProfileName').text().trim() || 'Staff Name';
  $('#previewSignName').text(nameVal || defaultName);

  const desigVal = $('#p_signatory_designation').val().trim();
  $('#previewSignDesignation').text(desigVal || 'AUTHORIZED SIGNATORY');
}

function switchSignatureTab(tab) {
  if (tab === 'upload') {
    $('#tabPaneUploadSign').show();
    $('#tabPaneDrawSign').hide();
    $('#btnTabUploadSign').addClass('active').css({ background: '#1366d9', color: '#ffffff' });
    $('#btnTabDrawSign').removeClass('active').css({ background: '#f1f5f9', color: '#475569' });
  } else {
    $('#tabPaneUploadSign').hide();
    $('#tabPaneDrawSign').show();
    $('#btnTabDrawSign').addClass('active').css({ background: '#1366d9', color: '#ffffff' });
    $('#btnTabUploadSign').removeClass('active').css({ background: '#f1f5f9', color: '#475569' });
    initSignaturePad();
  }
}

// Handle File Selection
function handleSignatureFileSelect(input) {
  if (!input.files || !input.files[0]) return;
  const file = input.files[0];

  const validTypes = ['image/png', 'image/jpeg', 'image/jpg', 'image/webp'];
  if (!validTypes.includes(file.type)) {
    Swal.fire({
      icon: 'error',
      title: 'Invalid File Format',
      text: 'Please upload a PNG, JPG, or WebP image.',
      confirmButtonColor: '#ef4444'
    });
    input.value = '';
    return;
  }

  if (file.size > 3 * 1024 * 1024) {
    Swal.fire({
      icon: 'warning',
      title: 'File Too Large',
      text: 'Signature image must be less than 3MB.',
      confirmButtonColor: '#4f46e5'
    });
    input.value = '';
    return;
  }

  const reader = new FileReader();
  reader.onload = function(e) {
    const base64Data = e.target.result;
    executeUploadSignature(base64Data);
  };
  reader.readAsDataURL(file);
}

function executeUploadSignature(base64Data) {
  if (typeof showPageLoader === 'function') showPageLoader('Uploading signature...');

  fetch('/admin/users/profile/signature', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'Accept': 'application/json'
    },
    body: JSON.stringify({ signatureData: base64Data })
  })
  .then(res => res.json().then(data => ({ ok: res.ok, data })))
  .then(({ ok, data }) => {
    if (typeof hidePageLoader === 'function') hidePageLoader();
    if (ok && data.success) {
      $('#previewSignatureImg').attr('src', data.signature_image).show();
      $('#previewSignEmpty').hide();
      $('#removeSignatureBtn').show();
      $('#signatoryStatusBadge').removeClass('secondary').addClass('success').html('<i class="ti ti-circle-check"></i> Signature Active');
      $('#leftSignatoryStatusText').text('Signature Active');
      Swal.fire({
        icon: 'success',
        title: 'Signature Activated!',
        text: 'Your digital signature will now appear on all printed and digital invoices.',
        confirmButtonColor: '#4f46e5',
        timer: 2000,
        showConfirmButton: false
      });
    } else {
      Swal.fire({
        icon: 'error',
        title: 'Upload Failed',
        text: data.error || 'Failed to upload signature.',
        confirmButtonColor: '#ef4444'
      });
    }
  })
  .catch(err => {
    if (typeof hidePageLoader === 'function') hidePageLoader();
    Swal.fire({
      icon: 'error',
      title: 'Network Error',
      text: 'Failed to upload signature due to a network error.',
      confirmButtonColor: '#ef4444'
    });
  });
}

// Remove Signature
function handleRemoveSignature() {
  Swal.fire({
    title: 'Remove Signature?',
    text: 'Are you sure you want to remove your digital signature? It will no longer appear on invoices.',
    icon: 'warning',
    showCancelButton: true,
    confirmButtonColor: '#ef4444',
    cancelButtonColor: '#64748b',
    confirmButtonText: '<i class="ti ti-trash"></i> Yes, Remove Signature',
    cancelButtonText: 'Cancel'
  }).then((result) => {
    if (result.isConfirmed) executeRemoveSignature();
  });
}

function executeRemoveSignature() {
  if (typeof showPageLoader === 'function') showPageLoader('Removing signature...');

  fetch('/admin/users/profile/signature', {
    method: 'DELETE',
    headers: { 'Accept': 'application/json' }
  })
  .then(res => res.json().then(data => ({ ok: res.ok, data })))
  .then(({ ok, data }) => {
    if (typeof hidePageLoader === 'function') hidePageLoader();
    if (ok && data.success) {
      $('#previewSignatureImg').hide().attr('src', '');
      $('#previewSignEmpty').show();
      $('#removeSignatureBtn').hide();
      $('#signatureFileInput').val('');
      $('#signatoryStatusBadge').removeClass('success').addClass('secondary').html('<i class="ti ti-info-circle"></i> No Signature Set');
      $('#leftSignatoryStatusText').text('Not Set');
      Swal.fire({
        icon: 'success',
        title: 'Signature Removed',
        text: 'Your digital signature has been removed from invoices.',
        confirmButtonColor: '#4f46e5',
        timer: 1800,
        showConfirmButton: false
      });
    } else {
      Swal.fire({
        icon: 'error',
        title: 'Error',
        text: data.error || 'Failed to remove signature.',
        confirmButtonColor: '#ef4444'
      });
    }
  })
  .catch(() => {
    if (typeof hidePageLoader === 'function') hidePageLoader();
    Swal.fire({
      icon: 'error',
      title: 'Network Error',
      text: 'Failed to communicate with server.',
      confirmButtonColor: '#ef4444'
    });
  });
}

// ==========================================================
// STORE RUBBER STAMP & SEAL CONTROLLER
// ==========================================================
function handleStampFileSelect(input) {
  if (!input.files || !input.files[0]) return;
  const file = input.files[0];

  const validTypes = ['image/png', 'image/jpeg', 'image/jpg', 'image/webp'];
  if (!validTypes.includes(file.type)) {
    Swal.fire({
      icon: 'error',
      title: 'Invalid File Format',
      text: 'Please upload a PNG, JPG, or WebP image.',
      confirmButtonColor: '#ef4444'
    });
    input.value = '';
    return;
  }

  if (file.size > 3 * 1024 * 1024) {
    Swal.fire({
      icon: 'warning',
      title: 'File Too Large',
      text: 'Stamp image must be less than 3MB.',
      confirmButtonColor: '#4f46e5'
    });
    input.value = '';
    return;
  }

  const reader = new FileReader();
  reader.onload = function(e) {
    const base64Data = e.target.result;
    executeUploadStamp(base64Data);
  };
  reader.readAsDataURL(file);
}

function executeUploadStamp(base64Data) {
  Swal.fire({
    title: 'Uploading Store Stamp...',
    text: 'Saving official stamp image for invoices',
    allowOutsideClick: false,
    didOpen: () => Swal.showLoading()
  });

  fetch('/admin/users/profile/stamp', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'Accept': 'application/json'
    },
    body: JSON.stringify({ stampData: base64Data })
  })
  .then(res => res.json().then(data => ({ ok: res.ok, data })))
  .then(({ ok, data }) => {
    if (ok && data.success) {
      $('#previewStampImg').attr('src', data.stamp_image).show();
      $('#previewSignEmpty').hide();
      $('#removeStampBtn').show();
      $('#stampStatusBadge').removeClass('secondary').addClass('success').text('Stamp Active');
      Swal.fire({
        icon: 'success',
        title: 'Official Stamp Activated!',
        text: 'Your official store stamp will now be printed on all invoices along with your signature.',
        confirmButtonColor: '#4f46e5',
        timer: 2000,
        showConfirmButton: false
      });
    } else {
      Swal.fire({
        icon: 'error',
        title: 'Upload Failed',
        text: data.error || 'Failed to upload stamp.',
        confirmButtonColor: '#ef4444'
      });
    }
  })
  .catch(() => {
    Swal.fire({
      icon: 'error',
      title: 'Network Error',
      text: 'Failed to upload stamp image.',
      confirmButtonColor: '#ef4444'
    });
  });
}

function handleRemoveStamp() {
  Swal.fire({
    title: 'Remove Store Stamp?',
    text: 'Are you sure you want to remove the rubber stamp? Invoices will only show the signature line.',
    icon: 'warning',
    showCancelButton: true,
    confirmButtonColor: '#ef4444',
    cancelButtonColor: '#64748b',
    confirmButtonText: '<i class="ti ti-trash"></i> Yes, Remove Stamp',
    cancelButtonText: 'Cancel'
  }).then((result) => {
    if (result.isConfirmed) executeRemoveStamp();
  });
}

function executeRemoveStamp() {
  fetch('/admin/users/profile/stamp', {
    method: 'DELETE',
    headers: { 'Accept': 'application/json' }
  })
  .then(res => res.json().then(data => ({ ok: res.ok, data })))
  .then(({ ok, data }) => {
    if (ok && data.success) {
      $('#previewStampImg').hide().attr('src', '');
      $('#removeStampBtn').hide();
      $('#stampFileInput').val('');
      $('#stampStatusBadge').removeClass('success').addClass('secondary').text('No Stamp Set');
      if (!$('#previewSignatureImg').is(':visible')) {
        $('#previewSignEmpty').show();
      }
      Swal.fire({
        icon: 'success',
        title: 'Stamp Removed',
        text: 'Official store stamp has been removed.',
        timer: 1800,
        showConfirmButton: false
      });
    } else {
      Swal.fire({
        icon: 'error',
        title: 'Error',
        text: data.error || 'Failed to remove stamp.',
        confirmButtonColor: '#ef4444'
      });
    }
  })
  .catch(() => {
    Swal.fire({
      icon: 'error',
      title: 'Network Error',
      text: 'Failed to communicate with server.',
      confirmButtonColor: '#ef4444'
    });
  });
}

// ----------------------------------------------------
// 1-CLICK AUTO-GENERATE CIRCULAR RUBBER STAMP
// ----------------------------------------------------
function autoGenerateStoreStamp() {
  const storeName = '<%= (profile.company && profile.company.name) ? profile.company.name : "SAMPLE STORE" %>';
  
  const canvas = document.createElement('canvas');
  canvas.width = 240;
  canvas.height = 240;
  const ctx = canvas.getContext('2d');
  const cx = 120, cy = 120;
  const stampInk = '#3730a3';

  ctx.clearRect(0, 0, 240, 240);

  // Outer circle border
  ctx.save();
  ctx.strokeStyle = stampInk;
  ctx.lineWidth = 3.5;
  ctx.beginPath();
  ctx.arc(cx, cy, 108, 0, Math.PI * 2);
  ctx.stroke();

  // Inner dashed circle
  ctx.lineWidth = 1.5;
  ctx.setLineDash([4, 3]);
  ctx.beginPath();
  ctx.arc(cx, cy, 98, 0, Math.PI * 2);
  ctx.stroke();
  ctx.setLineDash([]);

  // Second inner solid circle
  ctx.lineWidth = 1.5;
  ctx.beginPath();
  ctx.arc(cx, cy, 72, 0, Math.PI * 2);
  ctx.stroke();

  // Top curved text (Store Name)
  ctx.fillStyle = stampInk;
  ctx.font = 'bold 12px Arial, sans-serif';
  ctx.textAlign = 'center';
  ctx.textBaseline = 'middle';

  const textTop = `★ ${storeName.toUpperCase()} ★`;
  const radiusTop = 86;
  const anglePerChar = 0.12;
  const startAngle = -Math.PI / 2 - ((textTop.length - 1) * anglePerChar) / 2;

  for (let i = 0; i < textTop.length; i++) {
    const angle = startAngle + i * anglePerChar;
    ctx.save();
    ctx.translate(cx + radiusTop * Math.cos(angle), cy + radiusTop * Math.sin(angle));
    ctx.rotate(angle + Math.PI / 2);
    ctx.fillText(textTop[i], 0, 0);
    ctx.restore();
  }

  // Center Content
  ctx.font = '900 11px Arial, sans-serif';
  ctx.fillText('OFFICIAL SEAL', cx, cy - 16);
  ctx.font = 'bold 13px Arial, sans-serif';
  ctx.fillText('★ ★ ★', cx, cy - 2);
  ctx.font = '900 9.5px Arial, sans-serif';
  ctx.fillText('AUTHORIZED', cx, cy + 12);
  ctx.fillText('SIGNATORY', cx, cy + 24);

  // Subtle ink texture speckles
  ctx.fillStyle = stampInk;
  for (let i = 0; i < 45; i++) {
    const rx = cx + (Math.random() - 0.5) * 200;
    const ry = cy + (Math.random() - 0.5) * 200;
    if (Math.hypot(rx - cx, ry - cy) < 108) {
      ctx.globalAlpha = Math.random() * 0.25;
      ctx.fillRect(rx, ry, Math.random() * 2 + 0.5, Math.random() * 2 + 0.5);
    }
  }
  ctx.restore();

  const stampDataUrl = canvas.toDataURL('image/png');
  executeUploadStamp(stampDataUrl);
}

