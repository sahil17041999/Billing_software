                          <!-- Layer 2: Signature -->
                          <img id="previewSignatureImg" src="<%= profile.signature_image || '' %>" alt="Signature Preview" 
                               style="<%= profile.signature_image ? 'position: relative; z-index: 2; max-height: 52px; max-width: 170px; object-fit: contain;' : 'display: none;' %>" />
