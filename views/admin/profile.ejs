                        <div id="previewSignName" style="font-size: 12.5px; font-weight: 800; color: #0f172a; line-height: 1.2;">
                          <%= profile.signatory_name || (profile.first_name ? (profile.first_name + ' ' + (profile.last_name || '')) : profile.username) %>
