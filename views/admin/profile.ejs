                      </form>
                    </div>

                    <!-- Right: Authentic Invoice Sign-Box Preview (With Stamp & Signature Layered) -->
                    <div>
                      <div style="font-size: 12px; font-weight: 700; color: #475569; margin-bottom: 8px; display: flex; align-items: center; gap: 6px;">
