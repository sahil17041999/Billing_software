                        </div>

                        <!-- Buttons: Save -->
                        <div style="display: flex; gap: 10px; align-items: center; margin-top: 18px;">
                          <button type="submit" class="btn-modern btn-primary-modern" id="saveSignatoryBtn" style="font-weight: 700; padding: 9px 24px;">
                            <i class="ti ti-device-floppy"></i> Save Signatory Details
                          </button>
