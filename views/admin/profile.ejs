                            <input type="file" id="signatureFileInput" accept="image/png, image/jpeg, image/jpg, image/webp" style="display: none;" onchange="handleSignatureFileSelect(this)">
                            <button type="button" class="btn-modern btn-primary-modern btn-sm-modern" onclick="document.getElementById('signatureFileInput').click()">
                              <i class="ti ti-folder-open"></i> Browse Signature File
