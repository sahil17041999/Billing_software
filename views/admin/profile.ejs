                        </div>
                        <div id="previewSignContainer" style="position: relative; height: 72px; display: flex; align-items: center; justify-content: center; margin-bottom: 8px; border-bottom: 1.5px dashed #94a3b8; padding-bottom: 4px;">
                          <!-- Layer 1: Official Stamp -->
                          <img id="previewStampImg" src="<%= profile.stamp_image || '' %>" alt="Stamp Preview" 
