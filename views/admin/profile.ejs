                            </div>
                          </div>
                        </div>

                        <!-- 2. Official Rubber Stamp / Seal Section -->
                        <div style="margin-bottom: 20px; padding: 16px; border: 1.5px solid #e2e8f0; border-radius: 12px; background: #fdfefe;">
                          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                            <label class="form-label-modern" style="font-weight: 700; margin: 0; display: flex; align-items: center; gap: 6px;">
                              <i class="ti ti-stamp" style="color: #7c3aed; font-size: 18px;"></i> 2. Official Store Rubber Stamp / Seal
                            </label>
                            <span class="badge-modern <%= profile.stamp_image ? 'success' : 'secondary' %>" id="stampStatusBadge" style="font-size: 10.5px;">
                              <%= profile.stamp_image ? 'Stamp Active' : 'No Stamp Set' %>
                            </span>
                          </div>
                          <p style="font-size: 11.5px; color: #64748b; margin-top: 0; margin-bottom: 12px;">
                            Upload your official circular/rectangular store stamp image, or generate an authentic digital ink stamp with one click.
                          </p>

                          <div style="display: flex; gap: 10px; flex-wrap: wrap; align-items: center;">
                            <input type="file" id="stampFileInput" accept="image/png, image/jpeg, image/jpg, image/webp" style="display: none;" onchange="handleStampFileSelect(this)">
                            <button type="button" class="btn-modern btn-primary-modern btn-sm-modern" onclick="document.getElementById('stampFileInput').click()">
                              <i class="ti ti-upload"></i> Upload Stamp Image
                            </button>
                            <button type="button" class="btn-modern btn-success-modern btn-sm-modern" onclick="autoGenerateStoreStamp()" title="Auto-create circular rubber stamp">
                              <i class="ti ti-wand"></i> Auto-Generate Digital Stamp
                            </button>
                            <button type="button" class="btn-modern btn-secondary-modern btn-sm-modern" id="removeStampBtn" onclick="handleRemoveStamp()" 
                                    style="<%= profile.stamp_image ? '' : 'display: none;' %> color: #ef4444; font-weight: 700;">
                              <i class="ti ti-trash"></i> Remove Stamp
                            </button>
