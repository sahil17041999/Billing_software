<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Products Catalog - Grocery Billing ERP</title>
  <link rel="shortcut icon" type="image/png" href="/assets/images/logos/favicon.png" />
  <link rel="stylesheet" href="/assets/css/icons/tabler-icons/tabler-icons.css" />
  <link rel="stylesheet" href="/assets/css/admin-theme.css" />
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.6/dist/JsBarcode.all.min.js"></script>

  <style>
    .barcode-chip-btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 3px 9px;
      background: #f1f5f9;
      color: #1e293b;
      border: 1px solid #cbd5e1;
      border-radius: 6px;
      font-family: var(--font-mono, monospace);
      font-size: 11.5px;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.15s ease;
      white-space: nowrap;
    }
    .barcode-chip-btn:hover {
      background: #e0e7ff;
      color: #3730a3;
      border-color: #818cf8;
      transform: translateY(-1px);
      box-shadow: 0 2px 5px rgba(99, 102, 241, 0.2);
    }
    .barcode-chip-btn i {
      font-size: 14px;
      color: #4f46e5;
    }
    .btn-auto-gen-barcode {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      background: #eef2ff;
      color: #4338ca;
      border: 1px dashed #6366f1;
      font-size: 11px;
      font-weight: 700;
      padding: 3px 8px;
      border-radius: 6px;
      cursor: pointer;
      transition: all 0.15s ease;
      white-space: nowrap;
    }
    .btn-auto-gen-barcode:hover {
      background: #4338ca;
      color: #ffffff;
      border-style: solid;
      transform: scale(1.02);
    }
    .barcode-action-group {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
    }
    @media print {
      body * {
        visibility: hidden !important;
      }
      #printableStickerArea, #printableStickerArea * {
        visibility: visible !important;
      }
      #printableStickerArea {
        position: fixed !important;
        left: 0 !important;
        top: 0 !important;
        width: 100vw !important;
        background: #ffffff !important;
        padding: 10px !important;
        margin: 0 !important;
        display: flex !important;
        flex-wrap: wrap !important;
        gap: 8px !important;
      }
      .no-print {
        display: none !important;
      }
    }
  </style>
</head>
<body>
  <div class="admin-layout">
    <!-- Sidebar -->
    <%- include('../../partials/sidebar.ejs', { currentPage: 'master' }) %>

    <div class="page-wrapper">
      <div class="body-wrapper">
        <!-- Header -->
        <%- include('../../partials/header.ejs') %>

        <main class="page-content">
          <!-- Page Header -->
          <div class="page-title-box">
            <div class="page-title-left">
              <h1 class="page-main-heading">
                <i class="ti ti-package" style="color: var(--primary);"></i> Products Catalog
              </h1>
              <p class="page-subheading">Manage retail inventory items, barcodes, prices, and stock limits</p>
            </div>
            
            <div class="page-title-actions">
              <button class="btn-modern btn-primary-modern" onclick="openModal()">
                <i class="ti ti-plus"></i> Add New Product
              </button>
            </div>
          </div>

          <!-- Main Table Card -->
          <div class="card-modern">
            <div class="card-body-modern">
              
              <!-- Toolbar -->
              <div class="toolbar-modern">
                <div class="search-input-group">
                  <i class="ti ti-search icon"></i>
                  <input type="text" id="searchInput" placeholder="Search by name, SKU, or barcode..." onkeydown="if(event.key==='Enter') searchProducts()">
                </div>
                <button class="btn-modern btn-secondary-modern" onclick="searchProducts()">
                  <i class="ti ti-search"></i> Search
                </button>
              </div>

              <!-- Data Table -->
              <div class="table-responsive-wrapper">
                <table class="table-modern" id="productsTable">
                  <thead>
                    <tr>
                      <th style="width: 60px;">ID</th>
                      <th>Product Name</th>
                      <th>SKU</th>
                      <th>Barcode</th>
                      <th>Category</th>
                      <th>Brand</th>
                      <th>Unit</th>
                      <th style="text-align: right;">Cost Price</th>
                      <th style="text-align: right;">Selling Price</th>
                      <th style="text-align: center;">Min Stock</th>
                      <th style="text-align: center;">Actions</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% if (products.length === 0) { %>
                      <tr>
                        <td colspan="11" class="table-empty-state">
                          <i class="ti ti-box-off icon"></i>
                          <p>No products found in inventory.</p>
                          <button class="btn-modern btn-primary-modern btn-sm-modern" onclick="openModal()" style="margin-top: 8px;">
                            <i class="ti ti-plus"></i> Add First Product
                          </button>
                        </td>
                      </tr>
                    <% } %>
                    <% products.forEach(product => { %>
                      <tr>
                        <td><span style="font-family: var(--font-mono); color: var(--text-light); font-weight: 600;">#<%= product.id %></span></td>
                        <td>
                          <strong><%= product.name %></strong>
                          <% if (product.tax) { %>
                            <div style="font-size: 11px; color: var(--text-muted);">GST: <%= product.tax.rate %>%</div>
                          <% } %>
                        </td>
                        <td><span style="font-family: var(--font-mono); font-size: 12px;"><%= product.sku || '-' %></span></td>
                        <td id="barcodeCell_<%= product.id %>">
                          <% if (product.barcode) { %>
                            <button type="button" class="barcode-chip-btn" 
                                    data-id="<%= product.id %>"
                                    data-name="<%= product.name %>"
                                    data-barcode="<%= product.barcode %>"
                                    data-sku="<%= product.sku || '' %>"
                                    data-price="<%= product.selling_price %>"
                                    data-unit="<%= product.unit ? product.unit.name : 'Pcs' %>"
                                    onclick="handleBarcodeChipClick(this)"
                                    title="Click to view &amp; print scannable barcode label">
                              <i class="ti ti-barcode"></i>
                              <span><%= product.barcode %></span>
                            </button>
                          <% } else { %>
                            <button type="button" class="btn-auto-gen-barcode" 
                                    data-id="<%= product.id %>"
                                    data-name="<%= product.name %>"
                                    onclick="quickGenerateBarcodeFromBtn(this)" 
                                    title="⚡ Click to auto-generate 13-digit EAN Barcode">
                              <i class="ti ti-wand"></i> + Barcode
                            </button>
                          <% } %>
                        </td>
                        <td><%= product.category ? product.category.name : '-' %></td>
                        <td><%= product.brand ? product.brand.name : '-' %></td>
                        <td><span class="badge-modern secondary"><%= product.unit ? product.unit.name : '-' %></span></td>
                        <td style="text-align: right;" class="amount-cell">₹<%= Number(product.purchase_price).toFixed(2) %></td>
                        <td style="text-align: right; color: var(--primary);" class="amount-cell">₹<%= Number(product.selling_price).toFixed(2) %></td>
                        <td style="text-align: center;">
                          <span class="badge-modern <%= product.min_stock_level > 10 ? 'info' : 'warning' %>">
                            <%= product.min_stock_level %>
                          </span>
                        </td>
                        <td style="text-align: center;">
                          <div class="barcode-action-group">
                            <button class="btn-modern btn-secondary-modern btn-sm-modern" 
                              data-id="<%= product.id %>" 
                              data-name="<%= product.name %>" 
                              data-sku="<%= product.sku || '' %>" 
                              data-barcode="<%= product.barcode || '' %>" 
                              data-category="<%= product.category_id %>" 
                              data-brand="<%= product.brand_id || '' %>" 
                              data-unit="<%= product.unit_id || '' %>" 
                              data-tax="<%= product.tax_id || '' %>"
                              data-purchase="<%= product.purchase_price %>" 
                              data-selling="<%= product.selling_price %>" 
                              data-minstock="<%= product.min_stock_level %>" 
                              data-reorder="<%= product.reorder_quantity || 0 %>"
                              data-description="<%= product.description || '' %>"
                              onclick="editProduct(this)" title="Edit product details">
                              <i class="ti ti-edit"></i> Edit
                            </button>
                            <button type="button" class="btn-modern btn-sm-modern" 
                              style="background: #f8fafc; border: 1px solid #cbd5e1; color: #4338ca; font-weight: 700; padding: 4px 8px;"
                              data-id="<%= product.id %>"
                              data-name="<%= product.name %>"
                              data-barcode="<%= product.barcode || '' %>"
                              data-sku="<%= product.sku || '' %>"
                              data-price="<%= product.selling_price %>"
                              data-unit="<%= product.unit ? product.unit.name : 'Pcs' %>"
                              onclick="handleBarcodeChipClick(this)"
                              title="Print &amp; Scan Barcode Sticker">
                              <i class="ti ti-barcode" style="font-size: 15px;"></i>
                            </button>
                          </div>
                        </td>
                      </tr>
                    <% }); %>
                  </tbody>
                </table>
              </div>

              <!-- Pagination -->
              <div class="pagination-modern">
                <span style="font-size: 13px; color: var(--text-muted);">
                  Showing Page <strong><%= page %></strong> of <strong><%= Math.max(1, Math.ceil(total / limit)) %></strong> (<%= total %> total items)
                </span>
                <div class="pagination-controls">
                  <% if (page > 1) { %>
                    <a href="?page=<%= page - 1 %>&limit=<%= limit %>" class="page-btn-modern">
                      <i class="ti ti-chevron-left"></i> Previous
                    </a>
                  <% } %>
                  <% if (page * limit < total) { %>
                    <a href="?page=<%= page + 1 %>&limit=<%= limit %>" class="page-btn-modern">
                      Next <i class="ti ti-chevron-right"></i>
                    </a>
                  <% } %>
                </div>
              </div>

            </div>
          </div>

        </main>

        <!-- Footer -->
        <%- include('../../partials/footer.ejs') %>
      </div>
    </div>
  </div>

  <!-- Modern Add/Edit Modal Dialog -->
  <div id="productModal" class="modal-backdrop-modern">
    <div class="modal-dialog-modern">
      <div class="modal-header-modern">
        <h2 class="modal-title-modern" id="modalTitle">
          <i class="ti ti-plus" style="color: var(--primary);"></i> <span>Add New Product</span>
        </h2>
        <button type="button" class="modal-close-btn" onclick="closeModal()" title="Close dialog">
          <i class="ti ti-x"></i>
        </button>
      </div>

      <form id="productForm" novalidate>
        <div class="modal-body-modern">
          <input type="hidden" id="productId" name="id">
          
          <div class="form-group-modern">
            <label class="form-label-modern" for="name">Product Title <span class="required-dot">*</span></label>
            <input type="text" id="name" name="name" class="form-control-modern" placeholder="e.g. Basmati Rice 5kg" required>
            <div class="field-feedback" id="nameFeedback" style="display:none; color: var(--danger); font-size: 11.5px; margin-top: 4px;">Product name is required</div>
          </div>

          <div class="form-grid-2">
            <div class="form-group-modern">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                <label class="form-label-modern" for="sku" style="margin: 0;">SKU Code</label>
                <button type="button" class="btn-modern btn-secondary-modern btn-sm-modern" onclick="generateModalSku()" style="padding: 2px 7px; font-size: 10.5px;" title="Auto-generate unique SKU">
                  <i class="ti ti-wand"></i> Gen SKU
                </button>
              </div>
              <input type="text" id="sku" name="sku" class="form-control-modern" placeholder="e.g. RICE-001">
            </div>
            <div class="form-group-modern">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                <label class="form-label-modern" for="barcode" style="margin: 0;">Barcode / EAN</label>
                <button type="button" class="btn-modern btn-primary-modern btn-sm-modern" onclick="generateModalBarcode()" style="padding: 2px 8px; font-size: 10.5px; font-weight: 700;" title="Generate 13-digit retail barcode">
                  <i class="ti ti-wand"></i> ⚡ Auto Gen
                </button>
              </div>
              <input type="text" id="barcode" name="barcode" class="form-control-modern" placeholder="e.g. 890123456789" oninput="renderModalBarcodePreview(this.value)">
            </div>
          </div>

          <!-- Live Modal Barcode Preview Box -->
          <div id="modalBarcodePreviewBox" style="margin-top: -6px; margin-bottom: 16px; padding: 10px 14px; background: #f8fafc; border: 1.5px dashed #cbd5e1; border-radius: 10px; text-align: center; display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 64px;">
            <svg id="modalBarcodeSvg" style="max-height: 48px; max-width: 100%; display: none;"></svg>
            <div id="modalBarcodePlaceholder" style="font-size: 11.5px; color: #94a3b8; display: flex; align-items: center; gap: 6px;">
              <i class="ti ti-barcode"></i> Click "Auto Gen" or type digits to preview scannable barcode
            </div>
          </div>

          <div class="form-grid-3">
            <div class="form-group-modern">
              <label class="form-label-modern" for="category_id">Category <span class="required-dot">*</span></label>
              <select id="category_id" name="category_id" class="form-control-modern" required>
                <option value="">Select Category</option>
                <% categories.forEach(category => { %>
                  <option value="<%= category.id %>"><%= category.name %></option>
                <% }); %>
              </select>
            </div>

            <div class="form-group-modern">
              <label class="form-label-modern" for="brand_id">Brand</label>
              <select id="brand_id" name="brand_id" class="form-control-modern">
                <option value="">Select Brand (Optional)</option>
                <% brands.forEach(brand => { %>
                  <option value="<%= brand.id %>"><%= brand.name %></option>
                <% }); %>
              </select>
            </div>

            <div class="form-group-modern">
              <label class="form-label-modern" for="unit_id">Unit <span class="required-dot">*</span></label>
              <select id="unit_id" name="unit_id" class="form-control-modern" required>
                <option value="">Select Unit</option>
                <% units.forEach(unit => { %>
                  <option value="<%= unit.id %>"><%= unit.name %> (<%= unit.short_name || unit.name %>)</option>
                <% }); %>
              </select>
            </div>
          </div>

          <div class="form-grid-3">
            <div class="form-group-modern">
              <label class="form-label-modern" for="tax_id">Tax / GST</label>
              <select id="tax_id" name="tax_id" class="form-control-modern">
                <option value="">No Tax / Exempt (0%)</option>
                <% taxes.forEach(tax => { %>
                  <option value="<%= tax.id %>"><%= tax.name %> (<%= tax.rate %>%)</option>
                <% }); %>
              </select>
            </div>

            <div class="form-group-modern">
              <label class="form-label-modern" for="purchase_price">Purchase Cost (₹) <span class="required-dot">*</span></label>
              <input type="number" step="0.01" min="0" id="purchase_price" name="purchase_price" class="form-control-modern" placeholder="0.00" required>
            </div>

            <div class="form-group-modern">
              <label class="form-label-modern" for="selling_price">Selling Price (₹) <span class="required-dot">*</span></label>
              <input type="number" step="0.01" min="0" id="selling_price" name="selling_price" class="form-control-modern" placeholder="0.00" required>
            </div>
          </div>

          <div class="form-grid-2">
            <div class="form-group-modern">
              <label class="form-label-modern" for="min_stock_level">Min Stock Alert Level</label>
              <input type="number" id="min_stock_level" name="min_stock_level" class="form-control-modern" min="0" value="5">
            </div>
            <div class="form-group-modern">
              <label class="form-label-modern" for="reorder_quantity">Reorder Quantity</label>
              <input type="number" id="reorder_quantity" name="reorder_quantity" class="form-control-modern" min="0" value="20">
            </div>
          </div>

          <div class="form-group-modern">
            <label class="form-label-modern" for="description">Product Description</label>
            <textarea id="description" name="description" class="form-control-modern" rows="2" placeholder="Optional product description or notes..."></textarea>
          </div>
        </div>

        <div class="modal-footer-modern">
          <button type="button" class="btn-modern btn-secondary-modern" onclick="closeModal()">
            <i class="ti ti-x"></i> Cancel
          </button>
          <button type="submit" class="btn-modern btn-primary-modern" id="modalSubmitBtn">
            <i class="ti ti-device-floppy" id="modalSubmitIcon"></i>
            <span id="modalSubmitText">Save Product</span>
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Modern Barcode Label & Print Sticker Modal Dialog -->
  <div id="barcodeLabelModal" class="modal-backdrop-modern">
    <div class="modal-dialog-modern" style="max-width: 520px;">
      <div class="modal-header-modern">
        <h2 class="modal-title-modern">
          <i class="ti ti-barcode" style="color: var(--primary);"></i> <span>Product Barcode &amp; Sticker</span>
        </h2>
        <button type="button" class="modal-close-btn" onclick="closeBarcodeModal()" title="Close dialog">
          <i class="ti ti-x"></i>
        </button>
      </div>

      <div class="modal-body-modern">
        <!-- Printable Barcode Sticker Card -->
        <div id="printableStickerArea">
          <div class="barcode-sticker-card" id="singleStickerPreview" style="background: #ffffff; border: 2px solid #0f172a; border-radius: 10px; padding: 14px; width: 100%; max-width: 290px; margin: 0 auto; box-shadow: 0 4px 14px rgba(0,0,0,0.06); text-align: center;">
            <div style="font-size: 11px; font-weight: 800; text-transform: uppercase; color: #475569; letter-spacing: 0.5px;" id="stickerStoreName">
              RETAIL BILLING STORE
            </div>
            <div style="font-size: 14px; font-weight: 800; color: #0f172a; margin: 4px 0 2px; line-height: 1.25;" id="stickerProductName">
              Product Title
            </div>
            <div style="font-size: 10.5px; color: #64748b; margin-bottom: 6px;">
              <span id="stickerSku">SKU-001</span> &bull; <span id="stickerUnit">Pcs</span>
            </div>
            
            <!-- Scannable Barcode SVG -->
            <div style="background: #ffffff; padding: 4px 0; display: flex; justify-content: center; align-items: center;">
              <svg id="stickerBarcodeSvg" style="max-width: 100%; height: 65px;"></svg>
            </div>

            <div style="font-size: 15px; font-weight: 900; color: #0f172a; margin-top: 4px;">
              MRP: <span id="stickerPrice" style="color: #2563eb;">₹0.00</span>
            </div>
            <div style="font-size: 9.5px; color: #64748b;">(Inclusive of all taxes)</div>
          </div>
        </div>

        <!-- Sticker Print Quantity and Format Controls -->
        <div class="no-print" style="margin-top: 20px; padding: 14px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 10px;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
            <span style="font-size: 12px; font-weight: 700; color: #334155;">
              <i class="ti ti-printer"></i> Print Sticker Options:
            </span>
            <span style="font-size: 11px; color: #64748b;">Thermal Roll or A4 Sheet</span>
          </div>

          <div style="display: flex; gap: 8px; align-items: center; flex-wrap: wrap;">
            <label style="font-size: 12px; color: #475569; margin: 0; font-weight: 600;">Quantity:</label>
            <select id="stickerPrintQty" class="form-control-modern" style="width: 110px; padding: 4px 8px; height: 34px; font-size: 12px;">
              <option value="1">1 Sticker</option>
              <option value="5">5 Stickers</option>
              <option value="10">10 Stickers</option>
              <option value="24">24 (A4 Sheet)</option>
              <option value="50">50 Stickers</option>
            </select>
            
            <button type="button" class="btn-modern btn-primary-modern" onclick="executePrintSticker()" style="font-weight: 700; padding: 6px 14px; font-size: 12px;">
              <i class="ti ti-printer"></i> Print Label
            </button>
            
            <button type="button" class="btn-modern btn-secondary-modern" onclick="copyBarcodeToClipboard()" style="font-weight: 700; padding: 6px 12px; font-size: 12px;" title="Copy barcode digits">
              <i class="ti ti-copy"></i> Copy
            </button>
          </div>
        </div>

        <!-- Scan & Add in POS Quick Launcher -->
        <div class="no-print" style="margin-top: 12px; display: flex; align-items: center; justify-content: space-between; padding: 12px 14px; background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 10px;">
          <div style="display: flex; align-items: center; gap: 10px;">
            <i class="ti ti-device-laptop" style="color: #2563eb; font-size: 24px;"></i>
            <div>
              <div style="font-size: 12.5px; font-weight: 700; color: #1e3a8a;">Scan &amp; Add in POS</div>
              <div style="font-size: 11px; color: #3b82f6;">Opens POS with this barcode pre-scanned and added to bill</div>
            </div>
          </div>
          <button type="button" class="btn-modern btn-primary-modern btn-sm-modern" onclick="launchInPosTerminal()" style="font-weight: 700; white-space: nowrap;">
            <i class="ti ti-shopping-cart"></i> Scan in POS &rarr;
          </button>
        </div>
      </div>

      <div class="modal-footer-modern no-print">
        <button type="button" class="btn-modern btn-secondary-modern" onclick="closeBarcodeModal()">
          <i class="ti ti-x"></i> Close
        </button>
      </div>
    </div>
  </div>

  <script>
    let currentBarcodeData = null;

    // Generate valid 13-digit retail barcode with India GS1 prefix 890
    function generateNewBarcodeDigits() {
      const rand9 = Math.floor(100000000 + Math.random() * 900000000);
      const raw12 = '890' + rand9;
      let sum = 0;
      for (let i = 0; i < 12; i++) {
        sum += parseInt(raw12[i], 10) * (i % 2 === 0 ? 1 : 3);
      }
      const checkDigit = (10 - (sum % 10)) % 10;
      return raw12 + checkDigit;
    }

    function generateModalBarcode() {
      const code = generateNewBarcodeDigits();
      $('#barcode').val(code);
      renderModalBarcodePreview(code);
    }

    function generateModalSku() {
      const sku = 'SKU-' + Math.floor(1000 + Math.random() * 9000);
      $('#sku').val(sku);
    }

    function renderModalBarcodePreview(code) {
      const svg = document.getElementById('modalBarcodeSvg');
      const placeholder = document.getElementById('modalBarcodePlaceholder');
      const val = String(code || '').trim();

      if (!val) {
        if (svg) svg.style.display = 'none';
        if (placeholder) placeholder.style.display = 'flex';
        return;
      }

      if (placeholder) placeholder.style.display = 'none';
      if (svg) {
        svg.style.display = 'block';
        try {
          if (typeof JsBarcode !== 'undefined') {
            JsBarcode(svg, val, {
              format: 'CODE128',
              width: 2,
              height: 40,
              displayValue: true,
              fontSize: 12,
              font: 'monospace',
              margin: 4
            });
          }
        } catch (e) {
          console.error('Barcode render error:', e);
        }
      }
    }

    function openBarcodeModal(data) {
      if (typeof data === 'string') {
        try { data = JSON.parse(data); } catch (e) {}
      }
      if (!data) return;

      currentBarcodeData = data;
      $('#stickerProductName').text(data.name || 'Product');
      $('#stickerSku').text(data.sku || 'N/A');
      $('#stickerUnit').text(data.unit || 'Pcs');
      $('#stickerPrice').text('₹' + Number(data.price || 0).toFixed(2));

      const code = data.barcode || generateNewBarcodeDigits();
      currentBarcodeData.barcode = code;

      // Render barcode in sticker
      const svg = document.getElementById('stickerBarcodeSvg');
      if (svg && typeof JsBarcode !== 'undefined') {
        try {
          JsBarcode(svg, code, {
            format: 'CODE128',
            width: 2,
            height: 50,
            displayValue: true,
            fontSize: 13,
            font: 'monospace',
            margin: 6
          });
        } catch (e) {
          console.error('Sticker barcode render error:', e);
        }
      }

      $('#barcodeLabelModal').addClass('show');
    }

    function handleBarcodeChipClick(btn) {
      const $btn = $(btn);
      const data = {
        id: $btn.data('id'),
        name: $btn.data('name'),
        barcode: $btn.data('barcode'),
        sku: $btn.data('sku'),
        price: $btn.data('price'),
        unit: $btn.data('unit')
      };
      openBarcodeModal(data);
    }

    function closeBarcodeModal() {
      $('#barcodeLabelModal').removeClass('show');
    }

    function executePrintSticker() {
      const qty = parseInt($('#stickerPrintQty').val()) || 1;
      const printableArea = document.getElementById('printableStickerArea');
      const singleSticker = document.getElementById('singleStickerPreview');

      if (!printableArea || !singleSticker) {
        window.print();
        return;
      }

      // Clone stickers for print quantity
      const originalContent = printableArea.innerHTML;
      let multiHtml = '';
      for (let i = 0; i < qty; i++) {
        multiHtml += singleSticker.outerHTML;
      }
      printableArea.innerHTML = multiHtml;

      window.print();

      // Restore single preview after print dialog closes
      setTimeout(() => {
        printableArea.innerHTML = originalContent;
      }, 500);
    }

    function copyBarcodeToClipboard() {
      if (!currentBarcodeData || !currentBarcodeData.barcode) return;
      navigator.clipboard.writeText(currentBarcodeData.barcode).then(() => {
        Swal.fire({
          icon: 'success',
          title: 'Barcode Copied!',
          text: `Barcode ${currentBarcodeData.barcode} copied to clipboard.`,
          timer: 1500,
          showConfirmButton: false
        });
      });
    }

    function launchInPosTerminal() {
      if (!currentBarcodeData || !currentBarcodeData.barcode) return;
      const url = `/admin/sales/pos?scan=${encodeURIComponent(currentBarcodeData.barcode)}`;
      window.location.href = url;
    }

    // Quick 1-click Barcode Generator for products without a barcode
    function quickGenerateBarcodeFromBtn(btn) {
      const $btn = $(btn);
      const id = $btn.data('id');
      const name = $btn.data('name');
      quickGenerateBarcode(id, name);
    }

    function quickGenerateBarcode(id, name) {
      Swal.fire({
        title: 'Generate Barcode?',
        html: `Generate a 13-digit EAN retail barcode for <strong>${escapeHtml(name)}</strong>?`,
        icon: 'question',
        showCancelButton: true,
        confirmButtonColor: '#4f46e5',
        cancelButtonColor: '#64748b',
        confirmButtonText: '<i class="ti ti-wand"></i> Generate &amp; Save',
        cancelButtonText: 'Cancel'
      }).then((result) => {
        if (result.isConfirmed) {
          Swal.fire({
            title: 'Generating Barcode...',
            allowOutsideClick: false,
            didOpen: () => Swal.showLoading()
          });

          const apiBase = window.location.pathname.startsWith('/subscriber') ? '/subscriber' : '/admin';
          fetch(`${apiBase}/master/products/${id}/barcode`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json'
            },
            body: JSON.stringify({})
          })
          .then(res => res.json().then(data => ({ ok: res.ok, data })))
          .then(({ ok, data }) => {
            if (ok && data.success) {
              const cell = $(`#barcodeCell_${id}`);
              if (cell.length) {
                cell.html(`
                  <button type="button" class="barcode-chip-btn" 
                          data-id="${id}"
                          data-name="${escapeHtml(name)}"
                          data-barcode="${data.barcode}"
                          data-sku=""
                          data-price="0"
                          data-unit="Pcs"
                          onclick="handleBarcodeChipClick(this)"
                          title="Click to view &amp; print scannable barcode label">
                    <i class="ti ti-barcode"></i>
                    <span>${data.barcode}</span>
                  </button>
                `);
              }

              Swal.fire({
                icon: 'success',
                title: 'Barcode Assigned!',
                html: `
                  <div style="font-size: 14px; color: #334155; margin-bottom: 8px;">
                    Assigned 13-Digit EAN Barcode: <strong style="font-family:monospace; font-size:16px; color:#4f46e5;">${data.barcode}</strong>
                  </div>
                  <div style="font-size: 12px; color: #16a34a;">
                    <i class="ti ti-check"></i> You can now scan this product in POS!
                  </div>
                `,
                confirmButtonColor: '#4f46e5',
                confirmButtonText: '<i class="ti ti-check"></i> Great!'
              });
            } else {
              Swal.fire({
                icon: 'error',
                title: 'Failed',
                text: data.error || 'Could not generate barcode.',
                confirmButtonColor: '#ef4444'
              });
            }
          })
          .catch(() => {
            Swal.fire({
              icon: 'error',
              title: 'Network Error',
              text: 'Could not connect to server.',
              confirmButtonColor: '#ef4444'
            });
          });
        }
      });
    }

    function resetValidationErrors() {
      resetFormValidation('#productForm');
    }

    function openModal() {
      $('#productForm').trigger('reset');
      $('#productId').val('');
      resetValidationErrors();
      
      $('#modalTitle').html('<i class="ti ti-plus" style="color: var(--primary);"></i> <span>Add New Product</span>');
      $('#modalSubmitIcon').attr('class', 'ti ti-device-floppy');
      $('#modalSubmitText').text('Save Product');

      generateModalSku();
      generateModalBarcode();

      $('#productModal').addClass('show');
      setTimeout(() => $('#name').focus(), 100);
    }

    function closeModal() {
      $('#productModal').removeClass('show');
      resetValidationErrors();
    }

    function editProduct(button) {
      resetValidationErrors();
      const $btn = $(button);
      
      $('#modalTitle').html('<i class="ti ti-edit" style="color: var(--primary);"></i> <span>Edit Product</span>');
      $('#modalSubmitIcon').attr('class', 'ti ti-check');
      $('#modalSubmitText').text('Update Product');
      
      $('#productId').val($btn.data('id') || '');
      $('#name').val($btn.data('name') || '');
      $('#sku').val($btn.data('sku') || '');
      const existingBarcode = $btn.data('barcode') || '';
      $('#barcode').val(existingBarcode);
      renderModalBarcodePreview(existingBarcode);

      $('#category_id').val($btn.data('category') || '');
      $('#brand_id').val($btn.data('brand') || '');
      $('#unit_id').val($btn.data('unit') || '');
      $('#tax_id').val($btn.data('tax') || '');
      $('#purchase_price').val($btn.data('purchase') || '');
      $('#selling_price').val($btn.data('selling') || '');
      $('#min_stock_level').val($btn.data('minstock') || '0');
      $('#reorder_quantity').val($btn.data('reorder') || '0');
      $('#description').val($btn.data('description') || '');
      
      $('#productModal').addClass('show');
      setTimeout(() => $('#name').focus(), 100);
    }

    function searchProducts() {
      const search = $('#searchInput').val().trim();
      const apiBase = window.location.pathname.startsWith('/subscriber') ? '/subscriber' : '/admin';
      if (typeof showPageLoader === 'function') showPageLoader('Searching products...');
      window.location.href = apiBase + '/master/products?search=' + encodeURIComponent(search);
    }

    // Initialize jQuery Validation on productForm
    $(document).ready(function() {
      const checkDupUrl = (window.location.pathname.startsWith('/subscriber') ? '/subscriber' : '/admin') + '/master/check-duplicate';
      initFormValidation('#productForm', {
        rules: {
          name: {
            required: true,
            minlength: 2,
            maxlength: 120,
            validName: true,
            remote: {
              url: checkDupUrl,
              type: 'GET',
              data: {
                entity: 'product',
                field: 'name',
                id: function() { return $('#productId').val(); }
              }
            }
          },
          sku: {
            remote: {
              url: checkDupUrl,
              type: 'GET',
              data: {
                entity: 'product',
                field: 'sku',
                id: function() { return $('#productId').val(); }
              }
            }
          },
          barcode: {
            remote: {
              url: checkDupUrl,
              type: 'GET',
              data: {
                entity: 'product',
                field: 'barcode',
                id: function() { return $('#productId').val(); }
              }
            }
          },
          category_id: { required: true },
          unit_id: { required: true },
          purchase_price: { required: true, positiveNumber: true },
          selling_price: { required: true, positiveNumber: true },
          min_stock_level: { nonNegativeNumber: true },
          reorder_quantity: { nonNegativeNumber: true }
        },
        messages: {
          name: {
            required: 'Please enter product title',
            minlength: 'Product title must be at least 2 characters',
            remote: 'A product with this title already exists in your database'
          },
          sku: {
            remote: 'A product with this SKU already exists in your database'
          },
          barcode: {
            remote: 'A product with this Barcode already exists in your database'
          },
          category_id: { required: 'Please select a category' },
          unit_id: { required: 'Please select a unit of measurement' },
          purchase_price: { required: 'Please enter cost/purchase price', positiveNumber: 'Cost price must be greater than 0' },
          selling_price: { required: 'Please enter selling price', positiveNumber: 'Selling price must be greater than 0' }
        },
        onSubmit: function(form, $form) {
          const id = $('#productId').val();
          const purchaseVal = parseFloat($('#purchase_price').val()) || 0;
          const sellingVal = parseFloat($('#selling_price').val()) || 0;
          
          if (sellingVal < purchaseVal) {
            Swal.fire({
              icon: 'warning',
              title: 'Selling Price Alert',
              text: 'Selling price is lower than purchase cost. Do you want to proceed?',
              showCancelButton: true,
              confirmButtonText: 'Yes, proceed',
              cancelButtonText: 'No, fix price'
            }).then(res => {
              if (res.isConfirmed) submitProductForm(id);
            });
            return;
          }
          submitProductForm(id);
        }
      });

      function submitProductForm(id) {
        const data = {
          name: $('#name').val().trim(),
          sku: $('#sku').val().trim(),
          barcode: $('#barcode').val().trim(),
          category_id: parseInt($('#category_id').val()),
          brand_id: $('#brand_id').val() ? parseInt($('#brand_id').val()) : null,
          unit_id: parseInt($('#unit_id').val()),
          tax_id: $('#tax_id').val() ? parseInt($('#tax_id').val()) : null,
          purchase_price: parseFloat($('#purchase_price').val()) || 0,
          selling_price: parseFloat($('#selling_price').val()) || 0,
          min_stock_level: parseInt($('#min_stock_level').val()) || 0,
          reorder_quantity: parseInt($('#reorder_quantity').val()) || 0,
          description: $('#description').val().trim()
        };

        const apiBase = window.location.pathname.startsWith('/subscriber') ? '/subscriber' : '/admin';
        const url = id ? apiBase + '/master/products/' + id : apiBase + '/master/products';
        const method = id ? 'PUT' : 'POST';
        const saveBtn = $('#modalSubmitBtn');
        saveBtn.prop('disabled', true);
        if (typeof showPageLoader === 'function') showPageLoader(id ? 'Updating Product...' : 'Saving New Product...');

        fetch(url, {
          method: method,
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify(data)
        })
        .then(res => res.json().then(json => ({ ok: res.ok, status: res.status, json })))
        .then(({ ok, json }) => {
          saveBtn.prop('disabled', false);
          if (typeof hidePageLoader === 'function') hidePageLoader();
          if (ok && json.success) {
            closeModal();
            showToast('success', id ? 'Product updated successfully!' : 'Product added successfully!');
            setTimeout(() => location.reload(), 1100);
          } else {
            const errMsg = json.errors ? Object.values(json.errors).flat().join('<br>') : (json.error || 'Failed to save product');
            if (errMsg.toLowerCase().includes('already exists')) {
              Swal.fire({
                icon: 'warning',
                title: 'Duplicate Entry',
                html: errMsg,
                confirmButtonColor: '#1366d9'
              });
              if (errMsg.toLowerCase().includes('barcode')) $('#barcode').addClass('is-invalid');
              else if (errMsg.toLowerCase().includes('sku')) $('#sku').addClass('is-invalid');
              else $('#name').addClass('is-invalid');
            } else {
              showError('Save Failed', errMsg);
            }
          }
        })
        .catch(err => {
          saveBtn.prop('disabled', false);
          if (typeof hidePageLoader === 'function') hidePageLoader();
          showError('Network Error', err.message || 'Could not connect to the server');
        });
      }

      // Close on backdrop click
      $('#productModal').on('click', function(e) {
        if (e.target === this) closeModal();
      });

      // Escape key closes modal
      $(document).on('keydown', function(e) {
        if (e.key === 'Escape') closeModal();
      });

      // Auto initialize DataTables
      if ($('#productsTable tbody tr').length > 0 && !$('#productsTable tbody td.table-empty-state').length) {
        initStandardDataTable('#productsTable', {
          order: [[0, 'desc']]
        });
      }
    });
  </script>
</body>
</html>