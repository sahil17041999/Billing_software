<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Brands - Grocery Billing ERP</title>
  <link rel="shortcut icon" type="image/png" href="/assets/images/logos/favicon.png" />
  <link rel="stylesheet" href="/assets/css/icons/tabler-icons/tabler-icons.css" />
  <link rel="stylesheet" href="/assets/css/admin-theme.css" />
</head>
<body>
  <div class="admin-layout">
    <!-- Sidebar -->
    <%- include('../../partials/sidebar.ejs', { currentPage: 'master' }) %>

    <div class="page-wrapper">
      <div class="body-wrapper">
        <!-- Header -->
        <%- include('../../partials/header.ejs') %>

        <main class="page-content">
          <!-- Page Header -->
          <div class="page-title-box">
            <div class="page-title-left">
              <h1 class="page-main-heading">
                <i class="ti ti-tags" style="color: var(--primary);"></i> Product Brands
              </h1>
              <p class="page-subheading">Manage FMCG manufacturers, labels, and product brands</p>
            </div>
            
            <div class="page-title-actions">
              <button class="btn-modern btn-primary-modern" onclick="openModal()">
                <i class="ti ti-plus"></i> Add New Brand
              </button>
            </div>
          </div>

          <!-- Main Table Card -->
          <div class="card-modern">
            <div class="card-body-modern">
              
              <div class="table-responsive-wrapper">
                <table class="table-modern">
                  <thead>
                    <tr>
                      <th style="width: 70px;">ID</th>
                      <th>Brand Name</th>
                      <th>Description</th>
                      <th style="text-align: center;">Status</th>
                      <th style="text-align: center;">Actions</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% if (brands.length === 0) { %>
                      <tr>
                        <td colspan="5" class="table-empty-state">
                          <i class="ti ti-tags-off icon"></i>
                          <p>No brands registered.</p>
                          <button class="btn-modern btn-primary-modern btn-sm-modern" onclick="openModal()" style="margin-top: 8px;">
                            <i class="ti ti-plus"></i> Add First Brand
                          </button>
                        </td>
                      </tr>
                    <% } %>
                    <% brands.forEach(brand => { %>
                      <tr>
                        <td><span style="font-family: var(--font-mono); color: var(--text-light); font-weight: 600;">#<%= brand.id %></span></td>
                        <td>
                          <strong><%= brand.name %></strong>
                        </td>
                        <td><%= brand.description || '-' %></td>
                        <td style="text-align: center;">
                          <span class="badge-modern <%= brand.is_active ? 'success' : 'secondary' %>">
                            <%= brand.is_active ? 'Active' : 'Inactive' %>
                          </span>
                        </td>
                        <td style="text-align: center;">
                          <button class="btn-modern btn-secondary-modern btn-sm-modern"
                            data-id="<%= brand.id %>"
                            data-name="<%= brand.name %>"
                            data-description="<%= brand.description || '' %>"
                            onclick="editBrand(this)" title="Edit Brand">
                            <i class="ti ti-edit"></i> Edit
                          </button>
                        </td>
                      </tr>
                    <% }); %>
                  </tbody>
                </table>
              </div>

            </div>
          </div>

        </main>

        <!-- Footer -->
        <%- include('../../partials/footer.ejs') %>
      </div>
    </div>
  </div>

  <!-- Add Modal -->
  <div id="brandModal" class="modal-backdrop-modern">
    <div class="modal-dialog-modern" style="max-width: 500px;">
      <div class="modal-header-modern">
        <h2 class="modal-title-modern" id="modalTitle">
          <i class="ti ti-tags" style="color: var(--primary);"></i> Add Product Brand
        </h2>
        <button type="button" class="modal-close-btn" onclick="closeModal()">
          <i class="ti ti-x"></i>
        </button>
      </div>

      <form id="brandForm" novalidate>
        <div class="modal-body-modern">
          <input type="hidden" id="brandId" name="id">

          <div class="form-group-modern">
            <label class="form-label-modern" for="name">Brand Name <span class="required-dot">*</span></label>
            <input type="text" id="name" name="name" class="form-control-modern" placeholder="e.g. Nestle / Fortune" required>
          </div>

          <div class="form-group-modern">
            <label class="form-label-modern" for="description">Description</label>
            <textarea id="description" name="description" class="form-control-modern" rows="3" placeholder="Optional notes..."></textarea>
          </div>
        </div>

        <div class="modal-footer-modern">
          <button type="button" class="btn-modern btn-secondary-modern" onclick="closeModal()">Cancel</button>
          <button type="submit" class="btn-modern btn-primary-modern">
            <i class="ti ti-device-floppy"></i> Save Brand
          </button>
        </div>
      </form>
    </div>
  </div>

  <script>
    function openModal() {
      $('#brandForm').trigger('reset');
      $('#brandId').val('');
      $('#modalTitle').html('<i class="ti ti-tags" style="color: var(--primary);"></i> Add Product Brand');
      $('#brandModal').addClass('show');
      setTimeout(() => $('#name').focus(), 100);
    }

    function closeModal() {
      $('#brandModal').removeClass('show');
      resetFormValidation('#brandForm');
    }

    function editBrand(button) {
      const $btn = $(button);
      $('#modalTitle').html('<i class="ti ti-edit" style="color: var(--primary);"></i> Edit Product Brand');
      $('#brandId').val($btn.data('id') || '');
      $('#name').val($btn.data('name') || '');
      $('#description').val($btn.data('description') || '');
      $('#brandModal').addClass('show');
      setTimeout(() => $('#name').focus(), 100);
    }

    $(document).ready(function() {
      initFormValidation('#brandForm', {
        rules: {
          name: {
            required: true,
            minlength: 2,
            remote: {
              url: '/admin/master/check-duplicate',
              type: 'GET',
              data: {
                entity: 'brand',
                field: 'name',
                id: function() { return $('#brandId').val(); }
              }
            }
          }
        },
        messages: {
          name: {
            required: 'Please enter brand name',
            minlength: 'Brand name must be at least 2 characters',
            remote: 'This brand name already exists in your database'
          }
        },
        onSubmit: function(form, $form) {
          const id = $('#brandId').val();
          const data = {
            name: $('#name').val().trim(),
            description: $('#description').val().trim()
          };
          const url = id ? '/admin/master/brands/' + id : '/admin/master/brands';
          const method = id ? 'PUT' : 'POST';
          const saveBtn = $form.find('[type="submit"]');
          saveBtn.prop('disabled', true);

          fetch(url, {
            method: method,
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify(data)
          }).then(res => res.json()).then(resData => {
            saveBtn.prop('disabled', false);
            if (resData.success) {
              closeModal();
              showToast('success', id ? 'Brand updated successfully!' : 'Brand added successfully!');
              setTimeout(() => location.reload(), 1100);
            } else {
              const errMsg = resData.errors ? Object.values(resData.errors).flat().join(', ') : (resData.error || 'Failed to save brand');
              if (errMsg.toLowerCase().includes('already exists')) {
                Swal.fire({
                  icon: 'warning',
                  title: 'Duplicate Entry',
                  text: errMsg,
                  confirmButtonColor: '#1366d9'
                });
                $('#name').addClass('is-invalid');
              } else {
                showError('Save Failed', errMsg);
              }
            }
          }).catch(err => {
            saveBtn.prop('disabled', false);
            showError('Network Error', 'Could not connect to the server.');
          });
        }
      });

      $('#brandModal').on('click', function(e) {
        if (e.target === this) closeModal();
      });

      $(document).on('keydown', function(e) {
        if (e.key === 'Escape') closeModal();
      });
    });
  </script>
</body>
</html>