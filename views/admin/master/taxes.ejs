<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Taxes &amp; GST Rates - Grocery Billing ERP</title>
  <link rel="shortcut icon" type="image/png" href="/assets/images/logos/favicon.png" />
  <link rel="stylesheet" href="/assets/css/icons/tabler-icons/tabler-icons.css" />
  <link rel="stylesheet" href="/assets/css/admin-theme.css" />
</head>
<body>
  <div class="admin-layout">
    <!-- Sidebar -->
    <%- include('../../partials/sidebar.ejs', { currentPage: 'master' }) %>

    <div class="page-wrapper">
      <div class="body-wrapper">
        <!-- Header -->
        <%- include('../../partials/header.ejs') %>

        <main class="page-content">
          <!-- Page Header -->
          <div class="page-title-box">
            <div class="page-title-left">
              <h1 class="page-main-heading">
                <i class="ti ti-percentage" style="color: var(--primary);"></i> Tax &amp; GST Rates
              </h1>
              <p class="page-subheading">Manage applicable GST / VAT tax brackets for groceries and goods</p>
            </div>
            <div class="page-title-actions">
              <button class="btn-modern btn-primary-modern" onclick="openModal()">
                <i class="ti ti-plus"></i> Add Tax Rate
              </button>
            </div>
          </div>

          <!-- Main Table Card -->
          <div class="card-modern" style="max-width: 800px;">
            <div class="card-body-modern">
              
              <div class="table-responsive-wrapper">
                <table class="table-modern">
                  <thead>
                    <tr>
                      <th style="width: 70px;">ID</th>
                      <th>Tax Bracket Name</th>
                      <th style="text-align: right;">Rate (%)</th>
                      <th style="text-align: center;">Status</th>
                      <th style="text-align: center;">Actions</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% if (taxes.length === 0) { %>
                      <tr>
                        <td colspan="5" class="table-empty-state">
                          <i class="ti ti-percentage-off icon"></i>
                          <p>No tax slabs configured.</p>
                          <button class="btn-modern btn-primary-modern btn-sm-modern" onclick="openModal()" style="margin-top: 8px;">
                            <i class="ti ti-plus"></i> Add Tax Rate
                          </button>
                        </td>
                      </tr>
                    <% } %>
                    <% taxes.forEach(tax => { %>
                      <tr>
                        <td><span style="font-family: var(--font-mono); color: var(--text-light); font-weight: 600;">#<%= tax.id %></span></td>
                        <td><strong><%= tax.name %></strong></td>
                        <td style="text-align: right;" class="amount-cell">
                          <span class="badge-modern info" style="font-size: 13px;"><%= tax.rate %>% GST</span>
                        </td>
                        <td style="text-align: center;">
                          <span class="badge-modern <%= tax.is_active ? 'success' : 'secondary' %>">
                            <%= tax.is_active ? 'Active' : 'Inactive' %>
                          </span>
                        </td>
                        <td style="text-align: center;">
                          <button class="btn-modern btn-secondary-modern btn-sm-modern"
                            data-id="<%= tax.id %>"
                            data-name="<%= tax.name %>"
                            data-rate="<%= tax.rate %>"
                            onclick="editTax(this)" title="Edit tax">
                            <i class="ti ti-edit"></i> Edit
                          </button>
                        </td>
                      </tr>
                    <% }); %>
                  </tbody>
                </table>
              </div>

            </div>
          </div>

        </main>

        <!-- Footer -->
        <%- include('../../partials/footer.ejs') %>
      </div>
    </div>
  </div>

  <!-- Add/Edit Modal -->
  <div id="taxModal" class="modal-backdrop-modern">
    <div class="modal-dialog-modern" style="max-width: 480px;">
      <div class="modal-header-modern">
        <h2 class="modal-title-modern" id="modalTitle">
          <i class="ti ti-percentage" style="color: var(--primary);"></i> Add Tax Rate
        </h2>
        <button type="button" class="modal-close-btn" onclick="closeModal()">
          <i class="ti ti-x"></i>
        </button>
      </div>

      <form id="taxForm" novalidate>
        <div class="modal-body-modern">
          <input type="hidden" id="taxId" name="id">

          <div class="form-group-modern">
            <label class="form-label-modern" for="taxName">Tax Name <span class="required-dot">*</span></label>
            <input type="text" id="taxName" name="name" class="form-control-modern" placeholder="e.g. GST 5%" required>
            <div class="field-error-text" id="taxNameError">Tax name is required.</div>
          </div>

          <div class="form-group-modern">
            <label class="form-label-modern" for="taxRate">Tax Rate (%) <span class="required-dot">*</span></label>
            <input type="number" step="0.01" min="0" id="taxRate" name="rate" class="form-control-modern" placeholder="e.g. 5" required>
            <div class="field-error-text" id="taxRateError">A valid tax rate is required (0 or more).</div>
          </div>
        </div>

        <div class="modal-footer-modern">
          <button type="button" class="btn-modern btn-secondary-modern" onclick="closeModal()">Cancel</button>
          <button type="submit" class="btn-modern btn-primary-modern" id="taxSaveBtn">
            <i class="ti ti-device-floppy"></i> Save Tax Rate
          </button>
        </div>
      </form>
    </div>
  </div>

  <style>
    .field-error-text { color: #f87171; font-size: 12px; margin-top: 5px; display: none; }
    .form-control-modern.is-invalid { border-color: #ef4444 !important; }
    .form-control-modern.is-invalid ~ .field-error-text { display: block; }
  </style>

  <script>
    function openModal() {
      $('#taxForm').trigger('reset');
      $('#taxId').val('');
      $('#modalTitle').html('<i class="ti ti-percentage" style="color: var(--primary);"></i> Add Tax Rate');
      $('#taxModal').addClass('show');
      setTimeout(() => $('#taxName').focus(), 100);
    }

    function closeModal() {
      $('#taxModal').removeClass('show');
      resetFormValidation('#taxForm');
    }

    function editTax(button) {
      const $btn = $(button);
      $('#modalTitle').html('<i class="ti ti-edit" style="color: var(--primary);"></i> Edit Tax Rate');
      $('#taxId').val($btn.data('id') || '');
      $('#taxName').val($btn.data('name') || '');
      $('#taxRate').val($btn.data('rate') || '');
      $('#taxModal').addClass('show');
      setTimeout(() => $('#taxName').focus(), 100);
    }

    $(document).ready(function() {
      const checkDupUrl = (window.location.pathname.startsWith('/subscriber') ? '/subscriber' : '/admin') + '/master/check-duplicate';
      initFormValidation('#taxForm', {
        entityName: 'Tax',
        rules: {
          name: {
            required: true,
            minlength: 2,
            maxlength: 50,
            validName: true,
            remote: {
              url: checkDupUrl,
              type: 'GET',
              data: {
                entity: 'tax',
                field: 'name',
                id: function() { return $('#taxId').val(); }
              }
            }
          },
          rate: { required: true, validPercentage: true }
        },
        messages: {
          name: {
            required: 'Please enter tax label (e.g. 18% GST)',
            maxlength: 'Tax label cannot exceed 50 characters',
            validName: 'Please enter a valid tax name (at least 2 letters, no random gibberish)',
            remote: 'This tax label already exists in your database'
          },
          rate: { required: 'Please enter tax percentage rate', validPercentage: 'Rate must be between 0% and 100%' }
        },
        onSubmit: function(form, $form) {
          const id = $('#taxId').val();
          const data = {
            name: $('#taxName').val().trim(),
            rate: parseFloat($('#taxRate').val()) || 0
          };
          const apiBase = window.location.pathname.startsWith('/subscriber') ? '/subscriber' : '/admin';
          const url = id ? apiBase + '/master/taxes/' + id : apiBase + '/master/taxes';
          const method = id ? 'PUT' : 'POST';
          const saveBtn = $('#taxSaveBtn');
          saveBtn.prop('disabled', true);

          fetch(url, {
            method: method,
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify(data)
          }).then(res => res.json()).then(resData => {
            saveBtn.prop('disabled', false);
            if (resData.success) {
              closeModal();
              showToast('success', id ? 'Tax rate updated!' : 'Tax rate added!');
              setTimeout(() => location.reload(), 1100);
            } else {
              const errMsg = resData.errors ? Object.values(resData.errors).flat().join(', ') : (resData.error || 'Failed to save');
              if (errMsg.toLowerCase().includes('already exists')) {
                Swal.fire({
                  icon: 'warning',
                  title: 'Duplicate Entry',
                  text: errMsg,
                  confirmButtonColor: '#1366d9'
                });
                $('#taxName').addClass('is-invalid');
              } else {
                showError('Save Failed', errMsg);
              }
            }
          }).catch(() => {
            saveBtn.prop('disabled', false);
            showError('Network Error', 'Could not connect to the server.');
          });
        }
      });

      $('#taxModal').on('click', function(e) {
        if (e.target === this) closeModal();
      });

      $(document).on('keydown', function(e) {
        if (e.key === 'Escape') closeModal();
      });
    });
  </script>
</body>
</html>