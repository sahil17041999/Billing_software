    // Admin: Change Store Plan Modal
    function openChangePlanModal(companyId, storeName, currentPlanId, currentCycle) {
      $('#changePlanCompanyId').val(companyId);
      $('#changePlanStoreName').text(storeName);
      if (currentPlanId) $('#changePlanSelect').val(currentPlanId);
      if (currentCycle) $('#changePlanCycle').val(currentCycle);
      $('#adminChangePlanModal').fadeIn(200);
    }

    function closeChangePlanModal() {
      $('#adminChangePlanModal').fadeOut(200);
    }

    function submitAdminChangePlan() {
      const companyId = $('#changePlanCompanyId').val();
      const planId = $('#changePlanSelect').val();
      const cycle = $('#changePlanCycle').val();
      const days = $('#changePlanDays').val();

      Swal.fire({
        title: 'Updating Plan...',
        text: 'Applying tier upgrade & validity changes...',
        allowOutsideClick: false,
        didOpen: () => Swal.showLoading()
      });

      fetch(`/admin/subscription/clients/${companyId}/change-plan`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ plan_id: planId, billing_cycle: cycle, days: days })
      })
      .then(res => res.json())
      .then(data => {
        closeChangePlanModal();
        if (data.success) {
          Swal.fire({
            icon: 'success',
            title: 'Plan Updated!',
            text: data.message,
            confirmButtonColor: '#1366d9'
          }).then(() => window.location.reload());
        } else {
          Swal.fire({
            icon: 'error',
            title: 'Update Failed',
            text: data.error || 'Failed to update plan',
            confirmButtonColor: '#ef4444'
          });
        }
      })
      .catch(() => {
        Swal.fire({ icon: 'error', title: 'Network Error', text: 'Network error updating plan' });
      });
    }

    // Admin: Edit Store Modal
    function openEditStoreModal(companyId, storeName, ownerName, phone, email, city) {
      $('#editStoreCompanyId').val(companyId);
      $('#editStoreName').val(storeName);
      $('#editStoreOwner').val(ownerName);
      $('#editStorePhone').val(phone);
      $('#editStoreEmail').val(email);
      $('#editStoreCity').val(city);
      $('#adminEditStoreModal').fadeIn(200);
    }

    function closeEditStoreModal() {
      $('#adminEditStoreModal').fadeOut(200);
    }

    function submitAdminEditStore() {
      const companyId = $('#editStoreCompanyId').val();
      const storeName = $('#editStoreName').val().trim();
      const ownerName = $('#editStoreOwner').val().trim();
      const phone = $('#editStorePhone').val().trim();
      const email = $('#editStoreEmail').val().trim();
      const city = $('#editStoreCity').val().trim();

      if (!storeName || storeName.length < 3) {
        Swal.fire({ icon: 'warning', title: 'Invalid Store Name', text: 'Store name must be at least 3 characters long.' });
        $('#editStoreName').focus();
        return;
      }
      if (!ownerName || ownerName.length < 3) {
        Swal.fire({ icon: 'warning', title: 'Invalid Owner Name', text: 'Owner name must be at least 3 characters long.' });
        $('#editStoreOwner').focus();
        return;
      }
      if (!phone || !/^[6-9]\d{9}$/.test(phone)) {
        Swal.fire({ icon: 'warning', title: 'Invalid Mobile Number', text: 'Please enter a valid 10-digit Indian mobile number (e.g. 9876543210).' });
        $('#editStorePhone').focus();
        return;
      }
      if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        Swal.fire({ icon: 'warning', title: 'Invalid Email Address', text: 'Please enter a valid email address.' });
        $('#editStoreEmail').focus();
        return;
      }

      const body = {
        store_name: storeName,
        owner_name: ownerName,
        phone: phone,
        email: email,
        city: city
      };

      Swal.fire({
        title: 'Saving Details...',
        text: 'Updating store profile...',
        allowOutsideClick: false,
        didOpen: () => Swal.showLoading()
      });

      fetch(`/admin/subscription/clients/${companyId}/edit`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body)
      })
      .then(res => res.json())
      .then(data => {
        closeEditStoreModal();
        if (data.success) {
          Swal.fire({
            icon: 'success',
            title: 'Store Details Saved!',
            text: data.message,
            confirmButtonColor: '#1366d9'
          }).then(() => window.location.reload());
        } else {
          Swal.fire({
            icon: 'error',
            title: 'Save Failed',
            text: data.error || 'Failed to update store',
            confirmButtonColor: '#ef4444'
          });
        }
      })
      .catch(() => {
        Swal.fire({ icon: 'error', title: 'Network Error', text: 'Network error updating store' });
      });
    }

    // Admin: Delete Store with SweetAlert2 Warning Box
    function deleteStore(companyId, storeName) {
      Swal.fire({
        title: 'Delete Client Store?',
        html: `<div style="text-align: left; font-size: 13px;">
                <p>Are you sure you want to permanently delete store <strong>"${storeName}"</strong>?</p>
                <div style="background: #fef2f2; border: 1px solid #fecaca; padding: 12px; border-radius: 8px; color: #b91c1c; margin-top: 10px;">
                  <strong><i class="ti ti-alert-triangle"></i> Warning:</strong> This will permanently delete all store owner logins, active subscriptions, and associated tax invoices. This action cannot be reversed.
                </div>
               </div>`,
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#ef4444',
        cancelButtonColor: '#64748b',
        confirmButtonText: '<i class="ti ti-trash"></i> Yes, Delete Store Permanently',
        cancelButtonText: 'Cancel'
      }).then((result) => {
        if (result.isConfirmed) {
          Swal.fire({
            title: 'Deleting Store...',
            text: 'Removing store records and logins...',
            allowOutsideClick: false,
            didOpen: () => Swal.showLoading()
          });

          fetch(`/admin/subscription/clients/${companyId}/delete`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
          })
          .then(res => res.json())
          .then(data => {
            if (data.success) {
              Swal.fire({
                icon: 'success',
                title: 'Store Deleted!',
                text: data.message,
                confirmButtonColor: '#1366d9'
              }).then(() => window.location.reload());
            } else {
              Swal.fire({
                icon: 'error',
                title: 'Delete Failed',
                text: data.error || 'Failed to delete store',
                confirmButtonColor: '#ef4444'
              });
            }
          })
          .catch(() => {
            Swal.fire({ icon: 'error', title: 'Network Error', text: 'Network error deleting store' });
          });
        }
      });
    // ==========================================================
    // COMPLETE FEATURE ENTITLEMENTS BREAKDOWN INTERACTIVE ENGINE
    // ==========================================================
    let currentCategoryFilter = 'all';
    let currentViewMode = 'all';

    function switchEntitlementView(mode) {
      currentViewMode = mode;
      const allBtn = document.getElementById('viewAllPlansBtn');
      const myPlanBtn = document.getElementById('viewMyPlanBtn');
      const table = document.getElementById('entitlementsTable');
      if (!table) return;

      const myplanElements = table.querySelectorAll('.myplan-only');
      const activeUserCol = '<%= activePlanCode %>';

      if (mode === 'myplan') {
        if (allBtn) allBtn.classList.remove('active');
        if (myPlanBtn) myPlanBtn.classList.add('active');

        // Display my plan only tags (unlocked pill, module launch button)
        myplanElements.forEach(el => el.style.display = 'inline-flex');

        // Hide columns other than the user's active tier
        ['starter', 'pro', 'enterprise'].forEach(col => {
          table.querySelectorAll(`[data-col="${col}"]`).forEach(cell => {
            cell.style.display = (col === activeUserCol) ? '' : 'none';
          });
        });
      } else {
        if (myPlanBtn) myPlanBtn.classList.remove('active');
        if (allBtn) allBtn.classList.add('active');

        // Hide my plan only tags
        myplanElements.forEach(el => el.style.display = 'none');

        // Reveal all plan columns
        table.querySelectorAll('[data-col]').forEach(cell => {
          cell.style.display = '';
        });
      }

      filterEntitlements();
    }

    function filterCategory(catSlug) {
      currentCategoryFilter = catSlug;
      document.querySelectorAll('#categoryFilterNav .cat-filter-btn').forEach(btn => {
        if (btn.getAttribute('data-cat') === catSlug) {
          btn.classList.add('active');
        } else {
          btn.classList.remove('active');
        }
      });
      filterEntitlements();
    }

    function filterEntitlements() {
      const searchInput = document.getElementById('entitlementSearchInput');
      const searchVal = (searchInput ? searchInput.value : '').toLowerCase().trim();
      const rows = document.querySelectorAll('#entitlementsTableBody .entitlement-row');
      const headers = document.querySelectorAll('#entitlementsTableBody .entitlement-cat-header');
      const emptyBox = document.getElementById('entitlementsEmptySearch');

      let visibleCount = 0;
      const visibleCategories = new Set();

      rows.forEach(row => {
        const cat = row.getAttribute('data-category');
        const text = row.textContent.toLowerCase();
        const matchesCategory = (currentCategoryFilter === 'all' || cat === currentCategoryFilter);
        const matchesSearch = !searchVal || text.includes(searchVal);

        if (matchesCategory && matchesSearch) {
          row.style.display = '';
          visibleCount++;
          visibleCategories.add(cat);
        } else {
          row.style.display = 'none';
        }
      });

      // Show/hide category headers based on whether any children are visible
      headers.forEach(h => {
        const cat = h.getAttribute('data-category');
        if (visibleCategories.has(cat)) {
          h.style.display = '';
        } else {
          h.style.display = 'none';
        }
      });

      if (emptyBox) {
        emptyBox.style.display = (visibleCount === 0) ? 'block' : 'none';
      }
    }

    function resetEntitlementFilters() {
      const input = document.getElementById('entitlementSearchInput');
      if (input) input.value = '';
      currentCategoryFilter = 'all';
      document.querySelectorAll('#categoryFilterNav .cat-filter-btn').forEach(btn => {
        btn.classList.toggle('active', btn.getAttribute('data-cat') === 'all');
      });
      filterEntitlements();
    }
  </script>
