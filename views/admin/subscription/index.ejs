    // Impersonate / Direct Workspace Access with SweetAlert2
    function impersonateStore(companyId, storeName) {
      Swal.fire({
        title: 'Access Store Workspace?',
        html: `Log into <strong>"${storeName}"</strong> directly as Super Admin?<br><br><small style="color:#64748b;">You can return to the Super Admin panel at any time using the exit banner at the top of your screen.</small>`,
        icon: 'info',
        showCancelButton: true,
        confirmButtonColor: '#10b981',
        cancelButtonColor: '#64748b',
        confirmButtonText: '<i class="ti ti-login"></i> Yes, Access Workspace',
        cancelButtonText: 'Cancel'
      }).then((result) => {
        if (result.isConfirmed) {
          Swal.fire({
            title: 'Connecting to Store...',
            text: `Entering workspace for ${storeName}...`,
            allowOutsideClick: false,
            didOpen: () => Swal.showLoading()
          });

          fetch(`/admin/subscription/clients/${companyId}/impersonate`, {
