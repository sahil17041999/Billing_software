              window.location.href = data.redirect;
            } else {
              Swal.fire({
                icon: 'error',
                title: 'Access Failed',
                text: data.error || 'Could not access store workspace.',
                confirmButtonColor: '#ef4444'
              });
            }
          })
          .catch(() => {
            Swal.fire({ icon: 'error', title: 'Network Error', text: 'Could not access store workspace.' });
