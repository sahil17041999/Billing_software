<script>
  // Setup jQuery Validation global defaults
  if (typeof jQuery !== 'undefined' && typeof jQuery.validator !== 'undefined') {
    jQuery.validator.setDefaults({
      errorElement: 'span',
      errorClass: 'invalid-feedback-custom',
      errorPlacement: function (error, element) {
        error.addClass('field-error-text');
        if (element.parent('.input-group').length || element.parent('.search-input-group').length) {
          error.insertAfter(element.parent());
        } else {
          error.insertAfter(element);
        }
      },
      highlight: function (element, errorClass, validClass) {
        $(element).addClass('is-invalid').removeClass('is-valid');
      },
      unhighlight: function (element, errorClass, validClass) {
        $(element).removeClass('is-invalid').addClass('is-valid');
      }
    });
  }
</script>

