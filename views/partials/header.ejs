<script>
  // =============================================
  // TURBO PROGRESS BAR ENGINE (INSTANT FEEDBACK)
  // =============================================
  let turboTimer = null;
  function startTurboProgress() {
    const bar = document.getElementById('turboProgressBar');
    if (!bar) return;
    clearInterval(turboTimer);
    bar.classList.add('active');
    bar.style.width = '28%';
    let current = 28;
    turboTimer = setInterval(function () {
      if (current < 85) {
        current += Math.random() * 12;
        bar.style.width = Math.min(85, current) + '%';
      }
    }, 180);
  }

  function finishTurboProgress() {
    const bar = document.getElementById('turboProgressBar');
    if (!bar) return;
    clearInterval(turboTimer);
    bar.style.width = '100%';
    setTimeout(function () {
      bar.classList.remove('active');
      setTimeout(function () {
        bar.style.width = '0%';
      }, 250);
    }, 150);
  }

  // Hook navigation links for instant perceived responsiveness
  document.addEventListener('click', function (e) {
    const anchor = e.target.closest('a');
    if (anchor && anchor.href && !anchor.target && !anchor.hasAttribute('download')) {
      const url = new URL(anchor.href, window.location.origin);
      if (url.origin === window.location.origin && !anchor.href.includes('#') && !anchor.href.startsWith('javascript:')) {
        startTurboProgress();
      }
    }
  });

  // =============================================
  // WEB AUDIO ENGINE (RETAIL SCANNER SOUND EFFECTS)
  // Zero external dependencies, pure Web Audio API
  // =============================================
  let audioCtx = null;
  function getAudioContext() {
    if (!audioCtx) {
      const AudioContext = window.AudioContext || window.webkitAudioContext;
      if (AudioContext) audioCtx = new AudioContext();
    }
    if (audioCtx && audioCtx.state === 'suspended') {
      audioCtx.resume();
    }
    return audioCtx;
  }

  // Cheerful retail barcode scanner beep (1850Hz for 65ms)
  window.playPosBeep = function (freq = 1850, duration = 0.065) {
    try {
      const ctx = getAudioContext();
      if (!ctx) return;
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(freq, ctx.currentTime);
      gain.gain.setValueAtTime(0.18, ctx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + duration);
      osc.connect(gain);
      gain.connect(ctx.destination);
      osc.start();
      osc.stop(ctx.currentTime + duration);
    } catch (e) { /* ignore audio permission errors */ }
  };

  // Cash Register Checkout Chime (3-tone harmonic chord)
  window.playCheckoutChime = function () {
    try {
      const ctx = getAudioContext();
      if (!ctx) return;
      const notes = [523.25, 659.25, 783.99, 1046.50]; // C5, E5, G5, C6
      notes.forEach((freq, idx) => {
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'triangle';
        osc.frequency.setValueAtTime(freq, ctx.currentTime + idx * 0.08);
        gain.gain.setValueAtTime(0.2, ctx.currentTime + idx * 0.08);
        gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + idx * 0.08 + 0.3);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start(ctx.currentTime + idx * 0.08);
        osc.stop(ctx.currentTime + idx * 0.08 + 0.35);
      });
    } catch (e) { }
  };

  // Warning/Error Boop Tone
  window.playErrorTone = function () {
    try {
      const ctx = getAudioContext();
      if (!ctx) return;
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.type = 'sawtooth';
      osc.frequency.setValueAtTime(220, ctx.currentTime);
      osc.frequency.exponentialRampToValueAtTime(110, ctx.currentTime + 0.15);
      gain.gain.setValueAtTime(0.25, ctx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.18);
      osc.connect(gain);
      gain.connect(ctx.destination);
      osc.start();
      osc.stop(ctx.currentTime + 0.18);
    } catch (e) { }
  };

  // =============================================
  // NETWORK STATUS MONITOR (OFFLINE / ONLINE RECOVERY)
  // =============================================
  function showNetworkToast(type, msg) {
    const el = document.getElementById('networkStatusToast');
    if (!el) return;
    el.className = 'network-status-toast ' + type + ' show';
    el.innerHTML = (type === 'offline' ? '<i class="ti ti-wifi-off fs-5"></i> ' : '<i class="ti ti-wifi fs-5"></i> ') + msg;
    if (type === 'online') {
      setTimeout(() => el.classList.remove('show'), 3500);
    }
  }

  window.addEventListener('offline', function () {
    showNetworkToast('offline', 'Network offline! In-memory POS features active.');
  });
  window.addEventListener('online', function () {
    showNetworkToast('online', 'Connection restored! Cloud sync active.');
  });

  // =============================================
  // GLOBAL PAGE LOADER UTILITIES (Add / Update / Delete)
  // =============================================
  function showPageLoader(title, subtitle, iconClass) {
    startTurboProgress();
    const overlay = document.getElementById('pageLoaderOverlay');
    const titleEl = document.getElementById('pageLoaderTitle');
    const msgEl = document.getElementById('pageLoaderMsg');
    const subEl = document.getElementById('pageLoaderSubtitle');
    const iconEl = document.getElementById('pageLoaderIcon');
    if (overlay) {
      if (titleEl) titleEl.textContent = title || 'Processing...';
      if (msgEl) msgEl.textContent = title || 'Processing...';
      if (subEl) subEl.textContent = subtitle || 'Please wait while we update your store';
      if (iconEl && iconClass) iconEl.className = iconClass;
      overlay.style.display = 'flex';
    }
  }

  function hidePageLoader() {
    finishTurboProgress();
    const overlay = document.getElementById('pageLoaderOverlay');
    if (overlay) overlay.style.display = 'none';
  }

  // Always hide loader when the page has fully loaded
  window.addEventListener('load', function () { hidePageLoader(); finishTurboProgress(); });
  window.addEventListener('pageshow', function (e) {
    hidePageLoader();
    finishTurboProgress();
  });
  document.addEventListener('visibilitychange', function () {
    if (document.visibilityState === 'visible') { hidePageLoader(); finishTurboProgress(); }
  });

  // =============================================
  // GLOBAL SWEETALERT2 HELPERS
  // =============================================
  function showSuccess(title, text, then) {
    hidePageLoader();
    if (!window.Swal) { alert(title + ': ' + (text || '')); return Promise.resolve(); }
    return Swal.fire({
      icon: 'success',
      title: title || 'Success!',
      html: text || '',
      timer: text ? undefined : 1800,
      showConfirmButton: !!text,
      confirmButtonText: 'OK'
    }).then(then || function () { });
  }

  function showError(title, text) {
    hidePageLoader();
    if (!window.Swal) { alert('Error: ' + (text || title)); return; }
    return Swal.fire({
      icon: 'error',
      title: title || 'Error',
      html: text || 'Something went wrong.',
      confirmButtonText: 'OK'
    });
  }

  function showWarning(title, text) {
    hidePageLoader();
    if (!window.Swal) { alert('Warning: ' + (text || title)); return; }
    return Swal.fire({
      icon: 'warning',
      title: title || 'Warning',
      html: text || '',
      confirmButtonText: 'OK'
    });
  }

  function showConfirm(title, text, confirmText) {
    if (!window.Swal) {
      const ok = confirm(title + '\n' + (text || ''));
      return Promise.resolve({ isConfirmed: ok });
    }
    return Swal.fire({
      icon: 'question',
      title: title || 'Are you sure?',
      html: text || '',
      showCancelButton: true,
      confirmButtonText: confirmText || 'Yes, proceed',
      cancelButtonText: 'Cancel',
      reverseButtons: true
    });
  }

  function showToast(arg1, arg2) {
    let icon = 'success';
    let title = 'Done!';
    const knownIcons = ['success', 'error', 'warning', 'info', 'question'];

    if (knownIcons.includes(String(arg1).toLowerCase())) {
      icon = String(arg1).toLowerCase();
      title = arg2 || 'Done!';
    } else if (knownIcons.includes(String(arg2).toLowerCase())) {
      icon = String(arg2).toLowerCase();
      title = arg1 || 'Done!';
    } else if (arg1) {
      title = arg1;
      icon = 'info';
    }

    if (!window.Swal) {
      return;
    }

    return Swal.fire({
      toast: true,
      position: 'top-end',
      icon: icon,
      title: title,
      showConfirmButton: false,
      timer: 2800,
      timerProgressBar: true
    });
  }

  // =============================================
  // UNIVERSAL DATATABLES AUTO-INITIALIZER
  // =============================================
  function initStandardDataTable(tableSelector, customOptions = {}) {
    if (typeof jQuery === 'undefined' || typeof jQuery.fn.DataTable === 'undefined') return;
    const $table = $(tableSelector);
    if (!$table.length) return;

    if ($.fn.DataTable.isDataTable($table[0])) {
      $table.DataTable().destroy();
    }

    // Auto-detect action columns to disable sorting
    const noSortCols = [];
    $table.find('thead th').each(function (idx) {
      const txt = $(this).text().trim().toLowerCase();
      if (txt.includes('action') || $(this).hasClass('no-sort')) {
        noSortCols.push(idx);
      }
    });

    const hasServerPagination = $table.closest('.card-modern, .card-body-modern, .table-responsive-wrapper, main').find('.pagination-modern, .pagination-bar-wrapper').length > 0 || $table.hasClass('server-paginated');

    const defaultOptions = {
      responsive: true,
      paging: !hasServerPagination,
      info: !hasServerPagination,
      lengthChange: !hasServerPagination,
      searching: !hasServerPagination,
      pageLength: 15,
      lengthMenu: [[10, 15, 25, 50, 100, -1], [10, 15, 25, 50, 100, "All"]],
      columnDefs: noSortCols.length > 0 ? [{ targets: noSortCols, orderable: false }] : [],
      language: {
        search: "_INPUT_",
        searchPlaceholder: "Search records...",
        lengthMenu: "Show _MENU_",
        info: "Showing _START_ to _END_ of _TOTAL_ entries",
        infoEmpty: "Showing 0 to 0 of 0 entries",
        infoFiltered: "(filtered from _MAX_ total)",
        paginate: {
          first: '<i class="ti ti-chevrons-left"></i>',
          previous: '<i class="ti ti-chevron-left"></i> <span class="d-none d-sm-inline" style="margin-left: 2px;">Prev</span>',
          next: '<span class="d-none d-sm-inline" style="margin-right: 2px;">Next</span> <i class="ti ti-chevron-right"></i>',
          last: '<i class="ti ti-chevrons-right"></i>'
        }
      },
      dom: hasServerPagination ? 'rt' : '<"dt-header-toolbar"<"dt-left"lB><"dt-right"f>>rt<"dt-footer-toolbar"<"dt-info"i><"dt-pagination"p>>',
      buttons: [
        { extend: 'excelHtml5', className: 'btn-dt-export btn-dt-excel', text: '<i class="ti ti-file-spreadsheet"></i> Excel', titleAttr: 'Export Excel' },
        { extend: 'csvHtml5', className: 'btn-dt-export btn-dt-csv', text: '<i class="ti ti-file-text"></i> CSV', titleAttr: 'Export CSV' },
        { extend: 'pdfHtml5', className: 'btn-dt-export btn-dt-pdf', text: '<i class="ti ti-file-type-pdf"></i> PDF', titleAttr: 'Export PDF' },
        { extend: 'print', className: 'btn-dt-export btn-dt-print', text: '<i class="ti ti-printer"></i> Print', titleAttr: 'Print' }
      ]
    };

    return $table.DataTable($.extend(true, {}, defaultOptions, customOptions));
  }

  // Universal Auto-Initializer for all sections
  $(document).ready(function () {
    $('table.table-modern').each(function () {
      const $t = $(this);
      const hasServerPagination = $t.closest('.card-modern, .card-body-modern, .table-responsive-wrapper, main').find('.pagination-modern, .pagination-bar-wrapper').length > 0 || $t.hasClass('server-paginated');
      if (
        hasServerPagination ||
        $t.data('no-datatable') ||
        $t.hasClass('no-datatable') ||
        $t.hasClass('server-paginated') ||
        $t.hasClass('items-table') ||
        $t.attr('id') === 'entitlementsTable' ||
        $t.attr('id') === 'cartTableElement' ||
        $t.closest('.pos-main-container').length > 0 ||
        $t.closest('.pos-cart-scroll-table').length > 0 ||
        $t.closest('#clientCheckoutModal').length > 0 ||
        $t.find('tbody td.table-empty-state').length > 0
      ) {
        return;
      }
      if ($t.find('thead th').length > 0 && $t.find('tbody tr').length > 0) {
        if (!$.fn.DataTable.isDataTable(this)) {
          initStandardDataTable(this);
        }
      }
    });
  });
</script>

