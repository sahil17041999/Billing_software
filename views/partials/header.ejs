    <style>
      @keyframes notifPulse {
        0% { transform: scale(1); box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7); }
        70% { transform: scale(1.08); box-shadow: 0 0 0 7px rgba(239, 68, 68, 0); }
        100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(239, 68, 68, 0); }
      }
      .erp-toast-item {
        pointer-events: auto;
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 14px 16px;
        background: #ffffff;
        border-radius: 14px;
        border: 1px solid rgba(226, 232, 240, 0.9);
        box-shadow: 0 12px 30px rgba(15, 23, 42, 0.16), 0 4px 12px rgba(0, 0, 0, 0.08);
        transform: translateY(20px);
        opacity: 0;
        animation: toastSlideIn 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        transition: all 0.25s ease;
      }
      .erp-toast-item.toast-closing {
        opacity: 0;
        transform: translateY(10px) scale(0.95);
      }
      @keyframes toastSlideIn {
        to { opacity: 1; transform: translateY(0); }
      }
      .header-notif-row {
        position: relative;
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 12px 16px;
        text-decoration: none;
        border-bottom: 1px solid var(--border-color, #e2e8f0);
        transition: background 0.15s ease;
      }
      .header-notif-row:hover {
        background: #f8fafc;
      }
      .header-notif-row.unread {
        background: #f0f7ff;
      }
      .header-notif-row.unread:hover {
        background: #e8f2fe;
      }
    </style>

    <script>

      // Robust Logout Handler with SweetAlert2 confirmation & fallback
      function handleLogout(e) {
        if (e && typeof e.preventDefault === 'function') {
          e.preventDefault();
        }

        // Close user dropdown if open
        const menu = document.getElementById('userDropdownMenu');
        if (menu) menu.classList.remove('show');

        if (typeof Swal !== 'undefined' && typeof showConfirm === 'function') {
          showConfirm('Sign Out?', 'Are you sure you want to end your current session?', 'Yes, Sign Out')
            .then(function (result) {
              if (result && result.isConfirmed) {
                if (typeof showPageLoader === 'function') showPageLoader('Signing out...');
                window.location.href = '/admin/logout';
              }
            })
            .catch(function () {
              // If Swal fails or is dismissed
            });
        } else {
          if (confirm('Are you sure you want to sign out?')) {
            if (typeof showPageLoader === 'function') showPageLoader('Signing out...');
            window.location.href = '/admin/logout';
          }
        }
      }

      document.addEventListener('DOMContentLoaded', function () {
        // User profile dropdown toggle
        const trigger = document.getElementById('userDropdownTrigger');
        const menu = document.getElementById('userDropdownMenu');

        if (trigger && menu) {
          trigger.addEventListener('click', function (e) {
            e.stopPropagation();
            menu.classList.toggle('show');
          });

          document.addEventListener('click', function (e) {
            if (!menu.contains(e.target) && !trigger.contains(e.target)) {
              menu.classList.remove('show');
            }
          });
        }

        // ============================================================
        // ADVANCED NOTIFICATION CLIENT ENGINE
        // ============================================================
        const notifBtn = document.getElementById('notificationDropdownBtn');
        const notifMenu = document.getElementById('headerNotifMenu');
        const notifBadge = document.getElementById('headerNotifBadge');
        const notifDot = document.getElementById('headerNotifDot');
        const notifUnreadText = document.getElementById('headerNotifUnreadCount');
        const notifList = document.getElementById('headerNotifList');
        const markAllBtn = document.getElementById('headerMarkAllReadBtn');
        const soundToggleBtn = document.getElementById('headerNotifSoundToggle');
        const soundIcon = document.getElementById('headerNotifSoundIcon');

        let cachedNotifications = [];
        let previousUnreadCount = null;
        let activeHeaderFilter = 'all';

        // Sound State Initialization
        function updateSoundIconState() {
          const isMuted = localStorage.getItem('erp_notif_sound') === 'muted';
          if (soundIcon) {
            soundIcon.className = isMuted ? 'ti ti-volume-off' : 'ti ti-volume';
            soundIcon.style.color = isMuted ? '#ef4444' : '#1366d9';
          }
          if (soundToggleBtn) {
            soundToggleBtn.title = isMuted ? 'Sound Alerts Muted (Click to Unmute)' : 'Sound Alerts Active (Click to Mute)';
          }
        }
        updateSoundIconState();

        if (soundToggleBtn) {
          soundToggleBtn.addEventListener('click', function (e) {
            e.stopPropagation();
            const isMuted = localStorage.getItem('erp_notif_sound') === 'muted';
            if (isMuted) {
              localStorage.removeItem('erp_notif_sound');
              updateSoundIconState();
              playNotificationChime();
            } else {
              localStorage.setItem('erp_notif_sound', 'muted');
              updateSoundIconState();
            }
          });
        }

        // Web Audio API Synthesizer Chime
        function playNotificationChime() {
          if (localStorage.getItem('erp_notif_sound') === 'muted') return;
          try {
            const AudioContext = window.AudioContext || window.webkitAudioContext;
            if (!AudioContext) return;
            const ctx = new AudioContext();
            const now = ctx.currentTime;

            // Tone 1: D5 (587.33Hz)
            const osc1 = ctx.createOscillator();
            const gain1 = ctx.createGain();
            osc1.type = 'sine';
            osc1.frequency.setValueAtTime(587.33, now);
            gain1.gain.setValueAtTime(0.18, now);
            gain1.gain.exponentialRampToValueAtTime(0.001, now + 0.32);
            osc1.connect(gain1);
            gain1.connect(ctx.destination);
            osc1.start(now);
            osc1.stop(now + 0.32);

            // Tone 2: A5 (880.00Hz) - sweet high harmony
            const osc2 = ctx.createOscillator();
            const gain2 = ctx.createGain();
            osc2.type = 'sine';
            osc2.frequency.setValueAtTime(880, now + 0.08);
            gain2.gain.setValueAtTime(0.22, now + 0.08);
            gain2.gain.exponentialRampToValueAtTime(0.001, now + 0.48);
            osc2.connect(gain2);
            gain2.connect(ctx.destination);
            osc2.start(now + 0.08);
            osc2.stop(now + 0.48);
          } catch (e) {
            // Audio context permission notice
          }
        }
        window.playNotificationChime = playNotificationChime;

        // Floating Toast Engine
        function showNotificationToast(notif) {
          const container = document.getElementById('erpGlobalToastContainer');
          if (!container) return;

          const toast = document.createElement('div');
          toast.className = 'erp-toast-item';
          
          const iconColor = notif.severity === 'danger' ? '#dc2626' : (notif.severity === 'warning' ? '#d97706' : (notif.severity === 'success' ? '#059669' : '#2563eb'));
          const iconBg = notif.severity === 'danger' ? '#fef2f2' : (notif.severity === 'warning' ? '#fffbeb' : (notif.severity === 'success' ? '#f0fdf4' : '#eff6ff'));

          toast.innerHTML = `
            <div style="width: 36px; height: 36px; border-radius: 10px; background: ${iconBg}; color: ${iconColor}; display: flex; align-items: center; justify-content: center; font-size: 18px; flex-shrink: 0;">
              <i class="ti ${notif.icon || 'ti-bell'}"></i>
            </div>
            <div style="flex: 1; min-width: 0;">
              <div style="display: flex; align-items: center; justify-content: space-between; gap: 6px; margin-bottom: 2px;">
                <strong style="font-size: 13.5px; color: #0f172a; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">${notif.title}</strong>
                <span style="font-size: 10.5px; color: #94a3b8; flex-shrink: 0;">Just now</span>
              </div>
              <p style="margin: 0 0 8px 0; font-size: 12px; color: #475569; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">${notif.message}</p>
              <div style="display: flex; align-items: center; gap: 8px;">
                ${notif.link ? `<a href="${notif.link}" style="font-size: 11.5px; font-weight: 700; color: #1366d9; text-decoration: none; display: inline-flex; align-items: center; gap: 3px;">Open <i class="ti ti-arrow-right"></i></a>` : ''}
                <button type="button" onclick="this.closest('.erp-toast-item').remove()" style="background: none; border: none; font-size: 11.5px; color: #94a3b8; cursor: pointer; padding: 0;">Dismiss</button>
              </div>
            </div>
            <button type="button" onclick="this.closest('.erp-toast-item').remove()" style="background: none; border: none; color: #94a3b8; font-size: 15px; cursor: pointer; padding: 2px; line-height: 1;">&times;</button>
          `;

          container.appendChild(toast);

          // Auto-remove after 6.5 seconds
          setTimeout(() => {
            if (toast && toast.parentNode) {
              toast.classList.add('toast-closing');
              setTimeout(() => toast.remove(), 250);
            }
          }, 6500);
        }
        window.showNotificationToast = showNotificationToast;

        // Browser Native Desktop Notification
        window.requestPushNotificationPermission = function () {
          if (!('Notification' in window)) {
            alert('This browser does not support desktop notifications.');
            return;
          }
          Notification.requestPermission().then(permission => {
            if (permission === 'granted') {
              new Notification('Grocery Billing ERP', {
                body: 'Desktop notifications are now enabled! You will be alerted for inventory and sales.',
                icon: '/assets/images/logos/favicon.png'
              });
              const btn = document.getElementById('headerEnablePushBtn');
              if (btn) btn.innerHTML = '<i class="ti ti-check" style="color: #10b981;"></i><span style="color: #10b981;">Alerts Enabled</span>';
            }
          });
        };

        // Header Bell Dropdown Toggle
        if (notifBtn && notifMenu) {
          notifBtn.addEventListener('click', function (e) {
            e.stopPropagation();
            const isOpen = notifMenu.style.display === 'block';
            notifMenu.style.display = isOpen ? 'none' : 'block';
            if (menu) menu.classList.remove('show');
            if (!isOpen) {
              fetchHeaderNotifications(false);
            }
          });

          document.addEventListener('click', function (e) {
            if (!notifMenu.contains(e.target) && !notifBtn.contains(e.target)) {
              notifMenu.style.display = 'none';
            }
          });
        }

        // Header Tab Filter Switcher
        window.filterHeaderNotifs = function (filter, btn) {
          activeHeaderFilter = filter;
          document.querySelectorAll('.header-notif-tab').forEach(b => {
            b.classList.remove('active');
            b.style.background = '#ffffff';
            b.style.color = '#64748b';
          });
          if (btn) {
            btn.classList.add('active');
            btn.style.background = '#eef5ff';
            btn.style.color = '#1366d9';
          }
          renderHeaderNotifList();
        };

        // Render Dropdown List from cached array
        function renderHeaderNotifList() {
          if (!notifList) return;

          let filtered = cachedNotifications;
          if (activeHeaderFilter === 'unread') {
            filtered = cachedNotifications.filter(n => !n.is_read);
          } else if (activeHeaderFilter === 'danger') {
            filtered = cachedNotifications.filter(n => n.severity === 'danger');
          }

          if (!filtered || filtered.length === 0) {
            notifList.innerHTML = `
              <div style="text-align: center; padding: 28px 16px; color: #94a3b8; font-size: 13px;">
                <div style="width: 42px; height: 42px; border-radius: 12px; background: #f1f5f9; display: inline-flex; align-items: center; justify-content: center; font-size: 20px; color: #10b981; margin-bottom: 8px;">
                  <i class="ti ti-check"></i>
                </div>
                <div style="font-weight: 600; color: #334155;">No ${activeHeaderFilter !== 'all' ? activeHeaderFilter : ''} notifications!</div>
                <div style="font-size: 11.5px; color: #94a3b8; margin-top: 2px;">You are completely up to date.</div>
              </div>
            `;
            return;
          }

          notifList.innerHTML = filtered.map(n => {
            const iconColor = n.severity === 'danger' ? '#ef4444' : (n.severity === 'warning' ? '#f59e0b' : (n.severity === 'success' ? '#10b981' : '#3b82f6'));
            const iconBg = n.severity === 'danger' ? 'rgba(239, 68, 68, 0.1)' : (n.severity === 'warning' ? 'rgba(245, 158, 11, 0.1)' : (n.severity === 'success' ? 'rgba(16, 185, 129, 0.1)' : 'rgba(59, 130, 246, 0.1)'));
            
            return `
              <div class="header-notif-row ${!n.is_read ? 'unread' : ''}" id="headerRow-${n.id}">
                <div style="width: 34px; height: 34px; border-radius: 10px; background: ${iconBg}; color: ${iconColor}; display: flex; align-items: center; justify-content: center; font-size: 17px; flex-shrink: 0; margin-top: 2px;">
                  <i class="ti ${n.icon || 'ti-bell'}"></i>
                </div>
                <div style="flex: 1; min-width: 0;">
                  <div style="display: flex; align-items: center; justify-content: space-between; gap: 6px; margin-bottom: 3px;">
                    <a href="${n.link || '#'}" onclick="headerMarkSingleRead(${n.id}, event, '${n.link || ''}')" style="color: var(--text-color, #0f172a); font-size: 13px; font-weight: ${n.is_read ? '600' : '700'}; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; text-decoration: none; display: block; max-width: 190px;">
                      ${n.title}
                    </a>
                    <span style="font-size: 10.5px; color: #94a3b8; flex-shrink: 0;">${n.time_ago || ''}</span>
                  </div>
                  <div style="color: #64748b; font-size: 12px; line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; margin-bottom: 6px;">
                    ${n.message}
                  </div>
                  <div style="display: flex; align-items: center; gap: 10px;">
                    ${n.link ? `<a href="${n.link}" onclick="headerMarkSingleRead(${n.id}, event, '${n.link}')" style="font-size: 11px; font-weight: 700; color: #1366d9; text-decoration: none;">View &rarr;</a>` : ''}
                    ${!n.is_read ? `<button type="button" onclick="headerMarkSingleRead(${n.id}, event, null)" style="background: none; border: none; padding: 0; color: #64748b; font-size: 11px; cursor: pointer; text-decoration: underline;">Mark read</button>` : ''}
                    <button type="button" onclick="headerDeleteNotification(${n.id}, event)" style="background: none; border: none; padding: 0; color: #94a3b8; font-size: 11px; cursor: pointer; margin-left: auto;" title="Delete notification"><i class="ti ti-trash"></i></button>
                  </div>
                </div>
                ${!n.is_read ? '<span style="width: 8px; height: 8px; border-radius: 50%; background: #2563eb; margin-top: 6px; flex-shrink: 0;"></span>' : ''}
              </div>
            `;
          }).join('');
        }

        // Fetch Notifications Engine
        function fetchHeaderNotifications(triggerSensoryAlerts = true) {
          fetch('/api/notifications?limit=25')
            .then(res => res.json())
            .then(data => {
              if (!data || !data.success) return;

              cachedNotifications = data.notifications || [];

              // Update Badge and Count
              if (notifBadge && notifUnreadText) {
                if (data.unread_count > 0) {
                  notifBadge.style.display = 'flex';
                  notifBadge.textContent = data.unread_count > 99 ? '99+' : data.unread_count;
                  notifUnreadText.textContent = `${data.unread_count} New`;
                } else {
                  notifBadge.style.display = 'none';
                  notifUnreadText.textContent = 'All Caught Up';
                }
              }

              // Detect New Incoming Alerts for Sensory Feedback
              if (previousUnreadCount !== null && data.unread_count > previousUnreadCount && triggerSensoryAlerts) {
                playNotificationChime();
                const newest = cachedNotifications.find(n => !n.is_read);
                if (newest) {
                  showNotificationToast(newest);
                  // Browser native notification if backgrounded
                  if (document.hidden && ('Notification' in window) && Notification.permission === 'granted') {
                    new Notification(newest.title, {
                      body: newest.message,
                      icon: '/assets/images/logos/favicon.png'
                    });
                  }
                }
              }

              previousUnreadCount = data.unread_count;
              renderHeaderNotifList();
            })
            .catch(err => console.warn('Error fetching notifications:', err));
        }

        // Mark Single Read
        window.headerMarkSingleRead = function (id, e, link) {
          if (e && e.stopPropagation) e.stopPropagation();
          fetch(`/api/notifications/${id}/read`, { method: 'POST' })
            .then(() => {
              const item = cachedNotifications.find(n => n.id === id);
              if (item) item.is_read = true;
              if (link && link !== '#' && link !== '') {
                window.location.href = link;
              } else {
                fetchHeaderNotifications(false);
              }
            })
            .catch(() => {
              if (link && link !== '#' && link !== '') window.location.href = link;
            });
        };

        // Delete Single Notification
        window.headerDeleteNotification = function (id, e) {
          if (e && e.stopPropagation) e.stopPropagation();
          fetch(`/api/notifications/${id}`, { method: 'DELETE' })
            .then(res => res.json())
            .then(res => {
              if (res.success) {
                cachedNotifications = cachedNotifications.filter(n => n.id !== id);
                fetchHeaderNotifications(false);
              }
            });
        };

        // Mark All As Read
        if (markAllBtn) {
          markAllBtn.addEventListener('click', function () {
            fetch('/api/notifications/mark-all-read', { method: 'POST' })
              .then(() => fetchHeaderNotifications(false))
              .catch(err => console.error(err));
          });
        }

        // Initial fetch and auto-poll every 25 seconds
        fetchHeaderNotifications(false);
        setInterval(() => fetchHeaderNotifications(true), 25000);

        // Immediate fetch when user returns to the browser tab
        document.addEventListener('visibilitychange', function () {
          if (!document.hidden) {
            fetchHeaderNotifications(true);
          }
        });


        // =============================================
        // GLOBAL KEYBOARD SHORTCUTS ENGINE
        // =============================================
        document.addEventListener('keydown', function (e) {

          // Ignore when typing inside input/textarea/select unless it's a Function key or Esc or Ctrl+K
          const isInput = ['INPUT', 'TEXTAREA', 'SELECT'].includes(document.activeElement.tagName);

          // F1 or Shift + ? -> Open Shortcuts Help
          if (e.key === 'F1' || (e.key === '?' && !isInput)) {
            e.preventDefault();
            openShortcutsModal();
            return;
          }

          const isSub = window.location.pathname.startsWith('/subscriber');
          const pfx = isSub ? '/subscriber' : '/admin';

          // F2 -> Instant POS Terminal
          if (e.key === 'F2') {
            e.preventDefault();
            if (!window.location.pathname.endsWith('/sales/pos')) {
              if (typeof showPageLoader === 'function') showPageLoader('Opening POS Terminal (F2)...');
              window.location.href = pfx + '/sales/pos';
            }
            return;
          }

          // F3 or Ctrl+K -> Focus Search
          if (e.key === 'F3' || ((e.ctrlKey || e.metaKey) && (e.key === 'k' || e.key === 'K'))) {
            e.preventDefault();
            const searchInput = document.getElementById('globalHeaderSearch');
            if (searchInput) searchInput.focus();
            return;
          }

          // Alt + N -> Quick Add Menu
          if (e.altKey && (e.key === 'n' || e.key === 'N')) {
            e.preventDefault();
            const qaBtn = document.getElementById('headerQuickAddBtn');
            if (qaBtn) qaBtn.click();
            return;
          }

          // F4 -> Quick Products
          if (e.key === 'F4') {
            e.preventDefault();
            if (!window.location.pathname.includes('/master/products')) {
              if (typeof showPageLoader === 'function') showPageLoader('Opening Products Catalog (F4)...');
              window.location.href = pfx + '/master/products';
            }
            return;
          }

          // F8 -> Quick Customers
          if (e.key === 'F8') {
            e.preventDefault();
            if (!window.location.pathname.includes('/master/customers')) {
              if (typeof showPageLoader === 'function') showPageLoader('Opening Customers Directory (F8)...');
              window.location.href = pfx + '/master/customers';
            }
            return;
          }

          // F9 -> Day End Closing
          if (e.key === 'F9') {
            e.preventDefault();
            if (!window.location.pathname.includes('/day-end')) {
              if (typeof showPageLoader === 'function') showPageLoader('Opening Day End Closing (F9)...');
              window.location.href = pfx + '/day-end/form';
            }
            return;
          }

          // Esc -> Close Shortcuts Modal, quick palettes, and active modals
          if (e.key === 'Escape') {
            closeShortcutsModal();
            const searchPalette = document.getElementById('quickSearchPalette');
            if (searchPalette) searchPalette.style.display = 'none';
            const qaMenu = document.getElementById('headerQuickAddMenu');
            if (qaMenu) qaMenu.style.display = 'none';
            document.querySelectorAll('.modal-backdrop-modern.show').forEach(m => m.classList.remove('show'));
            document.querySelectorAll('.dropdown-menu-custom').forEach(d => { d.classList.remove('show'); d.style.display = 'none'; });
          }
        });

        // Quick Add Menu toggle
        const qaBtn = document.getElementById('headerQuickAddBtn');
        const qaMenu = document.getElementById('headerQuickAddMenu');
        if (qaBtn && qaMenu) {
          qaBtn.addEventListener('click', function (e) {
            e.stopPropagation();
            qaMenu.style.display = (qaMenu.style.display === 'none' || !qaMenu.style.display) ? 'block' : 'none';
          });
          document.addEventListener('click', function (e) {
            if (!qaMenu.contains(e.target) && e.target !== qaBtn) {
              qaMenu.style.display = 'none';
            }
          });
        }

        const searchInput = document.getElementById('globalHeaderSearch');
        const searchPalette = document.getElementById('quickSearchPalette');

        if (searchInput && searchPalette) {
          // Show palette on focus
          searchInput.addEventListener('focus', function () {
            searchPalette.style.display = 'block';
          });

          // Filter palette items on input
          searchInput.addEventListener('input', function () {
            const query = this.value.trim().toLowerCase();
            searchPalette.style.display = 'block';
            const items = searchPalette.querySelectorAll('.palette-item');
            items.forEach(function (item) {
              const text = item.textContent.toLowerCase();
              item.style.display = text.includes(query) ? 'flex' : 'none';
            });
          });

          // Enter key submits search
          searchInput.addEventListener('keydown', function (e) {
            if (e.key === 'Enter' && this.value.trim() !== '') {
              searchPalette.style.display = 'none';
              if (typeof startTurboProgress === 'function') startTurboProgress();
              window.location.href = '/admin/master/products?search=' + encodeURIComponent(this.value.trim());
            } else if (e.key === 'Escape') {
              searchPalette.style.display = 'none';
              this.blur();
            }
          });

          // Click outside to dismiss palette
          document.addEventListener('click', function (e) {
            if (!searchInput.contains(e.target) && !searchPalette.contains(e.target)) {
              searchPalette.style.display = 'none';
            }
          });
        }

        // Dismiss loader when page is restored or ready
        if (typeof hidePageLoader === 'function') hidePageLoader();
      });

      // Modal helpers for Shortcuts Cheatsheet
      function openShortcutsModal() {
        const m = document.getElementById('keyboardShortcutsModal');
        if (m) {
          m.classList.add('show');
          document.body.style.overflow = 'hidden';
        }
      }

      function closeShortcutsModal() {
        const m = document.getElementById('keyboardShortcutsModal');
        if (m) {
          m.classList.remove('show');
          document.body.style.overflow = '';
        }
      }
    </script>

    <!-- Global Keyboard Shortcuts Cheatsheet Modal -->
    <div id="keyboardShortcutsModal" class="modal-backdrop-modern"
      onclick="if(event.target===this)closeShortcutsModal()">
      <div class="modal-dialog-modern" style="max-width: 620px;">
        <div class="modal-header-modern">
          <h2 class="modal-title-modern">
            <i class="ti ti-keyboard" style="color: var(--primary);"></i> Fast Keyboard Shortcuts
          </h2>
          <button type="button" class="modal-close-btn" onclick="closeShortcutsModal()">
            <i class="ti ti-x"></i>
          </button>
        </div>

        <div class="modal-body-modern" style="padding: 16px 20px;">
          <p style="font-size: 13px; color: var(--text-muted); margin-bottom: 16px;">
            Use these instant keyboard shortcuts from anywhere in the software for ultra-fast operations:
          </p>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px;">

            <!-- POS & Sales Hotkeys -->
            <div
              style="background: var(--bg-card-hover, rgba(15,23,42,0.04)); border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 14px;">
              <div
                style="font-size: 13px; font-weight: 700; color: var(--text-main); margin-bottom: 10px; display: flex; align-items: center; gap: 6px;">
                <i class="ti ti-device-laptop" style="color: var(--success);"></i> POS Billing &amp; Sales
              </div>
              <div style="display: flex; flex-direction: column; gap: 8px; font-size: 12.5px;">
                <div style="display: flex; justify-content: space-between; align-items: center;">
                  <span>New POS Checkout</span>
                  <kbd
                    style="background: var(--primary); color: #fff; padding: 2px 7px; border-radius: 4px; font-weight: 700; font-size: 11px;">F2</kbd>
                </div>
                <div style="display: flex; justify-content: space-between; align-items: center;">
                  <span>Focus Barcode Input</span>
                  <kbd
                    style="background: var(--bg-card); border: 1px solid var(--border-color); padding: 2px 7px; border-radius: 4px; font-weight: 700; font-size: 11px;">F4</kbd>
                </div>
                <div style="display: flex; justify-content: space-between; align-items: center;">
                  <span>Instant Cash Checkout</span>
                  <kbd
                    style="background: var(--bg-card); border: 1px solid var(--border-color); padding: 2px 7px; border-radius: 4px; font-weight: 700; font-size: 11px;">F9</kbd>
                </div>
                <div style="display: flex; justify-content: space-between; align-items: center;">
                  <span>Print Tax Invoice</span>
                  <kbd
                    style="background: var(--bg-card); border: 1px solid var(--border-color); padding: 2px 7px; border-radius: 4px; font-weight: 700; font-size: 11px;">Ctrl
                    + P</kbd>
                </div>
              </div>
            </div>

            <!-- Navigation & Quick Tools -->
            <div
              style="background: var(--bg-card-hover, rgba(15,23,42,0.04)); border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 14px;">
              <div
                style="font-size: 13px; font-weight: 700; color: var(--text-main); margin-bottom: 10px; display: flex; align-items: center; gap: 6px;">
                <i class="ti ti-compass" style="color: var(--primary);"></i> Navigation &amp; Search
              </div>
              <div style="display: flex; flex-direction: column; gap: 8px; font-size: 12.5px;">
                <div style="display: flex; justify-content: space-between; align-items: center;">
